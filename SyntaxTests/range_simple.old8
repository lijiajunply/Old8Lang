// 简单范围表达式测试文件

// 测试1: 基本范围表达式
range1 <- [1~10]
range2 <- [0~5]

// 测试2: 使用范围表达式进行循环
count1 <- 0
for i in [1~5] {
    count1 <- count1 + i
}

// 测试3: 在列表推导式中使用范围表达式
squares <- [x * x for x in [1~5]]
doubles <- [x * 2 for x in [0~10]]

// 测试4: 范围表达式作为函数参数
func sum_range(range_expr) {
    sum <- 0
    for i in range_expr {
        sum <- sum + i
    }
    return sum
}

result <- sum_range([1~5])