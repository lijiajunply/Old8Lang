// Range Test for Virtual Machine

// 1. Basic Range (Implicit Step 1) [1~5]
r1 <- [1~5]
if r1.Length != 5 {
    throw "r1 length should be 5, got " + r1.Length.ToStr()
}
if r1[0] != 1 { throw "r1[0] should be 1" }
if r1[4] != 5 { throw "r1[4] should be 5" }
PrintLine("Range [1~5] passed")

// 2. Exclude Start/End
// Note: [1>~5] seems to have parsing issue in current parser version, skipping for now
// r2 <- [1>~5] // Exclude start (1), Include end (5) -> 2, 3, 4, 5
// if r2.Length != 4 {
