// 测试Task和Thread静态类的编译支持

func main() -> void {
    PrintLine("开始测试Task和Thread静态类...")
    PrintLine("")

    // 测试 Thread.Sleep
    PrintLine("测试 Thread.Sleep(100)...")
    Thread.Sleep(100)
    PrintLine("✓ Thread.Sleep 完成")

    PrintLine("")
    PrintLine("测试 Task.FromResult...")
    task1 <- Task.FromResult(42)
    PrintLine("✓ Task.FromResult 创建成功")

    PrintLine("")
    PrintLine("测试 Task.Delay...")
    task2 <- Task.Delay(50)
    PrintLine("✓ Task.Delay 创建成功")

    PrintLine("")
    PrintLine("所有测试通过！🎉")
}

main()
