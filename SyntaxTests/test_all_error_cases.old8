// 全面错误语法测试
// 测试各种错误语法情况
// error

// 缺少关键字
if a > 5
    PrintLine("缺少关键字")
elif a == 5
    PrintLine("缺少关键字")

// 括号不匹配
if a > 5 {
    PrintLine("缺少右括号")

// 无效标识符
123abc <- 10

// 错误的赋值语法
d = 20

// 无效的函数声明
func 123func() {
    return 0
}

// 缺少冒号的字典
invalid_dict <- {"name" "Alice", "age" 30}

// 缺少分号的语句
print "缺少分号"

// 无效的范围表达式
invalid_range <- [1~]

// 无效的元组
invalid_tuple <- (1, 2, 3)

// 无效的lambda表达式
invalid_lambda <- (x, y) ->

// 无效的类型标注
invalid_type <- 10 : invalid_type

// 无效的类型转换
invalid_convert <- "string" as invalid_type

// 无效的成员访问
invalid_member <- undefined_object.field

// 无效的函数调用
invalid_call <- undefined_func()

// 无效的导入语句
import 123

// 无效的类声明
class 123Class {
}

// 无效的继承
class InvalidInherit extends undefined_base {
}

// 无效的访问修饰符
invalid_modifier <- private public var <- 10

// 无效的三元表达式
invalid_ternary <- a ? b :

// 无效的字符串模板
invalid_template <- $"missing closing brace: {a

// 无效的列表推导式
invalid_comprehension <- [x for x in]

// 无效的切片表达式
invalid_slice <- list[1:]

// 无效的范围表达式
invalid_range <- [~5]

// 无效的算术表达式
invalid_arith <- 1 + * 2

// 无效的比较表达式
invalid_comp <- a ==

// 无效的逻辑表达式
invalid_logic <- a and

// 无效的赋值表达式
invalid_assign <- a <-

// 无效的声明
invalid_decl <- :int <- 10

// 无效的for循环
for i <- 0, i < 5, {
    PrintLine(i)
}

// 无效的while循环
while {
    PrintLine("invalid")
}

// 无效的switch语句
switch {
    case 1 {
        PrintLine("invalid")
    }
}

// 无效的try-catch语句
try {
    PrintLine("invalid")
catch (e) {
    PrintLine(e)
}

// 无效的throw语句
throw

// 无效的break语句
break

// 无效的continue语句
continue

// 无效的return语句
return

// 无效的++运算符
++var

// 无效的--运算符
--var

// 无效的点运算符
.obj.field

// 无效的数组访问
[1, 2, 3][

// 无效的字典访问
{"key": "value"}["
