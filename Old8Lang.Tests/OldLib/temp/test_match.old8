// 测试 match 表达式基本功能

// 测试1: 值匹配
result <- match 1 {
    case 0 -> "zero"
    case 1 -> "one"
    case 2 -> "two"
    case _ -> "other"
}
PrintLine("Test 1: " + result)  // 应该输出 "one"

// 测试2: 变量绑定
value <- 42
result2 <- match value {
    case 0 -> "zero"
    case x -> "value is " + x.ToStr()
}
PrintLine("Test 2: " + result2)  // 应该输出 "value is 42"

// 测试3: 通配符
result3 <- match 999 {
    case 1 -> "one"
    case 2 -> "two"
    case _ -> "unknown"
}
PrintLine("Test 3: " + result3)  // 应该输出 "unknown"

// 测试4: 字符串匹配
name <- "Alice"
greeting <- match name {
    case "Bob" -> "Hello Bob!"
    case "Alice" -> "Hi Alice!"
    case _ -> "Hello stranger!"
}
PrintLine("Test 4: " + greeting)  // 应该输出 "Hi Alice!"
