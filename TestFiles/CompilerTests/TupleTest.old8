// TupleTest.old8
// 测试扁平化元组实现

PrintLine("--- Basic Tuple ---")
t2 <- (1, 2)
PrintLine(t2)
PrintLine(t2.Length)
PrintLine(t2[0])
PrintLine(t2[1])

PrintLine("--- Multi Tuple ---")
t3 <- (1, 2, 3)
PrintLine(t3)
PrintLine(t3.Length)
PrintLine(t3[2])

PrintLine("--- Large Tuple (>7) ---")
// 测试超过7个元素，编译器应该生成嵌套 ValueTuple
t9 <- (1, 2, 3, 4, 5, 6, 7, 8, 9)
PrintLine(t9)
PrintLine(t9.Length)
PrintLine(t9[0])
PrintLine(t9[7]) // 第8个元素
PrintLine(t9[8]) // 第9个元素

PrintLine("--- Mixed Types ---")
tm <- (1, "string", true, 3.14)
PrintLine(tm)
PrintLine(tm[1])

PrintLine("--- Nested Tuple ---")
tn <- (1, (2, 3), 4)
PrintLine(tn)
PrintLine(tn[1])
PrintLine(tn[1][0])

PrintLine("--- Single Element Tuple ---")
ts <- (100,)
PrintLine(ts)
PrintLine(ts.Length)
PrintLine(ts[0])

PrintLine("--- Slice ---")
t_slice <- (1, 2, 3, 4, 5)
s1 <- t_slice[1:3]
PrintLine(s1)

PrintLine("--- ItemN Access ---")
PrintLine(t3.Item1)
PrintLine(t3.Item2)
PrintLine(t3.Item3)

PrintLine("--- Named Tuple ---")
t_named <- (x: 10, y: 20)
PrintLine(t_named)
PrintLine(t_named.x)
PrintLine(t_named.y)
