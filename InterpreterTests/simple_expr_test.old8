// 简单表达式测试

// 算术表达式
a <- 10
b <- 20
c <- a + b
PrintLine("a + b = " + c)

d <- a - b
PrintLine("a - b = " + d)

e <- a * b
PrintLine("a * b = " + e)

f <- a / b
PrintLine("a / b = " + f)

// 比较表达式
g <- a == b
PrintLine("a == b = " + g)

h <- a != b
PrintLine("a != b = " + h)

i <- a < b
PrintLine("a < b = " + i)

j <- a > b
PrintLine("a > b = " + j)

// 逻辑表达式
k <- g and h
PrintLine("g and h = " + k)

l <- g or h
PrintLine("g or h = " + l)

m <- not g
PrintLine("not g = " + m)
