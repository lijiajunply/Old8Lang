
func writeCSV(data:list, filePath:string) -> string {
    return "Wrote " + data.Size().ToStr() + " items to " + filePath
}
func calculateStats(data:list) -> dict {
    sum <- 0
    i <- 0
    while i < data.Size() {
        sum <- sum + data[i]
        i <- i + 1
    }
    avg <- sum / data.Size()
    return {"sum": sum, "avg": avg, "count": data.Size()}
}
