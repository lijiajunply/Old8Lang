// 缺口9：TypeOf / GetType 的类型覆盖
PrintLine("TypeOf(list) -> " + TypeOf({1, 2, 3}).ToStr())
PrintLine("TypeOf(array) -> " + TypeOf([1, 2, 3]).ToStr())
PrintLine("TypeOf(dict) -> " + TypeOf({"a": 1}).ToStr())
PrintLine("TypeOf(tuple) -> " + TypeOf((1, 2)).ToStr())
PrintLine("TypeOf(int) -> " + TypeOf(1).ToStr())
PrintLine("TypeOf(double) -> " + TypeOf(1.5).ToStr())
PrintLine("TypeOf(string) -> " + TypeOf("s").ToStr())
PrintLine("TypeOf(bool) -> " + TypeOf(true).ToStr())
PrintLine("TypeOf(null) -> " + TypeOf(null).ToStr())
PrintLine("GetType(int) -> " + GetType("int").ToStr())
PrintLine("GetType(int).IsPrimitive -> " + GetType("int").IsPrimitive().ToStr())
PrintLine("GetType(double).IsPrimitive -> " + GetType("double").IsPrimitive().ToStr())
PrintLine("GetType(char).IsPrimitive -> " + GetType("char").IsPrimitive().ToStr())
PrintLine("GetType(list) -> " + GetType("list").ToStr())
PrintLine("GetType(dict) -> " + GetType("dict").ToStr())
