// 测试运行时错误显示上下文和文件信息

// 测试1: 类型错误 - 尝试将字符串与数字相加
func test_type_error() -> {
    a <- "10"
    b <- 20
    c <- a + b  // 类型错误
    print(c)
}

// 测试2: 无效操作 - 调用不存在的函数
func test_invalid_operation() -> {
    nonexistent_function()  // 无效操作
}

// 测试3: 除零错误
func test_divide_by_zero() -> {
    a <- 10
    b <- 0
    c <- a / b  // 除零错误
    print(c)
}

// 测试4: 未定义变量
func test_undefined_variable() -> {
    print(undefined_variable)  // 未定义变量
}

// 测试5: 键错误 - 访问字典中不存在的键
func test_key_error() -> {
    dict <- { "key1": 10, "key2": 20 }
    print(dict["key3"])  // 键不存在
}

// 调用测试函数
test_type_error()
