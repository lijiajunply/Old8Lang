// 带参数的生成器测试

// 定义一个带有参数的生成器函数，生成start到end的整数
func range(start, end) {
    i <- start
    while i <= end {
        yield i
        i <- i + 1
    }
}

// 测试带参数的生成器
PrintLine("带参数的生成器测试：1到3")
for num in range(1, 3) {
    PrintLine(num)
}

PrintLine("\n带参数的生成器测试：5到7")
for num in range(5, 7) {
    PrintLine(num)
}