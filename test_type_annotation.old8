# 测试类型注解的类型检查

# 测试1: 合法赋值 - int类型
print("测试1: 合法赋值 - int类型")
a:int <- 123
print(a)

# 测试2: 合法赋值 - string类型
print("\n测试2: 合法赋值 - string类型")
b:string <- "hello"
print(b)

# 测试3: 合法赋值 - bool类型
print("\n测试3: 合法赋值 - bool类型")
c:bool <- true
print(c)

# 测试4: 非法赋值 - int类型赋值字符串
print("\n测试4: 非法赋值 - int类型赋值字符串")
d:int <- "world"
print(d)

# 测试5: 非法赋值 - string类型赋值整数
print("\n测试5: 非法赋值 - string类型赋值整数")
e:string <- 456
print(e)
