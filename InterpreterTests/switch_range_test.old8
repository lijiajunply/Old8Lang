// 测试 switch 语句的范围匹配功能
score <- 85
switch score {
    case [90~100] {
        PrintLine("优秀")
    }
    case [80~89] {
        PrintLine("良好")
    }
    case [70~79] {
        PrintLine("中等")
    }
    case [60~69] {
        PrintLine("及格")
    }
    case [0~59] {
        PrintLine("不及格")
    }
    default {
        PrintLine("无效分数")
    }
}

