// Old8Lang 图像处理库示例
// 演示如何使用 ImageLib 进行图像处理

// 注意：需要准备一个测试图像文件 test.png 用于测试

// ===== 基础图像操作 =====
PrintLine("=== 基础图像操作 ===")

// 创建一个新的空白图像（800x600，白色背景）
img <- ImageLib.CreateImage(800, 600, 255, 255, 255)
ImageLib.SaveImage(img, "output_blank.png", "png")
PrintLine("创建空白图像: output_blank.png")

// 获取图像信息
width <- ImageLib.GetWidth(img)
height <- ImageLib.GetHeight(img)
PrintLine($"图像尺寸: {width}x{height}")

// 设置和获取像素
ImageLib.SetPixel(img, 100, 100, 255, 0, 0)  // 红色像素
pixel <- ImageLib.GetPixel(img, 100, 100)
PrintLine($"像素 (100, 100) 颜色: R={pixel[0]}, G={pixel[1]}, B={pixel[2]}")

// ===== 图像绘制 =====
PrintLine("\n=== 图像绘制 ===")

// 绘制矩形
ImageLib.DrawRectangle(img, 50, 50, 200, 150, 255, 0, 0, 3, false)
PrintLine("绘制红色矩形边框")

// 绘制填充圆形
ImageLib.DrawCircle(img, 400, 300, 80, 0, 0, 255, 1, true)
PrintLine("绘制蓝色填充圆形")

// 绘制直线
ImageLib.DrawLine(img, 50, 400, 750, 400, 0, 255, 0, 2)
PrintLine("绘制绿色直线")

// 绘制文本
ImageLib.DrawText(img, "Old8Lang 图像处理", 300, 500, 24, 0, 0, 0, "Arial")
PrintLine("绘制文本")

// 绘制多边形（三角形）
points <- [400, 50, 500, 200, 300, 200]
ImageLib.DrawPolygon(img, points, 255, 128, 0, 2, false)
PrintLine("绘制橙色三角形")

ImageLib.SaveImage(img, "output_drawing.png", "png")
PrintLine("保存绘制结果: output_drawing.png")

// ===== 图像变换 =====
// 注意：以下操作需要加载一个已存在的图像文件
// 如果您有 test.png 文件，可以取消注释以下代码进行测试

