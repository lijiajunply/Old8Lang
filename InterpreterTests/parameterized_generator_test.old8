// 测试带参数生成器的功能
func range(start, end) {
    i <- start
    while (i < end) {
        yield i
        i <- i + 1
    }
}

// 测试带参数生成器
PrintLine("Testing parameterized generator...")
counter <- 0
for num in range(1, 5) {
    PrintLine(num)
    counter <- counter + 1
}
PrintLine("Total iterations: " + counter)

// 测试无限生成器
func infinite_counter(start) {
    i <- start
    while (true) {
        yield i
        i <- i + 1
    }
}

PrintLine("\nTesting infinite generator with break...")
loop_counter <- 0
for num in infinite_counter(10) {
    PrintLine(num)
    loop_counter <- loop_counter + 1
    if (loop_counter >= 3) {
        break
    }
}
PrintLine("Total iterations: " + loop_counter)
