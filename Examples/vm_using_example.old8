// 虚拟机模式 using 语句示例

// 示例 1: 使用 Mutex
PrintLine("=== 示例 1: 使用 Mutex ===")
using mutex <- MutexCreate() {
    PrintLine("Mutex 已创建: " + mutex.ToStr())
    MutexLock(mutex)
    PrintLine("已获取锁")
    MutexUnlock(mutex)
    PrintLine("已释放锁")
}
PrintLine("Mutex 已自动释放")
PrintLine("")

// 示例 2: 使用 Channel
PrintLine("=== 示例 2: 使用 Channel ===")
using ch <- ChannelCreate() {
    PrintLine("Channel 已创建: " + ch.ToStr())
    ChannelSend(ch, 100)
    value <- ChannelReceive(ch)
    PrintLine("接收到值: " + value.ToStr())
}
PrintLine("Channel 已自动释放")
PrintLine("")

// 示例 3: 嵌套 using
PrintLine("=== 示例 3: 嵌套 using ===")
using mutex1 <- MutexCreate() {
    PrintLine("外层 Mutex 已创建")
    using mutex2 <- MutexCreate() {
        PrintLine("内层 Mutex 已创建")
        MutexLock(mutex1)
        MutexLock(mutex2)
        PrintLine("两个锁都已获取")
        MutexUnlock(mutex2)
        MutexUnlock(mutex1)
    }
    PrintLine("内层 Mutex 已释放")
}
PrintLine("外层 Mutex 已释放")
PrintLine("")

// 示例 4: 异常情况下的资源释放
PrintLine("=== 示例 4: 异常情况下的资源释放 ===")
try {
    using sem <- SemaphoreCreate(1, 1) {
        PrintLine("Semaphore 已创建")
        SemaphoreAcquire(sem)
        PrintLine("已获取信号量")
        throw "测试异常"
    }
} catch (e) {
    PrintLine("捕获异常: " + e.ToStr())
}
PrintLine("即使发生异常，Semaphore 也已自动释放")
