// 语法测试文件
PrintLine("Hello, World!")

// 变量声明和赋值
x:int <- 10
y:string <- "test"

// if语句
if x > 5 {
    PrintLine("x 大于 5")
} elif x == 5 {
    PrintLine("x 等于 5")
} else {
    PrintLine("x 小于 5")
}

// for循环
for i in [0,1,2,3,4,5] {
    PrintLine("i = " + i)
}

// 函数声明和调用
func add(a:int, b:int) -> {
    return a + b
}

result <- add(1, 2)
PrintLine("1 + 2 = " + result)
