// 原生Web操作测试
test_url <- "https://www.example.com:8080/path?query=value"
native uri_obj <- new Uri(test_url)
native scheme <- uri_obj.Scheme
native host <- uri_obj.Host
native port <- uri_obj.Port
native path <- uri_obj.AbsolutePath
uri_results <- {
    protocol: scheme,
    hostname: host,
    port_number: port,
    file_path: path
}