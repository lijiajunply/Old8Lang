// 测试幂运算语法

// 基本幂运算
result1 <- 2 ^ 3
PrintLine("2 ^ 3 = " + result1)

// 浮点数幂运算
result2 <- 2.5 ^ 2
PrintLine("2.5 ^ 2 = " + result2)

// 整数与浮点数混合幂运算
result3 <- 2 ^ 0.5
PrintLine("2 ^ 0.5 = " + result3)

// 右结合性测试
result4 <- 2 ^ 3 ^ 2
PrintLine("2 ^ 3 ^ 2 = " + result4)

// 复杂表达式中的幂运算
result5 <- (2 + 1) ^ (3 - 1)
PrintLine("(2 + 1) ^ (3 - 1) = " + result5)

// 与其他运算符混合使用
result6 <- 2 + 3 ^ 2 * 2
PrintLine("2 + 3 ^ 2 * 2 = " + result6)