// 测试基本表达式类型

// 整数类型
a <- 10
b <- 20
c <- a + b
PrintLine(c)  // 应该输出 30

// 浮点数类型
d <- 3.14
e <- 2.71
f <- d + e
PrintLine(f)  // 应该输出 5.85

// 字符串类型
g <- "Hello"
h <- " World"
i <- g + h
PrintLine(i)  // 应该输出 "Hello World"

// 布尔类型
j <- true
k <- false
l <- j and k
PrintLine(l)  // 应该输出 false

// 字符类型
m <- 'a'
n <- 'b'
op <- m + n
PrintLine(op)  // 应该输出 "ab"
