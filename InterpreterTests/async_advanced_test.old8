// 高级异步功能测试
import Async

// 测试任务组合方法 - WhenAll
PrintLine("=== 测试1: 任务组合方法 - WhenAll ===")

async func task1() {
    Sleep(200)
    return 1
}

async func task2() {
    Sleep(100)
    return 2
}

// 测试 WhenAll - 由于 Task 类未暴露到 Old8Lang,暂时注释
// printTask <- Task.WhenAll([task1(), task2()])
// result1 <- await printTask
// PrintLine("WhenAll 结果: " + result1)

// 替代方案:分别等待各个任务
t1 <- task1()
t2 <- task2()
result1a <- await t1
result1b <- await t2
PrintLine("任务1结果: " + result1a.ToStr())
PrintLine("任务2结果: " + result1b.ToStr())

// 测试任务组合方法 - WhenAny
PrintLine("\n=== 测试2: 任务组合方法 - WhenAny ===")

// anyTask <- Task.WhenAny([task1(), task2()])
// result2 <- await anyTask
// PrintLine("WhenAny 结果: " + result2)
PrintLine("WhenAny 方法暂不可用(Task类未暴露)")

// 测试5: 任务组合方法 - Retry
PrintLine("\n=== 测试3: 任务组合方法 - Retry ===")

retryCount <- 0

async func flakyTask() {
    retryCount <- retryCount + 1
    PrintLine("重试次数: " + retryCount.ToStr())
    if retryCount < 3 {
        throw new Error("任务失败，需要重试")
    }
    return "重试成功"
}

// Retry 方法也可能不可用,先测试是否能运行
PrintLine("Retry 方法测试(可能失败)")
