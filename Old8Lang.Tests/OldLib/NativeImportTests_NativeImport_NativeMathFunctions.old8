// 原生数学函数测试
native abs_result <- Math.Abs(-10)
native sqrt_result <- Math.Sqrt(16)
native pow_result <- Math.Pow(2, 3)
native max_result <- Math.Max(5, 8)
native min_result <- Math.Min(3, 7)
math_results <- {
    abs: abs_result,
    sqrt: sqrt_result,
    power: pow_result,
    max: max_result,
    min: min_result
}