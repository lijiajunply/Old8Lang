// 测试嵌套 for in 循环中的 yield 问题
bufferedStream <- async {
    buffer <- {}
    PrintLine("外层循环开始")
    for i in [1~5] {
        PrintLine($"外层: i={i}")
        buffer.Add(i)
        PrintLine($"buffer size = {len(buffer)}")
        if len(buffer) == 3 {
            PrintLine("进入内层循环")
            for item in buffer {
                PrintLine($"内层: yield {item}")
                yield item
            }
            PrintLine("内层循环结束，清空buffer")
            buffer.Clear()
            PrintLine($"清空后 buffer size = {len(buffer)}")
        }
    }
    PrintLine("外层循环结束，yield剩余项")
    for item in buffer {
        PrintLine($"剩余项: yield {item}")
        yield item
    }
    PrintLine("异步生成器结束")
}

sum <- 0
async for item in bufferedStream {
    PrintLine($"收到: {item}, 当前sum={sum}")
    sum <- sum + item
}
PrintLine($"最终sum={sum}")
result <- sum
