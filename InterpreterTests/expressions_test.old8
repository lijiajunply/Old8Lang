// 表达式测试

// 算术表达式测试
PrintLine("=== 算术表达式测试 ===")

// 加法
PrintLine("1 + 2 = " + (1 + 2))
PrintLine("1.5 + 2.5 = " + (1.5 + 2.5))

// 减法
PrintLine("5 - 3 = " + (5 - 3))
PrintLine("5.5 - 2.5 = " + (5.5 - 2.5))

// 乘法
PrintLine("3 * 4 = " + (3 * 4))
PrintLine("2.5 * 4 = " + (2.5 * 4))

// 除法
PrintLine("10 / 2 = " + (10 / 2))
PrintLine("10 / 3 = " + (10 / 3))
PrintLine("10.0 / 3.0 = " + (10.0 / 3.0))

// 取模
PrintLine("10 % 3 = " + (10 % 3))
PrintLine("10.5 % 3.2 = " + (10.5 % 3.2))

// 比较表达式测试
PrintLine("\n=== 比较表达式测试 ===")

// 等于
PrintLine("1 == 1 = " + (1 == 1))
PrintLine("1 == 2 = " + (1 == 2))

// 不等于
PrintLine("1 != 2 = " + (1 != 2))
PrintLine("1 != 1 = " + (1 != 1))

// 小于
PrintLine("1 < 2 = " + (1 < 2))
PrintLine("2 < 1 = " + (2 < 1))

// 大于
PrintLine("2 > 1 = " + (2 > 1))
PrintLine("1 > 2 = " + (1 > 2))

// 小于等于
PrintLine("1 <= 2 = " + (1 <= 2))
PrintLine("2 <= 2 = " + (2 <= 2))
PrintLine("3 <= 2 = " + (3 <= 2))

// 大于等于
PrintLine("2 >= 1 = " + (2 >= 1))
PrintLine("2 >= 2 = " + (2 >= 2))
PrintLine("1 >= 2 = " + (1 >= 2))

// 逻辑表达式测试
PrintLine("\n=== 逻辑表达式测试 ===")

// and
PrintLine("true and true = " + (true and true))
PrintLine("true and false = " + (true and false))
PrintLine("false and true = " + (false and true))
PrintLine("false and false = " + (false and false))

// or
PrintLine("true or true = " + (true or true))
PrintLine("true or false = " + (true or false))
PrintLine("false or true = " + (false or true))
PrintLine("false or false = " + (false or false))

// xor
PrintLine("true xor true = " + (true xor true))
PrintLine("true xor false = " + (true xor false))
PrintLine("false xor true = " + (false xor true))
PrintLine("false xor false = " + (false xor false))

// not
PrintLine("not true = " + (not true))
PrintLine("not false = " + (not false))

// 赋值表达式测试
PrintLine("\n=== 赋值表达式测试 ===")
a <- 10
PrintLine("a <- 10: " + a)

a <- a + 5
PrintLine("a <- a + 5: " + a)

// 索引表达式测试
PrintLine("\n=== 索引表达式测试 ===")
array_test <- [1, 2, 3, 4, 5]
PrintLine("array_test[0] = " + array_test[0])
PrintLine("array_test[2] = " + array_test[2])

// 修改数组元素
array_test[0] <- 10
PrintLine("修改后 array_test[0] = " + array_test[0])

// 字典索引
dict_test <- {"name": "Alice", "age": 30}
PrintLine("dict_test['name'] = " + dict_test["name"])
PrintLine("dict_test['age'] = " + dict_test["age"])

// 函数调用表达式测试
PrintLine("\n=== 函数调用表达式测试 ===")

func add(x:int, y:int) -> {
    return x + y
}

result <- add(1, 2)
PrintLine("add(1, 2) = " + result)

// 复合表达式测试
PrintLine("\n=== 复合表达式测试 ===")
result <- (1 + 2) * (3 + 4)
PrintLine("(1 + 2) * (3 + 4) = " + result)

result <- (10 > 5) and (3 < 4)
PrintLine("(10 > 5) and (3 < 4) = " + result)

result <- not (10 == 5)
PrintLine("not (10 == 5) = " + result)

// 类型转换表达式测试
PrintLine("\n=== 类型转换表达式测试 ===")
int_val <- 123
double_val <- int_val as double
PrintLine("int_val as double = " + double_val)

string_val <- int_val as string
PrintLine("int_val as string = " + string_val)

// 范围表达式测试
PrintLine("\n=== 范围表达式测试 ===")
range_val <- [1~5]
PrintLine("Range [1~5] contains:")
for i in range_val {
    PrintLine(i)
}