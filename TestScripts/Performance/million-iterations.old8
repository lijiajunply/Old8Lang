// 百万次迭代测试脚本
// 目标: 验证大量迭代下的性能稳定性

func increment(n) {
    return n + 1
}

func compute(a, b) {
    return a * b + a - b
}

// 主循环 - 100万次迭代（分批执行）
total <- 0
batchCount <- 1000
batchSize <- 1000

for batch <- 0, batch < batchCount, batch <- batch + 1 {
    batchTotal <- 0
    for i <- 0, i < batchSize, i <- i + 1 {
        batchTotal <- batchTotal + compute(i, batch + 1)
    }
    total <- total + batchTotal
}

print("百万次迭代完成，总计: " + total)
