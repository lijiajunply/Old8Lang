<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      测试工程只保留可空引用注解、不做流分析：
      xUnit 2 的 Assert.NotNull/Assert.IsType 没有 [NotNull] 流特性，
      大量「断言非空后解引用」「故意传 null 验证运行时行为」的用例会产生
      CS8600/CS8602/CS8604 噪声，掩盖真正需要处理的核心工程警告。
      核心工程（Old8Lang 及其库）保持 <Nullable>enable</Nullable> 全量分析。
    -->
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 默认排除 Category=Performance 的用例；这些用例由 performance.runsettings 单独跑 -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/default.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.20.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Old8Lang.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Old8Lang.SerializationLib\Old8Lang.SerializationLib.csproj" />
    <ProjectReference Include="..\Old8Lang.Runtime\Old8Lang.Runtime.csproj" />
    <ProjectReference Include="..\Old8Lang.Syntax\Old8Lang.Syntax.csproj" />
    <ProjectReference Include="..\Old8Lang.Observability\Old8Lang.Observability.csproj" />
    <ProjectReference Include="..\Old8LangLib\Old8LangLib.csproj" />
    <ProjectReference Include="..\Old8Lang.NetLib\Old8Lang.NetLib.csproj" />
    <ProjectReference Include="..\Old8Lang.MachineLearningLib\Old8Lang.MachineLearningLib.csproj" />
    <ProjectReference Include="..\Old8Lang.DatabaseLib\Old8Lang.DatabaseLib.csproj" />
    <ProjectReference Include="..\Old8Lang.LanguageServer\Old8Lang.LanguageServer.csproj" />
    <ProjectReference Include="..\Old8Lang.Hosting\Old8Lang.Hosting.csproj" />
    <ProjectReference Include="..\Old8Lang.Modules.Official\Old8Lang.Modules.Official.csproj" />
  </ItemGroup>

</Project>
