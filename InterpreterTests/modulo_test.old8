// 测试整数取模
PrintLine(10 % 3)  // 应该输出 1
PrintLine(10 % -3)  // 应该输出 1
PrintLine(-10 % 3)  // 应该输出 -1
PrintLine(-10 % -3)  // 应该输出 -1
PrintLine(10 % 2)  // 应该输出 0

// 测试浮点数取模
PrintLine(10.5 % 3.2)  // 应该输出 0.9
PrintLine(10.5 % -3.2)  // 应该输出 0.9
PrintLine(-10.5 % 3.2)  // 应该输出 -0.9
PrintLine(-10.5 % -3.2)  // 应该输出 -0.9
PrintLine(10.0 % 2.0)  // 应该输出 0.0
