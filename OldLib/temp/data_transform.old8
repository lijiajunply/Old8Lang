
func filter(data:list, predicate:int) -> list {
    result <- {}
    i <- 0
    while i < data.Size() {
        item <- data[i]
        if item > predicate {
            result.Add(item)
        }
        i <- i + 1
    }
    return result
}
func map(data:list, multiplier:int) -> list {
    result <- {}
    i <- 0
    while i < data.Size() {
        item <- data[i]
        result.Add(item * multiplier)
        i <- i + 1
    }
    return result
}
