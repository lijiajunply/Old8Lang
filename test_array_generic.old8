// Array 通用方法测试

print("=== Array 通用方法测试 ===\n")

// 1. 测试 Contains 方法
print("\n1. 测试 Contains 方法\n")

arr1 <- [10, 20, 30, 40, 50]
print("arr1 = ")
print(arr1)
print("\n")

contains1 <- arr1.Contains(30)
print("arr1.Contains(30) = ")
print(contains1)
print("\n")

contains2 <- arr1.Contains(100)
print("arr1.Contains(100) = ")
print(contains2)
print("\n")

// 2. 测试 Reverse 方法
print("\n2. 测试 Reverse 方法\n")

reversed1 <- arr1.Reverse()
print("arr1.Reverse() = ")
print(reversed1)
print("\n")

// 3. 测试字符串数组
print("\n3. 测试字符串数组\n")

arr2 <- ["apple", "banana", "cherry"]
print("arr2 = ")
print(arr2)
print("\n")

contains3 <- arr2.Contains("banana")
print("arr2.Contains(\"banana\") = ")
print(contains3)
print("\n")

reversed2 <- arr2.Reverse()
print("arr2.Reverse() = ")
print(reversed2)
print("\n")

print("\n=== 所有测试完成 ===\n")
