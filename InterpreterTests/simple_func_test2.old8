// 简单函数测试

PrintLine("=== 函数测试 ===")

// 定义一个加法函数
func add(a, b) -> {
    return a + b
}

// 调用函数
result <- add(1, 2)
PrintLine("add(1, 2) = " + result)

// 定义一个带有类型注解的函数
func multiply(a:int, b:int) -> {
    return a * b
}

result <- multiply(3, 4)
PrintLine("multiply(3, 4) = " + result)

// 定义一个无返回值的函数
func greet(name) -> {
    PrintLine("Hello, " + name + "!")
}

greet("Alice")
