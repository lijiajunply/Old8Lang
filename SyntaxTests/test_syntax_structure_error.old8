// 测试语法结构错误情况

// 括号不匹配 - 缺少右括号
if (a > 5 {
    PrintLine("缺少右括号")
}

while (b < 10 {
    PrintLine("缺少右括号")
}

for (i <- 0, i < 10, i++ {
    PrintLine("缺少右括号")
}

func test_func(a {
    return a
}

// 括号不匹配 - 缺少左括号
if a > 5) {
    PrintLine("缺少左括号")
}

while b < 10) {
    PrintLine("缺少左括号")
}

for i <- 0, i < 10, i++) {
    PrintLine("缺少左括号")
}

func test_func a, b) {
    return a + b
}

// 大括号不匹配 - 缺少右大括号
