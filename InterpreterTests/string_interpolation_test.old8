// 字符串插值测试

// 测试用例 1: 基本字符串模板
PrintLine("=== 测试用例 1: 基本字符串模板 ===")
basic_template <- $(".")
PrintLine(basic_template)

// 测试用例 2: 在模板中嵌入表达式
PrintLine("\n=== 测试用例 2: 在模板中嵌入表达式 ===")
expr_template <- $("This is {10}")
PrintLine(expr_template)

// 测试用例 3: 转义 { 字符
PrintLine("\n=== 测试用例 3: 转义 { 字符 ===")
escape_left_template <- $("This is {{ escaped {")
PrintLine(escape_left_template)

// 测试用例 4: 转义 } 字符
PrintLine("\n=== 测试用例 4: 转义 } 字符 ===")
escape_right_template <- $("This is }} escaped {")
PrintLine(escape_right_template)

// 测试用例 5: 组合测试
PrintLine("\n=== 测试用例 5: 组合测试 ===")
name <- "Alice"
age <- 30
combined_template <- $("My name is {name}, I'm {age} years old. {{ This is a curly brace example }}.")
PrintLine(combined_template)

// 测试用例 6: 多个连续转义
PrintLine("\n=== 测试用例 6: 多个连续转义 ===")
multiple_escape_template <- $("{{{{ multiple escaped braces }}}}")
PrintLine(multiple_escape_template)

// 测试用例 7: 表达式与转义混合
PrintLine("\n=== 测试用例 7: 表达式与转义混合 ===")
x <- 5
y <- 10
mixed_template <- $("{x} + {y} = {{x + y}}")
PrintLine(mixed_template)
