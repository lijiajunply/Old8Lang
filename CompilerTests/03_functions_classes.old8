// 函数和类测试 - 编译模式
// 测试函数和类的各种语法，使用类型假注

PrintLine("=== 函数和类测试 ===")

// 函数声明和调用 - 基本形式
PrintLine("\n1. 基本函数测试:")
func add1(a, b) {
    return a + b
}

result1 <- add1(1, 2)
PrintLine("add1(1, 2) = " + result1)

// 函数声明 - 另一种形式
PrintLine("\n2. 函数声明的另一种形式:")
// 注意：这种函数声明形式在解释模式下暂不支持
// add2 (a, b) -> {
//     return a + b
// }
// 
// result2 <- add2(3, 4)
// PrintLine("add2(3, 4) = " + result2)

// 函数声明 - 带返回值类型假注
PrintLine("\n3. 带返回值类型假注的函数:")
// 注意：带返回值类型假注的函数在解释模式下暂不支持
// func multiply(a, b) -> int {
//     return a * b
// }
// 
// result3 <- multiply(5, 6)
// PrintLine("multiply(5, 6) = " + result3)

// 无参数函数
PrintLine("\n4. 无参数函数:")
func getPi() {
    return 3.14159
}

pi <- getPi()
PrintLine("Pi 的值: " + pi)

// Lambda 表达式
PrintLine("\n5. Lambda 表达式测试:")
subtract <- (a, b) -> a - b

result4 <- subtract(10, 3)
PrintLine("subtract(10, 3) = " + result4)

// 类声明和实例化
PrintLine("\n6. 类声明和实例化测试:")
class Person {
    public name <- ""
    age <- 0
    
    func init(name, age) {
        this.name <- name
        this.age <- age
    }
    
    public func sayHello() {
        return "Hello, my name is " + this.name
    }
    
    func getAge() {
        return this.age
    }
}

// 实例化类
person1 <- Person("Alice", 30)
PrintLine("Person1: " + person1.sayHello())
PrintLine("Person1 年龄: " + person1.getAge())

// 类方法调用
PrintLine("\n7. 类方法调用测试:")
class Calculator {
    func add(x, y) {
        return x + y
    }
    
    func divide(x, y) {
        if y == 0 {
            PrintLine("除数不能为零")
            return 0.0
        }
        return x / y
    }
}

calc <- Calculator()
addResult <- calc.add(10, 20)
divResult <- calc.divide(100.0, 20.0)
PrintLine("calc.add(10, 20) = " + addResult)
PrintLine("calc.divide(100.0, 20.0) = " + divResult)

// 静态函数测试
PrintLine("\n8. 静态函数测试:")
class MathUtils {
    static func square(x) {
        return x * x
    }
    
    static func cube(x) {
        return x * x * x
    }
}

squareResult <- MathUtils.square(5)
cubeResult <- MathUtils.cube(3)
PrintLine("MathUtils.square(5) = " + squareResult)
PrintLine("MathUtils.cube(3) = " + cubeResult)

// 函数嵌套调用
PrintLine("\n9. 函数嵌套调用测试:")
func calculate(x, y) {
    return add1(x, y) * subtract(x, y)
}

nestedResult <- calculate(10, 5)
PrintLine("calculate(10, 5) = add1(10, 5) * subtract(10, 5) = " + nestedResult)
