// 测试变量查找功能

PrintLine("=== 测试变量查找优化 ===")

// 测试 1: 大量变量赋值和查找
func testVariableLookup() {
    PrintLine("开始变量查找测试...")

    // 创建大量变量
    a <- 1
    b <- 2
    c <- 3
    d <- 4
    e <- 5

    // 进行大量查找和修改操作
    count <- 0
    while count < 100 {
        a <- a + 1
        b <- b + 1
        c <- c + 1
        d <- d + 1
        e <- e + 1
        count <- count + 1
    }

    PrintLine("变量查找测试完成")
    PrintLine("最终值: a=" + a.ToStr() + ", e=" + e.ToStr())

    // 验证结果
    if a == 101 and e == 105 {
        PrintLine("✓ 测试通过")
        return true
    } else {
        PrintLine("✗ 测试失败")
        return false
    }
}

// 测试 2: 嵌套作用域
func testNestedScopes() {
    PrintLine("")
    PrintLine("开始嵌套作用域测试...")

    outer <- 100
    i <- 0

    while i < 10 {
        inner <- outer + i

        k <- 0
        while k < 5 {
            deep <- inner + k
            outer <- outer + 1
            k <- k + 1
        }

        i <- i + 1
    }

    PrintLine("嵌套作用域测试完成")
    PrintLine("最终值: outer=" + outer.ToStr())

    // 验证结果 (10 * 5 = 50)
    if outer == 150 {
        PrintLine("✓ 测试通过")
        return true
    } else {
        PrintLine("✗ 测试失败")
        return false
    }
}

// 运行测试
result1 <- testVariableLookup()
result2 <- testNestedScopes()

PrintLine("")
PrintLine("=== 测试汇总 ===")
if result1 and result2 {
    PrintLine("所有测试通过 ✓")
} else {
    PrintLine("部分测试失败 ✗")
}

