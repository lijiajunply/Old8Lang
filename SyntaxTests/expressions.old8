// 表达式测试文件

// 准备测试数据
a <- 10
b <- 5
c <- 3
d <- 2
e <- true
f <- false
str1 <- "hello"
str2 <- " world"

// 测试算术表达式
arithmetic1 <- a + b
arithmetic2 <- a - b
arithmetic3 <- a * b
arithmetic4 <- a / b
arithmetic5 <- a % b
arithmetic6 <- a + b * c
arithmetic7 <- (a + b) * c
arithmetic8 <- -a
arithmetic9 <- a + 1
arithmetic10 <- a - 1

// 测试比较表达式
comparison1 <- a == b
comparison2 <- a != b
comparison3 <- a < b
comparison4 <- a > b
comparison5 <- a <= b
comparison6 <- a >= b
comparison7 <- a + b == c * d
comparison8 <- a < b + c

// 测试逻辑表达式
logic1 <- e and f
logic2 <- e or f
logic3 <- e xor f
logic4 <- not e
logic5 <- not f
logic6 <- (a > b) and (c > d)
logic7 <- (a > b) or (c < d)
logic8 <- (a > b) xor (c < d)
logic9 <- not (a > b)

// 测试赋值表达式
assign1 <- a
assign2 <- a + b
assign3 <- (a + b) * c
assign4 <- [1, 2, 3]
assign5 <- {"name": "Alice"}

// 测试成员访问表达式
// 先创建一个对象用于测试
class Person {
    name <- ""
    age <- 0
    
    func sayHello() {
        return "Hello, " + name
    }
}

person <- Person()
person.name <- "Alice"
person.age <- 30

memberAccess1 <- person.name
memberAccess2 <- person.age
memberAccess3 <- person.sayHello()

// 测试索引表达式
arrayTest <- [10, 20, 30, 40, 50]
listTest <- list[100, 200, 300]
dictTest <- {"key1": "value1", "key2": 123, "key3": true}

index1 <- arrayTest[0]
index2 <- arrayTest[1]
index3 <- listTest[0]
index4 <- listTest[1]
index5 <- dictTest["key1"]
index6 <- dictTest["key2"]
index7 <- dictTest["key3"]

// 测试函数调用表达式
func add(x, y) {
    return x + y
}

func multiply(x, y) {
    return x * y
}

func greet(name) {
    return "Hello, " + name
}

func callWithArgs(a, b, c) {
    return a + b + c
}

funcCall1 <- add(1, 2)
funcCall2 <- multiply(3, 4)
funcCall3 <- greet("Alice")
funcCall4 <- callWithArgs(1, 2, 3)
funcCall5 <- add(a, b)
funcCall6 <- multiply(add(1, 2), add(3, 4))

// 测试复合表达式
complexExpr1 <- (a + b) * c / d
complexExpr2 <- (a > b) and (c < d) or (e xor f)
complexExpr3 <- arrayTest[add(1, 2)]
complexExpr4 <- dictTest[greet("key")]
complexExpr5 <- person.sayHello() + str1 + str2