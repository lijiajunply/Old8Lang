// 完整的类测试
class Person {
    name <- ""
    age <- 0
    
    func init(name, age) {
        this.name <- name
        this.age <- age
    }
    
    func sayHello() {
        PrintLine("Hello, my name is " + this.name)
    }
}

person <- Person("Bob", 25)
PrintLine("person 对象: " + person)
personName <- person.name
PrintLine("person.name = " + personName)
person.name <- "Charlie"
PrintLine("修改后 person.name = " + person.name)
person.sayHello()
PrintLine("✅ 测试完成")
