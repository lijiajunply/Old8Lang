class Student {
    public name <- ""
    grade <- 0

    func init(name:string, grade:int) {
        PrintLine("Before assignment: InstanceData name=" + this.name + ", grade=" + this.grade.ToStr())
        PrintLine("Parameters: name=" + name + ", grade=" + grade.ToStr())
        this.name <- name
        PrintLine("After this.name assignment: InstanceData name=" + this.name)
        this.grade <- grade
        PrintLine("After this.grade assignment: InstanceData grade=" + this.grade.ToStr())
    }

    func getInfo() -> string {
        return name + " is in grade " + grade
    }
}

student <- Student("Bob", 10)
PrintLine("After construction: student.name=" + student.name + ", student.grade=" + student.grade.ToStr())
info <- student.getInfo()
PrintLine(info)
