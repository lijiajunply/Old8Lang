// Test Native Import for VM

// Import single method
extern "Old8LangLib" MathLib Sqrt sqrt
PrintLine("Sqrt(4) = " + sqrt(4).ToStr())

// Import all methods
extern "Old8LangLib" MathLib *
PrintLine("Pow(2, 3) = " + Pow(2, 3).ToStr())

// Import class with alias (if supported)
// Or just class import
extern "Old8LangLib" MathLib as MyMath
PrintLine("MyMath.Abs(-10) = " + MyMath.Abs(-10).ToStr())
