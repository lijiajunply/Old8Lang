{
  "scanDirectory": "../Old8Lang/AST",
  "outputDirectory": "../Old8Lang/AST/Visitor/Generated",
  "excludePatterns": [
    "**/ValueFunctions/**",
    "**/ModuleObjects/**",
    "**/*Helper.cs"
  ],
  "excludeClasses": [
    "IOldLangTree",
    "OldStatement",
    "LangExpression",
    "LangValueType",
    "IfChild",
    "DllPathResolver",
    "FuncRunStatement",
    "ClassFieldSetStatement",
    "ClassFuncInitStatement"
  ],
  "generatePartialClasses": true,
  "addGeneratedCodeAttribute": true
}
