// 测试静态成员

PrintLine("=== 静态成员测试 ===")

// 定义一个包含静态成员的类
class MathUtil {
    static pi <- 3.14159
    
    static func getPi() {
        return MathUtil.pi
    }
    
    static func add(a, b) {
        return a + b
    }
    
    func multiply(a, b) {
        return a * b
    }
}

// 访问静态变量
PrintLine("MathUtil.pi = " + MathUtil.pi)

// 调用静态方法
PrintLine("MathUtil.getPi() = " + MathUtil.getPi())
PrintLine("MathUtil.add(2, 3) = " + MathUtil.add(2, 3))

// 实例化类
math <- MathUtil()

// 访问实例方法
PrintLine("math.multiply(2, 3) = " + math.multiply(2, 3))

// 测试静态成员修改
MathUtil.pi <- 3.14
PrintLine("修改后 MathUtil.pi = " + MathUtil.pi)
PrintLine("修改后 MathUtil.getPi() = " + MathUtil.getPi())

// 测试类变量和静态变量的区别
class Counter {
    static count <- 0
    
    func increment() {
        Counter.count <- Counter.count + 1
        return Counter.count
    }
}

counter1 <- Counter()
counter2 <- Counter()

PrintLine("counter1.increment() = " + counter1.increment())
PrintLine("counter2.increment() = " + counter2.increment())
PrintLine("Counter.count = " + Counter.count)

PrintLine("✅ 所有静态成员测试完成")