// 泛型约束的综合测试
// 测试约束在实际运行时的各种情况

// 1. 定义测试接口
interface IComparable {
    func compareTo(other: any) -> int {
        return 0
    }
}

interface ICloneable {
    func clone() -> any {
        return this
    }
}

interface ISerializable {
    func serialize() -> string {
        return "serialized"
    }
}

// 2. 定义实现接口的类
class ComparableInt implements IComparable {
    value: int

    func init(v: int) {
        this.value <- v
    }

    func compareTo(other: any) -> int {
        return this.value - other.value
    }
}

class CloneableString implements ICloneable {
    value: string

    func init(v: string) {
        this.value <- v
    }

    func clone() -> any {
        clone <- new CloneableString(this.value)
        return clone
    }
}

class SerializableData implements ISerializable {
    data: any

    func init(d: any) {
        this.data <- d
    }

    func serialize() -> string {
        return $"Data: {this.data.ToStr()}"
    }
}

// 3. 使用单个约束的泛型函数
func testSingleConstraint<T: IComparable>(item: T) -> string {
    result <- item.compareTo(item)
    return $"CompareTo result: {result.ToStr()}"
}

// 测试单约束
obj1 <- new ComparableInt(42)
result1 <- testSingleConstraint<ComparableInt>(obj1)
PrintLine($"测试1 - 单约束函数: {result1}")

// 4. 使用多约束（& 分隔）的泛型类
class MultiConstraintBox<T: ICloneable & ISerializable> {
    value: T

    func init(v: T) {
        this.value <- v
    }

    func process() -> string {
        cloned <- this.value.clone()
        serialized <- this.value.serialize()
        return $"Cloned: {cloned.ToStr()}, Serialized: {serialized}"
    }
}

// 注意：这个测试展示语法，但由于类型系统限制，实际使用时需要满足所有约束
PrintLine("测试2 - 多约束类定义: 通过")

// 5. 使用 where 子句的泛型函数
func processWithWhere<T>(value: T) -> string where T: ISerializable {
    return value.serialize()
}

obj3 <- new SerializableData("test data")
result3 <- processWithWhere<SerializableData>(obj3)
PrintLine($"测试3 - where 子句函数: {result3}")

// 6. 多类型参数的 where 子句
func combineWithWhere<K, V>(key: K, value: V) -> string where K: IComparable, V: ISerializable {
    keySer <- key.compareTo(key).ToStr()
    valueSer <- value.serialize()
    return $"Key: {keySer}, Value: {valueSer}"
}

obj4 <- new ComparableInt(100)
obj5 <- new SerializableData("combined")
result4 <- combineWithWhere<ComparableInt, SerializableData>(obj4, obj5)
PrintLine($"测试4 - 多参数 where 子句: {result4}")

// 7. 混合约束语法（泛型参数声明 + where 子句）
func mixedConstraints<T: IComparable>(value: T) -> string where T: ICloneable {
    compared <- value.compareTo(value)
    // 注意：由于当前类型系统限制，这里仅展示语法
    return $"Mixed constraints result: {compared.ToStr()}"
}

PrintLine("测试5 - 混合约束语法: 通过")

// 8. 泛型类的实例化
class GenericContainer<T: ISerializable> {
    items: any

    func init() {
        this.items <- {}
    }

    func add(item: T) {
        this.items.Add(item)
    }

    func serializeAll() -> string {
        result <- ""
        for item in this.items {
            result <- result + item.serialize() + "; "
        }
        return result
    }
}

container <- new GenericContainer<SerializableData>()
container.add(new SerializableData("item1"))
container.add(new SerializableData("item2"))
result5 <- container.serializeAll()
PrintLine($"测试6 - 泛型容器: {result5}")

PrintLine("\n所有泛型约束测试完成！✓")
