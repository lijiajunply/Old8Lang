func gen(n:int) -> void {
    PrintLine("gen called with n = " + n.ToStr() + ", address = " + n.GetHashCode().ToStr())
    while n < 3 {
        PrintLine("before yield, n = " + n.ToStr() + ", address = " + n.GetHashCode().ToStr())
        yield n
        PrintLine("after yield, before read n, checking...")
        tmp <- n
        PrintLine("read n = " + tmp.ToStr() + ", address = " + tmp.GetHashCode().ToStr())
        PrintLine("about to increment n...")
        n <- n + 1
        PrintLine("after increment, n = " + n.ToStr() + ", address = " + n.GetHashCode().ToStr())
    }
    PrintLine("while loop ended, n = " + n.ToStr())
}

for i in gen(1) {
    PrintLine("received: " + i.ToStr())
}
