// 测试类型推断功能（需启用类型推断）
// 本测试需要通过代码启用 TypeInferenceConfig.Instance.EnableTypeInference = true

// 测试1：从默认值推断参数类型
func greet(name:string, greeting: "Hello") -> void {
    PrintLine(greeting + ", " + name + "!")
}

// 测试2：完整类型注解
func add(x:int, y:int) -> int {
    return x + y
}

// 测试3：使用推断的函数
greet("Old8")
greet("World", "Hi")

result <- add(10, 20)
PrintLine("10 + 20 = " + result.ToStr())

PrintLine("All tests passed!")
