// 调试扩展方法中的this

extension string {
    func debugThis() {
        print("=== 开始调试 ===")
        print("this 的值: " + this)
        print("this.length(): " + this.length().ToStr())

        // 测试直接访问
        print("准备访问 this[0]...")
        c <- this[0]
        print("this[0] 的值: " + c)

        // 测试通过变量访问
        print("准备通过变量访问...")
        s <- this
        print("s 的值: " + s)
        c2 <- s[0]
        print("s[0] 的值: " + c2)

        return c
    }
}

str <- "Hello"
result <- str.debugThis()
print("最终返回值: " + result)
