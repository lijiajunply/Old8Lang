// main.old8 - 测试虚拟环境

PrintLine("=== 虚拟环境测试 ===")
PrintLine("")

// 导入 Logger 包（应该从项目本地 packages/ 加载）
import "Logger"

PrintLine("✓ Logger 包导入成功")
PrintLine("")

// 创建 Logger 实例
logger <- Logger.Create("VirtualEnvTest")

logger.Info("这是虚拟环境中的测试")
logger.Warn("包应该从项目本地 packages/Logger@1.2.0 加载")
logger.Error("而不是从全局 ~/.old8lang/packages/ 加载")

PrintLine("")
PrintLine("=== 测试完成 ===")
