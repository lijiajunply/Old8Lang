// 测试 using 语句（资源自动管理）

// 测试 1: 使用 mutex 资源管理
PrintLine("=== 测试 1: 使用 mutex 资源 ===")
using mutex <- MutexCreate() {
    MutexLock(mutex)
    PrintLine("持有互斥锁")
    MutexUnlock(mutex)
}
// mutex 应该在这里自动 dispose
PrintLine("Mutex 已自动释放")

// 测试 2: 使用 channel 资源管理
PrintLine("=== 测试 2: 使用 channel 资源 ===")
using ch <- ChannelCreate() {
    ChannelSend(ch, 123)
    value <- ChannelReceive(ch)
    PrintLine("接收到值: " + value.ToStr())
}
// channel 应该在这里自动 dispose
PrintLine("Channel 已自动释放")

// 测试 3: 使用现有变量（不带声明）
PrintLine("=== 测试 3: 使用现有变量 ===")
sem <- SemaphoreCreate(1, 1)
using sem {
    SemaphoreAcquire(sem)
    PrintLine("获取信号量")
    SemaphoreRelease(sem)
}
// sem 应该在这里自动 dispose
PrintLine("Semaphore 已自动释放")

PrintLine("=== 所有测试完成 ===")
