// HttpClient.old8 - HTTP 客户端库

// 注意：这里演示包依赖，实际的 HTTP 功能需要使用标准库
import "Logger"

class HttpClient {
    private baseUrl:string
    private logger:object

    constructor(baseUrl:string) {
        this.baseUrl <- baseUrl
        this.logger <- Logger.Create("HttpClient")
        this.logger.Info($"Initialized HTTP client with base URL: {baseUrl}")
    }

    public func Get(path:string) -> object {
        fullUrl <- this.baseUrl + path
        this.logger.Info($"GET request to: {fullUrl}")

        // 模拟 HTTP 响应
        response <- {
            "Status": 200,
            "StatusText": "OK",
            "Body": $"Response from {fullUrl}",
            "Headers": {
                "Content-Type": "application/json"
            }
        }

        this.logger.Info($"Received response: Status {response["Status"]}")
        return response
    }

    public func Post(path:string, data:object) -> object {
        fullUrl <- this.baseUrl + path
        this.logger.Info($"POST request to: {fullUrl}")

        // 模拟 HTTP 响应
        response <- {
            "Status": 201,
            "StatusText": "Created",
            "Body": $"Created resource at {fullUrl}",
            "Headers": {
                "Content-Type": "application/json"
            }
        }

        this.logger.Info($"Received response: Status {response["Status"]}")
        return response
    }

    public func SetLogLevel(level:string) -> void {
        this.logger.SetLevel(level)
    }
}

// 导出工厂函数
Create <- (baseUrl:string) -> {
    return HttpClient(baseUrl)
}

// 导出类
HttpClientClass <- HttpClient
