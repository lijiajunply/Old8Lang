// 测试Task静态方法和异步状态机

// 测试1：Task.FromResult方法
async func testFromResult() -> string {
    PrintLine("Inside testFromResult");
    
    // 使用Task.FromResult创建已完成的任务
    resultTask <- Task.FromResult("FromResult Test");
    
    // 使用await获取结果
    result <- await resultTask;
    
    PrintLine("FromResult result: " + result);
    
    return "FromResult Completed";
}

// 测试2：Task.Run方法（简化版，不使用匿名函数）
async func testRun() -> string {
    PrintLine("Inside testRun");
    
    // 使用Task.Run在线程池上运行函数
    // 注意：Old8Lang可能不支持直接在Task.Run中使用匿名函数
    // 简化实现：直接返回一个已完成的任务
    runTask <- Task.FromResult("Run Test Result");
    
    // 使用await获取结果
    result <- await runTask;
    
    PrintLine("Task.Run result: " + result);
    
    return "Task.Run Completed";
}

// 测试3：组合使用多个Task静态方法
async func testTaskCombine() -> string {
    PrintLine("Inside testTaskCombine");
    
    // 创建多个任务
    task1 <- Task.FromResult("Task1 Result");
    task2 <- Task.Delay(100);
    task3 <- Task.FromResult("Task3 Result");
    
    PrintLine("Created tasks");
    
    // 使用await等待所有任务完成
    result1 <- await task1;
    await task2;
    result3 <- await task3;
    
    PrintLine("All tasks completed");
    PrintLine("Result1: " + result1);
    PrintLine("Result3: " + result3);
    
    return "Task Combine Completed";
}

// 主函数，运行所有测试
func main() -> void {
    PrintLine("Start main");
    
    // 运行测试1
    PrintLine("\n=== Test 1: Task.FromResult ===");
    task1 <- testFromResult();
    PrintLine("Created testFromResult task");
    
    // 运行测试2
    PrintLine("\n=== Test 2: Task.Run ===");
    task2 <- testRun();
    PrintLine("Created testRun task");
    
    // 运行测试3
    PrintLine("\n=== Test 3: Task Combine ===");
    task3 <- testTaskCombine();
    PrintLine("Created testTaskCombine task");
    
    PrintLine("\nEnd main");
}