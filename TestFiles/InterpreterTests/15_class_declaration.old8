// 类的继承（如果支持）
PrintLine("\n=== 类的继承（如果支持） ===")

class Animal {
    name <- ""
    
    func init(name) {
        this.name <- name
    }
    
    func makeSound() {
        return "Some sound"
    }
}

class Dog extends Animal {
    func makeSound() {
        return "Woof!"
    }
}

class Cat extends Animal {
    func makeSound() {
        return "Meow!"
    }
}

// 尝试使用继承
dog <- Dog("Buddy")
cat <- Cat("Kitty")
PrintLine(dog.name + " says: " + dog.makeSound())
PrintLine(cat.name + " says: " + cat.makeSound())

// 类的静态成员（如果支持）
PrintLine("\n=== 类的静态成员（如果支持） ===")

class MathUtil {
    static pi <- 3.14159
    
    static func getPi() {
        return 3.14159
    }
}

// 尝试访问静态成员
PrintLine("MathUtil.pi = " + MathUtil.pi)
PrintLine("MathUtil.getPi() = " + MathUtil.getPi())

PrintLine("\n✅ 所有类声明和实例化测试完成")
