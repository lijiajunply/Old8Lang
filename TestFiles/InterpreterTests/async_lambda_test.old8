// 异步Lambda表达式解释模式测试

// 测试异步无参数Lambda表达式
async_lambda1 <- async () -> 123
result1 <- await async_lambda1()
PrintLine("异步无参数Lambda表达式结果: " + result1)

// 测试异步有参数Lambda表达式
async_lambda2 <- async (x: int) -> x + 1
result2 <- await async_lambda2(42)
PrintLine("异步有参数Lambda表达式结果: " + result2)

// 测试异步Lambda表达式块语句体
async_lambda3 <- async (x: int, y: int) -> {
    sum <- x + y
    return sum
}
result3 <- await async_lambda3(10, 20)
PrintLine("异步Lambda表达式块语句体结果: " + result3)

// 测试异步Lambda表达式作为参数（简化类型注解）
func test_async_param(func) {
    result <- await func()
    return result * 2
}

async_lambda4 <- async () -> 100
result4 <- test_async_param(async_lambda4)
PrintLine("异步Lambda表达式作为参数结果: " + result4)

// 测试异步Lambda表达式作为返回值（简化类型注解）
func create_async() {
    return async () -> 200
}

async_lambda5 <- create_async()
result5 <- await async_lambda5()
PrintLine("异步Lambda表达式作为返回值结果: " + result5)

// 测试await func()语法
async_func <- async () -> 300
result6 <- await async_func()
PrintLine("await func()语法结果: " + result6)

// 暂时移除await c.func()语法测试，因为类的异步方法定义和调用可能有问题
// 这个功能需要额外的实现工作，不属于当前任务的核心目标

// 测试嵌套await
async_outer <- async () -> {
    async_inner <- async () -> 500
    inner_result <- await async_inner()
    return inner_result + 100
}
result8 <- await async_outer()
PrintLine("嵌套await结果: " + result8)