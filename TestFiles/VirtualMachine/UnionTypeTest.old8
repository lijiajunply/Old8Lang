// Test Union Types

class A {
    func methodA() { PrintLine("A") }
}

class B {
    func methodB() { PrintLine("B") }
}

class C {
    func methodC() { PrintLine("C") }
}

// Variable with union type
a: A | B <- A()
PrintLine("A | B (A) passed")

b: A | B <- B()
PrintLine("A | B (B) passed")

// Test type check failure
try {
    c: A | B <- C()
} catch (e) {
    PrintLine("Caught expected error for A | B: " + e)
}

// Test cast
obj <- A()
casted <- obj as "A | B"
PrintLine("Cast to A | B passed")

try {
    obj2 <- C()
    casted2 <- obj2 as "A | B"
} catch (e) {
    PrintLine("Caught expected error for Cast to A | B: " + e)
}

// Test primitive union
// Note: Function parameter type checking is not yet implemented in VM mode.
// We use variable assignment to test type checking logic.

val1: int | string <- 123
PrintLine("int | string (int) passed")

val2: int | string <- "hello"
PrintLine("int | string (string) passed")

try {
    val3: int | string <- 3.14 // double
} catch (e) {
    PrintLine("Caught expected error for int | string: " + e)
}
