// 异步流（Async Stream）语法测试用例

// 测试1：简单的异步生成器函数声明
async func simpleAsyncStream() {
    yield 1
    yield 2
    yield 3
}

// 测试2：带参数的异步生成器函数
async func asyncStreamWithParams(start:int, end:int) {
    i <- start
    while i <= end {
        yield i
        i <- i + 1
    }
}

// 测试3：异步 for-in 循环 - 基本语法
async func testAsyncForIn() {
    stream <- simpleAsyncStream()

    async for item in stream {
        PrintLine(item)
    }
}

// 测试4：异步 for-in 循环 - 带多个标识符（键值对）
async func asyncDictStream() {
    yield ("key1", "value1")
    yield ("key2", "value2")
    yield ("key3", "value3")
}

async func testAsyncForInKeyValue() {
    stream <- asyncDictStream()

    async for key, value in stream {
        PrintLine(key + ": " + value)
    }
}

// 测试5：嵌套的异步 for-in 循环
async func nestedAsyncForIn() {
    outerStream <- asyncStreamWithParams(1, 3)

    async for outer in outerStream {
        innerStream <- asyncStreamWithParams(1, 2)

        async for inner in innerStream {
            PrintLine("Outer: " + outer.ToStr() + ", Inner: " + inner.ToStr())
        }
    }
}

// 测试6：异步流中使用 await
async func asyncStreamWithAwait() {
    i <- 1
    while i <= 3 {
        await Task.Delay(100)
        yield i
        i <- i + 1
    }
}

// 测试7：async for-in 中的 break 和 continue
async func testBreakContinue() {
    stream <- asyncStreamWithParams(1, 10)

    async for item in stream {
        if item == 5 {
            continue
        }
        if item == 8 {
            break
        }
        PrintLine(item)
    }
}

// 测试8：异步流返回值
async func asyncStreamWithReturn() {
    yield 1
    yield 2
    return "Done"
}

// 测试9：空的异步生成器
async func emptyAsyncStream() {
    // 不产生任何值
}

async func testEmptyStream() {
    stream <- emptyAsyncStream()

    async for item in stream {
        PrintLine("This should not print")
    }
}

// 测试10：异步 for-in 循环处理普通列表（向后兼容）
async func testAsyncForInList() {
    list <- {1, 2, 3, 4, 5}

    async for item in list {
        PrintLine(item)
    }
}
