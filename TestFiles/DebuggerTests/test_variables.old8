// 测试变量监视
count = 0
total = 0

for (i = 1; i <= 5; i++) {
    count = count + 1
    total = total + i
    
    // 在这里可以监视变量变化
    if (i == 3) {
        PrintLine("中间结果: count=" + count + ", total=" + total)
    }
}

PrintLine("最终结果: count=" + count + ", total=" + total)

// 测试条件断点
flag = true
value = 100

if (flag) {
    value = value / 2
    PrintLine("flag为true, value=" + value)
}

PrintLine("程序结束")