// 复杂异步函数测试用例

// 测试1：嵌套await调用
async func nestedAwait() {
    async func innerAsync() {
        return "InnerResult"
    }
    
    innerResult <- await innerAsync()
    return "Outer_" + innerResult
}

// 测试2：异步函数异常处理
async func asyncWithException() {
    throw "AsyncException"
}

// 测试3：带参数和返回值的异步函数
async func asyncAdd(a:int, b:int) {
    return a + b
}

// 测试4：异步函数之间的调用
async func asyncChain() {
    result1 <- await asyncAdd(10, 20)
    result2 <- await asyncAdd(result1, 30)
    return result2
}

// 测试5：异步函数中的条件语句
async func asyncCondition(flag:bool) {
    if flag {
        return "TrueResult"
    } else {
        return "FalseResult"
    }
}