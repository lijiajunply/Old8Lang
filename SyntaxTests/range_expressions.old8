// 范围表达式测试文件

// 测试1: 基本范围表达式
range1 <- [1~10]
range2 <- [0~5]
range3 <- [5~15]
range4 <- [10~20]

// 测试2: 使用范围表达式进行循环
// 遍历范围中的每个元素
count1 <- 0
for i in [1~5] {
    count1 <- count1 + i
}

count2 <- 0
for i in [0~10] {
    count2 <- count2 + 1
}

// 测试3: 在列表推导式中使用范围表达式
squares <- [x * x for x in [1~5]]
doubles <- [x * 2 for x in [0~10]]
evens <- [x for x in [1~20] if x % 2 == 0]

// 测试4: 嵌套范围表达式
// 生成二维范围
nested_count <- 0
for i in [1~3] {
    for j in [1~3] {
        nested_count <- nested_count + i * j
    }
}

// 测试5: 范围表达式与条件语句结合
range_conditional <- [x for x in [1~10] if x > 5]

// 测试6: 范围表达式与函数结合
func sum_range(range_expr) {
    sum <- 0
    for i in range_expr {
        sum <- sum + i
    }
    return sum
}

result1 <- sum_range([1~5])
result2 <- sum_range([0~10])

// 测试7: 复杂范围表达式使用
// 作为函数参数传递
func process_range(range_expr, operation) {
    result <- []
    for i in range_expr {
        result.Add(operation(i))
    }
    return result
}

func square(x) {
    return x * x
}

func double(x) {
    return x * 2
}

result3 <- process_range([1~5], square)
result4 <- process_range([1~5], double)

// 测试8: 范围表达式在if条件中
if [1~5] == [1~5] {
    range_equal <- true
} else {
    range_equal <- false
}

// 测试9: 范围表达式与其他复合类型结合
// 范围作为列表元素
mixed_list <- [1, 2, [3~5], 6, 7]

// 范围作为字典值
range_dict <- {
    "small": [1~5],
    "medium": [1~10],
    "large": [1~20]
}

// 测试10: 范围表达式与字符串模板结合
range_template <- $($"Range [1~5] has {sum_range([1~5])} as sum.")

// 测试11: 多个范围表达式
range_a <- [1~3]
range_b <- [4~6]
range_c <- [7~9]

combined_sum <- sum_range(range_a) + sum_range(range_b) + sum_range(range_c)

// 测试12: 范围表达式与lambda结合
lambda_sum <- 0
process_range([1~5], (x) -> {
    lambda_sum <- lambda_sum + x
})

// 测试13: 范围表达式在类方法中
class RangeProcessor {
    func getRangeSum(range_expr) {
        sum <- 0
        for i in range_expr {
            sum <- sum + i
        }
        return sum
    }
}

processor <- RangeProcessor()
result5 <- processor.getRangeSum([1~5])
result6 <- processor.getRangeSum([0~10])

// 测试14: 范围表达式与异常处理结合
try {
    // 假设范围表达式可以抛出异常
    invalid_range <- [5~1]  // 反向范围
    result7 <- sum_range(invalid_range)
} catch (e) {
    result7 <- "Error: " + e
}

// 测试15: 范围表达式作为返回值
func getRange(size) {
    return [1~size]
}

dynamic_range <- getRange(5)
result8 <- sum_range(dynamic_range)

// 打印结果（语法测试，实际运行时会输出）
PrintLine(count1)
PrintLine(squares)
PrintLine(result1)
PrintLine(result3)