// 复杂语法测试文件

// 测试1: 类、函数、Lambda的复杂组合
class ComplexClass {
    // 字段初始化
    numbers <- [1, 2, 3, 4, 5]
    name <- "ComplexClass"
    
    // 构造函数
    func init(newName) {
        name <- newName
    }
    
    // 方法中使用Lambda
    func processNumbers(operation) {
        result <- []
        for num in this.numbers {
            result.Add(operation(num))
        }
        return result
    }
    
    // 方法返回Lambda
    func createProcessor(factor) {
        return (x) -> x * factor
    }
    
    // 复杂方法（包含条件、循环、异常处理）
    func complexMethod(input) {
        try {
            if input == null {
                return "Error: Input is null"
            }
            
            result <- 0
            for i in [1~10] {
                if i % 2 == 0 {
                    result <- result + i * input
                } else {
                    result <- result - i * input
                }
            }
            
            // 使用字符串模板
            return $($"Result for {input} is {result}")
        } catch (e) {
            return $($"Error: {e}")
        } finally {
            this.lastProcessed <- input
        }
    }
    
    // 静态方法（如果支持）
    func staticMethod() {
        return "This is a static method"
    }
}

// 测试2: 实例化复杂类
complexObj <- ComplexClass()
complexObj.init("TestObject")

// 测试3: 使用类的方法
// 使用Lambda作为参数
squares <- complexObj.processNumbers((x) -> x * x)
doubles <- complexObj.processNumbers((x) -> x * 2)

// 使用返回的Lambda
processor <- complexObj.createProcessor(10)
processed <- complexObj.processNumbers(processor)

// 测试复杂方法
result1 <- complexObj.complexMethod(5)
result2 <- complexObj.complexMethod(10)

// 测试4: 函数嵌套、闭包、递归的复杂组合
func outerFunction(base) {
    // 内部函数
    func innerFunction(exponent) {
        // 递归函数
        func power(x, y) {
            if y <= 0 {
                return 1
            }
            return x * power(x, y - 1)
        }
        
        return power(base, exponent)
    }
    
    return innerFunction
}

// 使用复杂函数组合
powerOf2 <- outerFunction(2)
powerOf3 <- outerFunction(3)

result3 <- powerOf2(3)  // 2^3 = 8
result4 <- powerOf3(4)  // 3^4 = 81

// 测试5: 控制流、列表推导式、字符串模板的复杂组合
func complexControlFlow() {
    // 复杂条件
    condition <- true
    
    if condition {
        // 列表推导式与范围表达式
        numbers <- [x for x in [1~10] if x % 2 == 0]
        
        // 字符串模板与列表推导式结合
        template <- $($"Even numbers: {numbers}")
        
        // 嵌套循环
        matrix <- [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
        flattened <- [x for row in matrix for x in row]
        
        // 复杂赋值
        result <- {
            "template": template,
            "flattened": flattened,
            "sum": sum(flattened)
        }
        
        return result
    } else {
        return {"error": "Condition failed"}
    }
}

// 测试6: 异常处理与各种语法的结合
func complexExceptionHandling() {
    try {
        // 可能抛出异常的代码
        riskyOperation()
        
        // 复杂表达式
        complexExpr <- (10 + 20) * (30 - 25) / 2
        
        // 列表推导式
        exprList <- [x * complexExpr for x in [1~5]]
        
        return $($"Success: {exprList}")
    } catch (e) {
        return $($"Exception caught: {e}")
    } finally {
        cleanup()
    }
}

// 辅助函数
func riskyOperation() {
    // 假设这个函数可能抛出异常
    return 42
}

func cleanup() {
    // 清理资源
    return true
}

func sum(list) {
    result <- 0
    for item in list {
        result <- result + item
    }
    return result
}

// 测试7: 多重导入与复杂模块使用
import "module1"
import "module2"

// 假设模块存在，测试语法
// module1.someFunction()
// module2.someFunction()

// 测试8: 复杂的列表推导式嵌套
nestedComprehension <- [[i * j for j in [1~5]] for i in [1~5]]

// 测试9: 范围表达式与各种语法结合
rangeTest <- [x * x for x in [1~10] if x > 5]

// 测试10: 最终的复杂组合
// 将所有语法元素组合在一起
func ultimateComplexFunction() {
    // 1. 创建类实例
    obj <- ComplexClass()
    obj.init("UltimateTest")
    
    // 2. 使用Lambda
    processor <- (x) -> x * 100
    processed <- obj.processNumbers(processor)
    
    // 3. 复杂控制流
    if processed[0] > 500 {
        // 4. 异常处理
        try {
            // 5. 字符串模板
            message <- $($"Processed: {processed}")
            
            // 6. 列表推导式
            filtered <- [x for x in processed if x > 700]
            
            // 7. 范围表达式
            rangeSum <- sum([x for x in [1~100]])
            
            // 8. 最终结果
            return {
                "message": message,
                "filtered": filtered,
                "rangeSum": rangeSum,
                "status": "success"
            }
        } catch (e) {
            return {"error": e}
        }
    } else {
        return {"status": "failed"}
    }
}

// 执行最终测试
finalResult <- ultimateComplexFunction()

// 打印结果
PrintLine(finalResult.status)
if finalResult.status == "success" {
    PrintLine(finalResult.message)
    PrintLine(finalResult.filtered)
    PrintLine(finalResult.rangeSum)
}