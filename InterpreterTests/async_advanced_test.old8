// 高级异步功能测试
import Async

// 测试任务组合方法 - WhenAll
PrintLine("=== 测试1: 任务组合方法 - WhenAll ===")

async func task1() {
    Sleep(200)
    return 1
}

async func task2() {
    Sleep(100)
    return 2
}

// 测试 WhenAll
printTask <- Task.WhenAll([task1(), task2()])
result1 <- await printTask
PrintLine("WhenAll 结果: " + result1)

// 测试任务组合方法 - WhenAny
PrintLine("\n=== 测试2: 任务组合方法 - WhenAny ===")

anyTask <- Task.WhenAny([task1(), task2()])
result2 <- await anyTask
PrintLine("WhenAny 结果: " + result2)

// 测试5: 任务组合方法 - Retry
PrintLine("\n=== 测试3: 任务组合方法 - Retry ===")

retryCount <- 0

async func flakyTask() {
    retryCount <- retryCount + 1
    PrintLine("重试次数: " + retryCount)
    if retryCount < 3 {
        throw new Error("任务失败，需要重试")
    }
    return "重试成功"
}

retryTask <- flakyTask().Retry(3, 200)
result5 <- await retryTask
PrintLine("Retry 结果: " + result5)

PrintLine("\n所有测试完成!")