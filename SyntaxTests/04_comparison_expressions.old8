// 测试比较表达式

// 准备测试数据
a <- 10
b <- 5
c <- 10

// 测试基本比较运算
result1 <- a == b
result2 <- a == c
result3 <- a != b
result4 <- a < b
result5 <- a > b
result6 <- a <= b
result7 <- a >= b
result8 <- a <= c
result9 <- a >= c

// 测试比较表达式与算术表达式结合
result10 <- a + b > c
result11 <- a - b < c
result12 <- a * b == c * 5
result13 <- a