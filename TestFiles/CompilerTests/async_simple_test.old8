// 简单的异步编译测试
// 只测试基本的异步函数声明和调用

// 第一个异步函数，直接返回字符串
async func simpleAsync() -> string {
    PrintLine("Inside simpleAsync");
    return "Hello, Async!";
}

// 第二个异步函数，调用第一个异步函数
async func asyncCaller() -> string {
    PrintLine("Inside asyncCaller");
    // 调用另一个异步函数
    result <- simpleAsync();
    PrintLine("Called simpleAsync from asyncCaller");
    return "Result: " + result;
}

// 主函数，调用异步函数但不使用await
func main() -> void {
    PrintLine("Start main");
    // 直接调用异步函数，获取Task对象
    task1 <- simpleAsync();
    task2 <- asyncCaller();
    PrintLine("Called both async functions");
    PrintLine("End main");
}