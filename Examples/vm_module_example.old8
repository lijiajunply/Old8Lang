// vm_module_example.old8 - 虚拟机模块导入示例

// 导入数学模块的特定函数
import { add, multiply } from "vm_math_module"

func main() -> void {
    PrintLine("=== 虚拟机模块导入示例 ===")

    // 使用导入的函数
    result1 <- add(10, 20)
    PrintLine("add(10, 20) = " + result1.ToStr())

    result2 <- multiply(5, 6)
    PrintLine("multiply(5, 6) = " + result2.ToStr())

    // 组合使用
    result3 <- add(multiply(2, 3), multiply(4, 5))
    PrintLine("add(multiply(2, 3), multiply(4, 5)) = " + result3.ToStr())

    PrintLine("=== 测试完成 ===")
}
