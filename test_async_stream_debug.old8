// 测试异步流的基本功能
numberStream <- async {
    for i in [1~5] {
        yield i
    }
}

squaredStream <- async {
    async for num in numberStream {
        yield num * num
    }
}

sum <- 0
async for squared in squaredStream {
    PrintLine("Got: " + squared.ToStr())
    sum <- sum + squared
}

PrintLine("Sum: " + sum.ToStr())
