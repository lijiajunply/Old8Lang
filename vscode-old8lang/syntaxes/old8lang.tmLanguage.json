{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Old8Lang",
  "scopeName": "source.old8lang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.old8lang",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.old8lang",
          "match": "\\b(if|elif|else|for|while|for-in|switch|case|default|return|break|continue|try|catch|finally|throw|yield)\\b"
        },
        {
          "name": "keyword.other.old8lang",
          "match": "\\b(func|class|import|native|async|await)\\b"
        },
        {
          "name": "storage.modifier.old8lang",
          "match": "\\b(public|private|static|const)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.old8lang",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.old8lang",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.old8lang",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.old8lang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.old8lang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.old8lang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.old8lang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.old8lang",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.old8lang",
          "match": "<-"
        },
        {
          "name": "keyword.operator.comparison.old8lang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.old8lang",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.old8lang",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.old8lang",
          "match": "(->|\\.|\\:|,|;)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.old8lang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.old8lang",
          "match": "\\b(int|double|string|bool|char|void|var)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.old8lang",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    }
  }
}
