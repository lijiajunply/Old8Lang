// 排序和其他方法测试

print("=== 排序和其他方法测试 ===\n")

// 1. 测试 Sort 方法
print("\n1. 测试 Sort 方法\n")

tuple1 <- (5, 2, 8, 1, 9, 3)
print("tuple1 = ")
print(tuple1)
print("\n")

sorted1 <- tuple1.Sort()
print("tuple1.Sort() = ")
print(sorted1)
print("\n")

// 2. 测试 IsSorted 方法
print("\n2. 测试 IsSorted 方法\n")

tuple2 <- (1, 2, 3, 4, 5)
isSorted1 <- tuple2.IsSorted()
print("(1,2,3,4,5).IsSorted() = ")
print(isSorted1)
print("\n")

tuple3 <- (5, 2, 8, 1)
isSorted2 <- tuple3.IsSorted()
print("(5,2,8,1).IsSorted() = ")
print(isSorted2)
print("\n")

// 3. 测试 ToStr 方法
print("\n3. 测试 ToStr 方法\n")

arr1 <- [1, 2, 3, 4, 5]
str1 <- arr1.ToStr()
print("arr1.ToStr() = ")
print(str1)
print("\n")

// 4. 测试 ElementAt 方法
print("\n4. 测试 ElementAt 方法\n")

arr2 <- [10, 20, 30, 40, 50]
print("arr2 = ")
print(arr2)
print("\n")

elem1 <- arr2.ElementAt(2)
print("arr2.ElementAt(2) = ")
print(elem1)
print("\n")

// 支持负数索引
elem2 <- arr2.ElementAt(-1)
print("arr2.ElementAt(-1) = ")
print(elem2)
print("\n")

elem3 <- arr2.ElementAt(-2)
print("arr2.ElementAt(-2) = ")
print(elem3)
print("\n")

// 5. 测试 LastOrDefault 方法
print("\n5. 测试 LastOrDefault 方法\n")

arr3 <- [1, 2, 3]
last1 <- arr3.LastOrDefault()
print("[1,2,3].LastOrDefault() = ")
print(last1)
print("\n")

// 6. 测试字符串数组排序
print("\n6. 测试字符串数组排序\n")

arr4 <- ["cherry", "apple", "banana", "date"]
print("arr4 = ")
print(arr4)
print("\n")

sorted2 <- arr4.Sort()
print("arr4.Sort() = ")
print(sorted2)
print("\n")

// 7. 测试混合操作
print("\n7. 测试混合操作\n")

arr5 <- [3, 1, 4, 1, 5, 9, 2, 6]
print("arr5 = ")
print(arr5)
print("\n")

// 先去重再排序
distinct1 <- arr5.Distinct()
print("arr5.Distinct() = ")
print(distinct1)
print("\n")

sorted3 <- distinct1.Sort()
print("distinct1.Sort() = ")
print(sorted3)
print("\n")

// 检查是否已排序
isSorted3 <- sorted3.IsSorted()
print("sorted3.IsSorted() = ")
print(isSorted3)
print("\n")

// 转换为字符串
str2 <- sorted3.ToStr()
print("sorted3.ToStr() = ")
print(str2)
print("\n")

// 8. 测试 Tuple 的完整链式调用
print("\n8. 测试 Tuple 的完整链式调用\n")

tuple4 <- (5, 2, 8, 2, 9, 1, 5)
print("tuple4 = ")
print(tuple4)
print("\n")

result <- tuple4.Distinct().Sort()
print("tuple4.Distinct().Sort() = ")
print(result)
print("\n")

str3 <- result.Join(" -> ")
print("result.Join(\" -> \") = ")
print(str3)
print("\n")

print("\n=== 所有测试完成 ===\n")
