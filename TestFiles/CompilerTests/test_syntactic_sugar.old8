// 测试空值合并运算符和解构赋值语法（编译模式）

// 1. 空值合并运算符测试
PrintLine("=== 空值合并运算符测试 ===");

a <- null;
result1 <- a ?? "default";
PrintLine(result1); // 应该输出: default

b <- "value";
result2 <- b ?? "default";
PrintLine(result2); // 应该输出: value

c <- 0;
result3 <- c ?? 42;
PrintLine(result3); // 应该输出: 0

// 2. 数组解构赋值测试
PrintLine("\n=== 数组解构赋值测试 ===");

// 基本数组解构
array <- [1, 2, 3];
[a, b, c] <- array;
PrintLine(a); // 应该输出: 1
PrintLine(b); // 应该输出: 2
PrintLine(c); // 应该输出: 3

// 跳过元素
[d, , e] <- [4, 5, 6];
PrintLine(d); // 应该输出: 4
PrintLine(e); // 应该输出: 6

// 3. 对象解构赋值测试（简化版，因为编译模式下对象创建比较复杂）
PrintLine("\n=== 对象解构赋值测试 ===");

// 创建一个简单的字典对象
person <- {name: "Alice", age: 30};

// 基本对象解构
{name, age} <- person;
PrintLine(name); // 应该输出: Alice
PrintLine(age); // 应该输出: 30

// 带别名的对象解构
{name: personName, age: personAge} <- person;
PrintLine(personName); // 应该输出: Alice
PrintLine(personAge); // 应该输出: 30
