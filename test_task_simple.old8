// Task 实例方法测试 - 简化版
// 测试 Task 的 4 个实例方法：Await, Then, Catch, Finally

print("=== Task 实例方法测试 ===\n")

// 1. 测试 Await 方法
print("\n1. 测试 Await 方法\n")

async func asyncFunc1() {
    return 42
}

task1 <- asyncFunc1()
print("task1 创建完成\n")
result1 <- task1.Await()
print("task1.Await() = ")
print(result1)
print("\n")

print("\n=== 测试完成 ===\n")
