// 简单的异步功能测试

import Time

// 测试任务组合方法 - Then

async func task1() {
    return 1
}

async func task2() {
    return 2
}

// 测试 Then 方法
result <- await task1().Then((res) -> {
    return task2()
})

// 打印结果（使用 Old8Lang 的内置打印函数）
PrintLine("Then 结果: " + result)

// 测试 Retry 方法
// 注意：由于异步函数的作用域隔离机制，每次重试都会使用独立的作用域副本
// 因此我们使用基于时间的方式来测试重试功能

startTime <- GetUnixTimeMilliseconds()

async func flakyTask() {
    currentTime <- GetUnixTimeMilliseconds()
    elapsed <- currentTime - startTime

    // 前200毫秒内失败，之后成功
    if elapsed < 200 {
        throw "任务失败，需要重试"
    }
    return "重试成功"
}

retryResult <- await flakyTask().Retry(3, 100)
PrintLine("Retry 结果: " + retryResult)