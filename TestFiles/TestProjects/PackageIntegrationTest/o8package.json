{
  "name": "packageintegrationtest",
  "version": "1.0.0",
  "description": "PackageIntegrationTest project",
  "author": "",
  "license": "MIT",
  "old8lang": {
    "version": "^1.0.0",
    "runtime": "interpreter"
  },
  "main": "src/main.old8",
  "dependencies": {
    "Logger": "1.0.0"
  },
  "devDependencies": {
    "--dev": "*"
  },
  "scripts": {
    "start": "old8lang run src/main.old8",
    "test": "old8lang run tests/test_main.old8"
  },
  "repositories": [
    "https://packages.old8lang.org"
  ],
  "packageManager": {
    "useVirtualEnv": true,
    "packagesDir": "./packages",
    "autoLock": true,
    "strict": false
  }
}