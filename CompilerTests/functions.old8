// 函数测试

// 1. 基本函数定义与调用

// 根据EBNF：funcDeclaration = ( identifier | "func" identifier ) "(" idList? ")" "->" block

// 无参数无返回值函数
func say_hello() -> {
    // 假设Old8Lang支持print函数
    // print("Hello, World!")
}

// 调用函数
say_hello()

// 2. 带参数的函数

// 单个参数函数
func greet(name) -> {
    // print("Hello, " + name + "!")
}

// 调用带参数的函数
greet("Alice")

// 多个参数函数
func add(a, b) -> {
    return a + b
}

// 调用带多个参数的函数
result <- add(10, 20)

// 3. 带返回值的函数（根据EBNF，返回值类型声明可能在变量声明中，而非函数定义中）

// 返回整数
func multiply(a, b) -> {
    return a * b
}

// 变量声明中指定类型
multiply_result:int <- multiply(10, 20)

// 返回浮点数
func divide(a, b) -> {
    return a / b
}

divide_result:double <- divide(10.0, 2.0)

// 返回布尔值
func is_even(n) -> {
    return n % 2 == 0
}

even_result:bool <- is_even(4)

// 返回字符串
func concat(s1, s2) -> {
    return s1 + s2
}

concat_result:string <- concat("Hello", " World")

// 4. 递归函数

// 阶乘函数
func factorial(n) -> {
    if n == 0 {
        return 1
    }
    return n * factorial(n - 1)
}

fact_result:int <- factorial(5)

// 斐波那契数列
func fibonacci(n) -> {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fib_result:int <- fibonacci(10)

// 5. 嵌套函数

// 外部函数
func outer_function(x) -> {
    // 内部函数
    func inner_function(y) -> {
        return y * 2
    }
    return inner_function(x) + 1
}

// 调用嵌套函数
nested_result:int <- outer_function(5)

