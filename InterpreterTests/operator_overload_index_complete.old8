// 测试索引运算符重载功能 - 完整测试
// 实现一个自定义的 SparseArray 类，支持索引访问和赋值

class SparseArray {
    private data

    init() {
        this.data <- {"dummy": 0}  // 创建字典
    }

    // 索引获取：arr[index]
    _getitem(index) {
        key <- index.ToStr()
        return this.data[key]
    }

    // 索引设置：arr[index] <- value
    _setitem(index, value) {
        key <- index.ToStr()
        this.data[key] <- value
    }
}

// 测试索引设置和获取
PrintLine("=== 测试索引设置和获取 ===")
arr <- SparseArray()

// 使用索引语法设置值
arr[0] <- 10
arr[5] <- 50
arr[10] <- 100

// 使用索引语法获取值
val1 <- arr[0]
PrintLine("arr[0] = " + val1.ToStr())

val2 <- arr[5]
PrintLine("arr[5] = " + val2.ToStr())

val3 <- arr[10]
PrintLine("arr[10] = " + val3.ToStr())

// 测试修改已存在的值
PrintLine("=== 测试修改已存在的值 ===")
arr[0] <- 20
val4 <- arr[0]
PrintLine("修改后 arr[0] = " + val4.ToStr())

// 测试链式操作
PrintLine("=== 测试链式操作 ===")
arr[100] <- arr[0] + arr[5]
val5 <- arr[100]
PrintLine("arr[100] = arr[0] + arr[5] = " + val5.ToStr())

PrintLine("=== 所有测试通过 ===")
