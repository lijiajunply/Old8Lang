// 简单嵌套测试 - 编译模式
// 只测试嵌套的if语句和break/continue语句

PrintLine("=== 简单嵌套测试 ===")

// 测试嵌套的if语句
x:int <- 10
PrintLine("x = " + x)

if x > 5 {
    PrintLine("外层if: x > 5")
    if x > 8 {
        PrintLine("内层if: x > 8")
        if x > 15 {
            PrintLine("最内层if: x > 15")
        } else {
            PrintLine("最内层else: x <= 15")
        }
    } else {
        PrintLine("内层else: x <= 8")
    }
}

// 测试break和continue语句
PrintLine("\n测试break和continue语句:")
for i:int <- 0, i < 5, i++ {
    if i == 2 {
        PrintLine("跳过 i = " + i)
        continue
    }
    if i == 4 {
        PrintLine("提前退出循环，i = " + i)
        break
    }
    PrintLine("i = " + i)
}
