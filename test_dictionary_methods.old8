// 测试 Dictionary 方法

// 创建字典
dict <- {"name": "Alice", "age": 30, "city": "Beijing"}

// 测试 Count
PrintLine("Count: " + dict.Count().ToStr())

// 测试 Keys
keys <- dict.Keys()
PrintLine("Keys: " + keys.ToStr())

// 测试 Values
values <- dict.Values()
PrintLine("Values: " + values.ToStr())

// 测试 Get
name <- dict.Get("name")
PrintLine("Get 'name': " + name)

age <- dict.Get("age")
PrintLine("Get 'age': " + age.ToStr())

// 测试 ContainsKey
PrintLine("ContainsKey 'name': " + dict.ContainsKey("name").ToStr())
PrintLine("ContainsKey 'email': " + dict.ContainsKey("email").ToStr())

// 测试 Set
dict.Set("email", "alice@example.com")
PrintLine("After Set 'email': " + dict.ToStr())

// 更新现有键
dict.Set("age", 31)
PrintLine("After Set 'age' to 31: " + dict.ToStr())

// 测试 Remove
removed <- dict.Remove("city")
PrintLine("Remove 'city': " + removed.ToStr())
PrintLine("After Remove: " + dict.ToStr())

// 尝试移除不存在的键
removed2 <- dict.Remove("nonexistent")
PrintLine("Remove 'nonexistent': " + removed2.ToStr())

// 测试 Clear
dict2 <- {"a": 1, "b": 2, "c": 3}
PrintLine("Before Clear: " + dict2.ToStr())
dict2.Clear()
PrintLine("After Clear count: " + dict2.Count().ToStr())

// 测试空字典 - 使用已清空的字典
PrintLine("Empty dict Count: " + dict2.Count().ToStr())
PrintLine("Empty dict Keys: " + dict2.Keys().ToStr())
PrintLine("Empty dict Values: " + dict2.Values().ToStr())

// 测试 Get 不存在的键（应返回 null）
result <- dict2.Get("missing")
PrintLine("Get missing key: " + result.ToStr())
