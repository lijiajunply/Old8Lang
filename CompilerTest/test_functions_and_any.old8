// 测试函数和AnyValue类型

// 定义一个简单函数
func add(a, b) {
    return a + b
}

// 调用函数
result <- add(10, 20)
PrintLine(result)  // 应该输出 30

// 定义一个带有多个返回语句的函数
func max(a, b) {
    if a > b {
        return a
    } else {
        return b
    }
}

// 调用函数
max_result <- max(30, 20)
PrintLine(max_result)  // 应该输出 30

// AnyValue类型测试
person <- {
    "name": "张三",
    "age": 30,
    "city": "北京"
}

PrintLine(person)  // 应该输出 {"name": "张三", "age": 30, "city": "北京"}

// 访问AnyValue属性
person_name <- person.name
PrintLine(person_name)  // 应该输出 "张三"

// TypeValue类型测试
type <- Type(person)
PrintLine(type)  // 应该输出 "Any"
