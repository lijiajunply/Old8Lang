// Task Then 方法测试 - 调试版

print("=== Task Then 方法测试 ===\n")

// 先定义回调函数
func callback(result) {
    print("回调收到结果: ")
    print(result)
    print("\n")
    return result * 2
}

print("callback 函数已定义\n")

async func asyncFunc() {
    return 10
}

print("asyncFunc 函数已定义\n")

task1 <- asyncFunc()
print("task1 创建完成\n")

// 测试 Then 方法
print("准备调用 task1.Then(callback)\n")
task2 <- task1.Then(callback)
print("task2 创建完成\n")

result <- task2.Await()
print("最终结果 = ")
print(result)
print("\n")

print("\n=== 测试完成 ===\n")
