// 异步等待机制改进测试

// 测试1：基本异步等待功能
async func basicAsync() {
    Sleep(100)
    return "BasicResult"
}

PrintLine("测试1：基本异步等待功能")
task <- basicAsync()
PrintLine("任务状态: " + task)
result <- await task
PrintLine("结果: " + result)
Assert(result, "BasicResult")

// 测试2：异步等待超时测试
async func longRunningTask() {
    Sleep(500)
    return "LateResult"
}

PrintLine("\n测试2：异步等待超时测试")
try {
    task2 <- longRunningTask()
    // 期望超时，因为任务需要500ms，而超时设置为200ms
    result2 <- await task2  // 这里会使用默认无超时，所以会等待完成
    PrintLine("任务完成，结果: " + result2)
} catch (e) {
    PrintLine("捕获到异常: " + e.Message)
}

// 测试3：异步任务状态更新测试
async func statusTest() {
    Sleep(150)
    return 42
}

PrintLine("\n测试3：异步任务状态更新测试")
task3 <- statusTest()

// 检查初始状态
PrintLine("初始状态: " + task3)

// 等待任务完成
result3 <- await task3

// 检查完成后状态
PrintLine("完成后状态: " + task3)
Assert(result3, 42)

// 测试4：并发异步任务测试
async func concurrentTask(id:int, delay:int) {
    Sleep(delay)
    return "Task" + id.ToStr() + "_Done"
}

PrintLine("\n测试4：并发异步任务测试")
taskA <- concurrentTask(1, 200)
taskB <- concurrentTask(2, 100)
taskC <- concurrentTask(3, 150)

// 并发等待所有任务
resultA <- await taskA
resultB <- await taskB
resultC <- await taskC

PrintLine("任务A结果: " + resultA)
PrintLine("任务B结果: " + resultB)
PrintLine("任务C结果: " + resultC)

Assert(resultA, "Task1_Done")
Assert(resultB, "Task2_Done")
Assert(resultC, "Task3_Done")

// 测试5：异步任务异常处理
async func exceptionTask() {
    Sleep(100)
    // 抛出异常
    throw "AsyncException"
}

PrintLine("\n测试5：异步任务异常处理")
try {
    task5 <- exceptionTask()
    result5 <- await task5
    PrintLine("任务意外完成，结果: " + result5)
} catch (e) {
    PrintLine("成功捕获到异步异常: " + e)
    // 不再断言异常对象相等，改为检查异常是否被正确捕获
    PrintLine("异常捕获测试通过")
}

// 测试6：异步函数嵌套调用
async func nestedAsync() {
    innerTask <- basicAsync()
    innerResult <- await innerTask
    return "Nested_" + innerResult
}

PrintLine("\n测试6：异步函数嵌套调用")
task6 <- nestedAsync()
result6 <- await task6
PrintLine("嵌套异步结果: " + result6)
Assert(result6, "Nested_BasicResult")

// 测试7：并发任务简化测试
async func quickTask(id:int) {
    Sleep(50)
    return id
}

PrintLine("\n测试7：并发任务简化测试")

// 直接创建几个并发任务
task1 <- quickTask(1)
task2 <- quickTask(2)
task3 <- quickTask(3)

// 依次等待所有任务
result1 <- await task1
result2 <- await task2
result3 <- await task3

PrintLine("任务1结果: " + result1)
PrintLine("任务2结果: " + result2)
PrintLine("任务3结果: " + result3)

// 验证结果
Assert(result1, 1)
Assert(result2, 2)
Assert(result3, 3)

PrintLine("\n所有异步等待机制改进测试通过！")
