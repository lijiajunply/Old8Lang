// 异常处理测试

// 基本 try-catch 测试
PrintLine("=== 基本 try-catch 测试 ===")

try {
    result <- 10 / 0
    PrintLine("不会执行到这里")
catch (e) {
    PrintLine("捕获到异常: " + e)
}

// try-catch-finally 测试
PrintLine("\n=== try-catch-finally 测试 ===")

try {
    result <- 10 / 0
    PrintLine("不会执行到这里")
catch (e) {
    PrintLine("捕获到异常: " + e)
} finally {
    PrintLine("finally 块总是执行")
}

// 正常执行时 finally 块也会执行
PrintLine("\n=== 正常执行时 finally 块测试 ===")

try {
    result <- 10 / 2
    PrintLine("正常执行: 10 / 2 = " + result)
catch (e) {
    PrintLine("捕获到异常: " + e)
} finally {
    PrintLine("finally 块总是执行")
}

// 自定义异常测试
PrintLine("\n=== 自定义异常测试 ===")

class MyException {
    message:string <- ""
    
    func MyException(message:string) -> {
        this.message <- message
    }
    
    func toString() -> {
        return "MyException: " + message
    }
}

func throw_custom_exception() -> {
    throw MyException("这是一个自定义异常")
}

try {
    throw_custom_exception()
    PrintLine("不会执行到这里")
catch (e) {
    PrintLine("捕获到自定义异常: " + e)
}

// 嵌套 try-catch 测试
PrintLine("\n=== 嵌套 try-catch 测试 ===")

try {
    PrintLine("外层 try 开始")
    
    try {
        PrintLine("内层 try 开始")
        result <- 10 / 0
        PrintLine("内层 try 结束")
    } catch (e) {
        PrintLine("内层 catch: " + e)
        // 重新抛出异常
        throw e
    } finally {
        PrintLine("内层 finally 执行")
    }
    
    PrintLine("外层 try 结束")
catch (e) {
    PrintLine("外层 catch: " + e)
} finally {
    PrintLine("外层 finally 执行")
}

// 不同类型异常的捕获
PrintLine("\n=== 不同类型异常的捕获测试 ===")

try {
    // 测试数组越界异常
    arr <- [1, 2, 3]
    PrintLine(arr[5])
catch (e) {
    PrintLine("捕获到数组越界异常: " + e)
}

try {
    // 测试类型转换异常
    str <- "abc"
    num <- str as int
    PrintLine(num)
catch (e) {
    PrintLine("捕获到类型转换异常: " + e)
}

try {
    // 测试空引用异常
    obj <- null
    PrintLine(obj.name)
catch (e) {
    PrintLine("捕获到空引用异常: " + e)
}

// 异常传播测试
PrintLine("\n=== 异常传播测试 ===")

func func1() -> {
    PrintLine("func1 开始")
    func2()
    PrintLine("func1 结束")
}

func func2() -> {
    PrintLine("func2 开始")
    func3()
    PrintLine("func2 结束")
}

func func3() -> {
    PrintLine("func3 开始")
    result <- 10 / 0
    PrintLine("func3 结束")
}

try {
    func1()
catch (e) {
    PrintLine("捕获到异常: " + e)
}

// try-finally 无 catch 测试
PrintLine("\n=== try-finally 无 catch 测试 ===")

try {
    PrintLine("try 块开始")
    result <- 10 / 0
    PrintLine("try 块结束")
} finally {
    PrintLine("finally 块执行")
}

// 注意：上面的代码会抛出未捕获的异常，导致程序终止
// 下面的代码不会执行
PrintLine("这段代码不会执行")