// 测试this关键字

PrintLine("=== this关键字测试 ===")

// 定义一个简单的类
class Person {
    name <- ""
    age <- 0
    
    func init(name, age) {
        this.name <- name
        this.age <- age
    }
    
    func sayHello() {
        PrintLine("Hello, my name is " + this.name)
    }
    
    func getAge() {
        return this.age
    }
    
    func updateAge(newAge) {
        this.age <- newAge
    }
}

// 实例化类
person <- Person("Bob", 25)
PrintLine("person对象: " + person)

// 访问成员变量
personName <- person.name
PrintLine("person.name = " + personName)

personAge <- person.age
PrintLine("person.age = " + personAge)

// 修改成员变量
person.name <- "Charlie"
PrintLine("修改后 person.name = " + person.name)

// 调用成员方法
PrintLine("调用 person.sayHello():")
person.sayHello()

// 测试this关键字访问属性
PrintLine("调用 person.getAge(): " + person.getAge())

// 测试this关键字修改属性
person.updateAge(30)
PrintLine("修改后 person.age = " + person.age)
PrintLine("调用 person.getAge(): " + person.getAge())

PrintLine("\n✅ 所有this关键字测试完成")