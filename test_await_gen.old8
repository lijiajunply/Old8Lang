// 测试带 await 的异步生成器

import Async

PrintLine("=== 测试带 await 的异步生成器 ===")

async func delayedGen() {
    PrintLine("开始执行 delayedGen")
    i <- 1
    PrintLine("设置 i = 1")

    while i <= 3 {
        PrintLine("进入循环, i = " + i.ToStr())
        await Task.Delay(10)
        PrintLine("await 完成, i = " + i.ToStr())
        yield i
        PrintLine("yield 完成, i = " + i.ToStr())
        i <- i + 1
        PrintLine("递增后, i = " + i.ToStr())
    }

    PrintLine("退出循环")
}

stream <- delayedGen()
count <- 0

async for item in stream {
    count <- count + 1
    PrintLine("收到 item: " + item.ToStr() + ", count = " + count.ToStr())
    if count >= 5 {
        PrintLine("强制退出，防止死循环")
        break
    }
}

PrintLine("测试完成")
