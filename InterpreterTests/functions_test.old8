// 函数测试

// 基本函数声明和调用
PrintLine("=== 基本函数声明和调用测试 ===")

func add(a:int, b:int) -> {
    return a + b
}

result <- add(1, 2)
PrintLine("add(1, 2) = " + result)

// 无参数函数
PrintLine("\n=== 无参数函数测试 ===")

func sayHello() -> {
    return "Hello, World!"
}

message <- sayHello()
PrintLine(message)

// 多返回值函数（使用元组）
PrintLine("\n=== 多返回值函数测试 ===")

func getMinMax(numbers:array) -> {
    if numbers is empty {
        return (0, 0)
    }
    
    min <- numbers[0]
    max <- numbers[0]
    
    for num in numbers {
        if num < min {
            min <- num
        }
        if num > max {
            max <- num
        }
    }
    
    return (min, max)
}

minmax <- getMinMax([5, 2, 9, 1, 7])
PrintLine("最小值: " + minmax[0])
PrintLine("最大值: " + minmax[1])

// 带有默认参数的函数
PrintLine("\n=== 带有默认参数的函数测试 ===")

func greet(name:string, greeting:string <- "Hello") -> {
    return greeting + ", " + name + "!"
}

PrintLine(greet("Alice"))
PrintLine(greet("Bob", "Hi"))

// 递归函数
PrintLine("\n=== 递归函数测试 ===")

func factorial(n:int) -> {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

PrintLine("factorial(5) = " + factorial(5))

// 函数作为参数
PrintLine("\n=== 函数作为参数测试 ===")

func applyOperation(a:int, b:int, operation:function) -> {
    return operation(a, b)
}

func multiply(x:int, y:int) -> {
    return x * y
}

result <- applyOperation(3, 4, multiply)
PrintLine("3 * 4 = " + result)

// 嵌套函数
PrintLine("\n=== 嵌套函数测试 ===")

func outerFunc(x:int) -> {
    func innerFunc(y:int) -> {
        return x + y
    }
    
    return innerFunc(5)
}

result <- outerFunc(10)
PrintLine("outerFunc(10) = " + result)

// 可变参数函数
PrintLine("\n=== 可变参数函数测试 ===")

func sum(...numbers) -> {
    total <- 0
    for num in numbers {
        total <- total + num
    }
    return total
}

PrintLine("sum(1, 2, 3) = " + sum(1, 2, 3))
PrintLine("sum(4, 5, 6, 7) = " + sum(4, 5, 6, 7))

// 带有类型注解的函数
PrintLine("\n=== 带有类型注解的函数测试 ===")

func divide(a:double, b:double) -> double {
    if b == 0 {
        return 0.0
    }
    return a / b
}

result <- divide(10.0, 2.0)
PrintLine("divide(10.0, 2.0) = " + result)

// 高阶函数
PrintLine("\n=== 高阶函数测试 ===")

func createMultiplier(factor:int) -> function {
    func multiplier(x:int) -> {
        return x * factor
    }
    return multiplier
}

double <- createMultiplier(2)
triple <- createMultiplier(3)

PrintLine("double(5) = " + double(5))
PrintLine("triple(5) = " + triple(5))