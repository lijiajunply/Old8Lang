// 异常处理和特殊语法测试 - 编译模式
// 测试异常处理和各种特殊语法，使用类型假注

PrintLine("=== 异常处理和特殊语法测试 ===")

// 异常处理 - try-catch-finally
PrintLine("\n1. try-catch-finally 测试:")
try {
    PrintLine("尝试执行可能出错的代码")
    result:double <- 10.0 / 0.0
    PrintLine("结果: " + result)
} catch (e) {
    PrintLine("捕获到异常: " + e)
} finally {
    PrintLine("无论是否异常，都会执行这里")
}

// 主动抛出异常
PrintLine("\n2. throw 语句测试:")
func checkPositive(number:int) {
    if number <= 0 {
        throw "数字必须为正数"
    }
}

try {
    checkPositive(-5)
} catch (e) {
    PrintLine("捕获到异常: " + e)
}

// 字符串模板
PrintLine("\n3. 字符串模板测试:")
name:string <- "Bob"
age:int <- 25
message <- $"My name is {name}, I'm {age} years old."
PrintLine(message)

// 字符串模板中嵌入表达式
PrintLine("\n4. 字符串模板嵌入表达式:")
x:int <- 10
y:int <- 20
exprMessage <- $"{x} + {y} = {x + y}"
PrintLine(exprMessage)

// 字符串模板转义
PrintLine("\n5. 字符串模板转义测试:")
escapedMessage <- $"使用双大括号 \{{}} 来转义"
PrintLine(escapedMessage)

// 列表推导式
PrintLine("\n6. 列表推导式测试:")
numbers:array <- [1, 2, 3, 4, 5]
squares <- [x * x for x in numbers]

PrintLine("原始数组: " + numbers)
PrintLine("平方列表: " + squares)

// 列表推导式带条件
PrintLine("\n7. 带条件的列表推导式:")
evens <- [x for x in numbers if x % 2 == 0]
PrintLine("偶数列表: " + evens)

// 列表初始化
PrintLine("\n8. 列表初始化测试:")
myList <- list[1, 2, 3, 4, 5]
PrintLine("列表元素: " + myList)

// 范围表达式
PrintLine("\n9. 范围表达式测试:")
range1 <- [1~5]
for i in range1 {
    PrintLine("范围元素: " + i)
}

