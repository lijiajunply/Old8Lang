// 基本语法测试文件

// 测试标识符
validIdentifier1 <- 1
valid_identifier2 <- 2
_validIdentifier3 <- 3
ValidIdentifier4 <- 4

// 测试关键字（这里只测试关键字作为变量名的情况，应该会报错，但语法上应该能解析）
// if <- 1  // 关键字不能作为标识符

// 测试字面量

// 整数字面量
intLiteral1 <- 123
intLiteral2 <- -456
intLiteral3 <- 0

// 浮点数字面量
doubleLiteral1 <- 3.14
doubleLiteral2 <- -0.5
doubleLiteral3 <- 1.0
doubleLiteral4 <- 1e3
doubleLiteral5 <- 1e-3

// 字符串字面量
stringLiteral1 <- "hello world"
stringLiteral2 <- ""
stringLiteral3 <- "a"
stringLiteral4 <- "123"

// 字符字面量
charLiteral1 <- 'a'
charLiteral2 <- '1'
charLiteral3 <- '\n'
charLiteral4 <- '\\'

// 布尔字面量
boolLiteral1 <- true
boolLiteral2 <- false

// 测试基本数据类型
intVar:int <- 123
doubleVar:double <- 3.14
stringVar:string <- "hello"
boolVar:bool <- true
charVar:char <- 'a'

// 测试复合数据类型

// 数组
arrayVar <- [1, 2, 3, 4, 5]
arrayVar2 <- ["a", "b", "c"]
arrayVar3 <- [true, false, true]

// 列表
listVar <- list[1, 2, 3]
listVar2 <- list["a", "b", "c"]

// 字典
dictVar <- {"name": "Alice", "age": 30}
dictVar2 <- {1: "one", 2: "two"}

// 元组
tupleVar <- (1, "a", true)
tupleVar2 <- ("hello", 3.14)

// 范围
rangeVar <- [1~10]
rangeVar2 <- [0~5]