// 测试多种修饰符的类成员声明
class A {
    // 静态公共字段
    static public staticPublic <- 1
    // 静态私有字段
    static private staticPrivate <- 2
    // 公共实例字段
    public publicField <- 3
    // 私有实例字段
    private privateField <- 4
    
    // 静态公共方法
    static public func staticPublicMethod() {
        return A.staticPublic + A.staticPrivate
    }
    
    // 静态私有方法
    static private func staticPrivateMethod() {
        return A.staticPublic * A.staticPrivate
    }
    
    // 公共实例方法
    public func getPublicField() {
        return this.publicField
    }
    
    // 公共方法访问私有字段
    public func getPrivateField() {
        return this.privateField
    }
    
    // 静态方法访问静态私有字段
    static public func getStaticPrivate() {
        return A.staticPrivate
    }
    
    // 静态方法调用静态私有方法
    static public func callStaticPrivateMethod() {
        return A.staticPrivateMethod()
    }
}

// 测试静态公共字段访问
PrintLine(A.staticPublic) // 预期输出: 1

// 测试静态公共方法调用
PrintLine(A.staticPublicMethod()) // 预期输出: 3

// 测试静态方法访问静态私有字段
PrintLine(A.getStaticPrivate()) // 预期输出: 2

// 测试静态方法调用静态私有方法
PrintLine(A.callStaticPrivateMethod()) // 预期输出: 2

// 创建实例
obj = A()

// 测试公共字段访问
PrintLine(obj.publicField) // 预期输出: 3

// 测试公共方法调用
PrintLine(obj.getPublicField()) // 预期输出: 3

// 测试公共方法访问私有字段
PrintLine(obj.getPrivateField()) // 预期输出: 4
