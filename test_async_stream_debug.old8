// 简单的异步流测试
PrintLine("Creating async stream...")
stream <- async {
    PrintLine("In async stream, about to start loop")
    for i in [1~3] {
        PrintLine("Yielding: " + i.ToStr())
        yield i
    }
    PrintLine("Loop finished")
}

PrintLine("Stream created, type: " + stream.ToStr())
PrintLine("Starting iteration...")

for item in stream {
    PrintLine("Got item: " + item.ToStr())
}

PrintLine("Done")
