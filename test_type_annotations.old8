// 类型假注和多态家族测试

// 基本形状类
class Shape {
    public area:double
    func init() {
        this.area <- 0.0
    }

    func GetArea() -> double {
        return this.area
    }

    func Draw() -> void {
        PrintLine("Drawing a shape")
    }
}

// 圆形类，继承自Shape
class Circle extends Shape {
    public radius:double
    func init(r:double) {
        this.radius <- r
        this.area <- 3.14159 * r * r
    }

    func Draw() -> void {
        PrintLine("Drawing a circle with radius " + this.radius)
    }
}

// 矩形类，继承自Shape
class Rectangle extends Shape {
    public width:double
    public height:double
    func init(w:double, h:double) {
        this.width <- w
        this.height <- h
        this.area <- w * h
    }

    func Draw() -> void {
        PrintLine("Drawing a rectangle " + this.width + "x" + this.height)
    }
}

// 类型假注测试函数
func TestPolymorphism() -> void {
    PrintLine("=== 类型假注和多态测试 ===")

    // 创建不同类型的形状
    shape1:Shape <- Circle(5.0)      // 类型假注：Circle可以赋值给Shape
    shape2:Shape <- Rectangle(10.0, 20.0)  // 类型假注：Rectangle可以赋值给Shape
    shape3:Shape <- Shape()        // 类型假注：直接创建Shape实例

    // 多态调用
    PrintLine("Shape 1:")
    shape1.Draw()
    PrintLine("Area: " + shape1.GetArea())

    PrintLine("Shape 2:")
    shape2.Draw()
    PrintLine("Area: " + shape2.GetArea())

    PrintLine("Shape 3:")
    shape3.Draw()
    PrintLine("Area: " + shape3.GetArea())
}

// 类型安全测试
func TestTypeSafety() -> void {
    PrintLine("\n=== 类型安全测试 ===")

    // 类型假注变量
    animal:string <- "Dog"  // 类型假注：animal是string类型
    number:int <- 42        // 类型假注：number是int类型
    flag:bool <- true       // 类型假注：flag是bool类型

    PrintLine("Animal: " + animal)
    PrintLine("Number: " + number)
    PrintLine("Flag: " + flag)

    // 多态赋值测试
    pet:Shape <- Circle(3.0)  // 圆形可以赋值给Shape类型（多态）
    pet.Draw()
}

// 函数参数类型假注
func ProcessShape(shape:Shape) -> void {
    PrintLine("Processing shape:")
    shape.Draw()
    PrintLine("Calculated area: " + shape.GetArea())
}

// 测试函数参数类型假注
func TestFunctionTypeAnnotations() -> void {
    PrintLine("\n=== 函数参数类型假注测试 ===")

    circle:Circle <- Circle(7.5)
    rectangle:Rectangle <- Rectangle(15.0, 25.0)

    // 多态传递
    ProcessShape(circle)     // Circle可以传递给Shape参数
    ProcessShape(rectangle)  // Rectangle可以传递给Shape参数
}

// 运行所有测试
func main() -> void {
    TestPolymorphism()
    TestTypeSafety()
    TestFunctionTypeAnnotations()

    PrintLine("\n=== 类型假注测试完成 ===")
}