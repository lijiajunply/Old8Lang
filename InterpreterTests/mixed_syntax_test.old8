// 混合语法测试 - 学生成绩管理系统

PrintLine("=== 学生成绩管理系统 ===")

// 定义学生类
class Student {
    name:string <- ""
    id:int <- 0
    grades:list <- list[]
    
    func Student(name:string, id:int) -> {
        this.name <- name
        this.id <- id
    }
    
    func addGrade(grade:double) -> {
        grades += grade
    }
    
    func getAverage() -> double {
        if grades.length == 0 {
            return 0.0
        }
        
        total <- 0.0
        for grade in grades {
            total <- total + grade
        }
        
        return total / grades.length
    }
    
    func getLetterGrade() -> string {
        avg <- this.getAverage()
        if avg >= 90 {
            return "A"
        } elif avg >= 80 {
            return "B"
        } elif avg >= 70 {
            return "C"
        } elif avg >= 60 {
            return "D"
        } else {
            return "F"
        }
    }
    
    func toString() -> string {
        return $("Student: {name} (ID: {id}), Average: {getAverage():.2f}, Grade: {getLetterGrade()}")
    }
}

// 定义成绩管理类
class GradeManager {
    students:list <- list[]
    
    func addStudent(student:Student) -> {
        students += student
    }
    
    func getStudentById(id:int) -> Student {
        for student in students {
            if student.id == id {
                return student
            }
        }
        return null
    }
    
    func getAllStudents() -> list {
        return students
    }
    
    func getTopStudents(minGrade:double) -> list {
        return [student for student in students if student.getAverage() >= minGrade]
    }
    
    func printStudentReport(student:Student) -> {
        PrintLine(student.toString())
        PrintLine("Grades: " + student.grades)
    }
    
    func printAllStudents() -> {
        PrintLine("\n=== 所有学生成绩报告 ===")
        for student in students {
            this.printStudentReport(student)
            PrintLine("-")
        }
    }
}

// 创建成绩管理器实例
manager <- GradeManager()

// 添加学生
try {
    // 使用Lambda表达式创建学生并添加到管理器
    addStudent <- (name, id) -> {
        student <- Student(name, id)
        manager.addStudent(student)
        return student
    }
    
    // 添加学生
    alice <- addStudent("Alice", 101)
    bob <- addStudent("Bob", 102)
    charlie <- addStudent("Charlie", 103)
    
    // 添加成绩
    alice.addGrade(95.5)
    alice.addGrade(88.0)
    alice.addGrade(92.5)
    
    bob.addGrade(75.0)
    bob.addGrade(82.5)
    bob.addGrade(78.0)
    
    charlie.addGrade(65.5)
    charlie.addGrade(70.0)
    charlie.addGrade(68.5)
    
    // 测试异常处理
    invalidStudent <- Student(null, -1)
    invalidStudent.addGrade(100.0)
    
catch (e) {
    PrintLine("捕获到异常: " + e)
}

// 打印所有学生报告
manager.printAllStudents()

// 使用列表推导式获取平均分高于85的学生
PrintLine("\n=== 平均分高于85的学生 ===")
topStudents <- manager.getTopStudents(85.0)
for student in topStudents {
    PrintLine(student.name + " - " + student.getAverage():.2f)
}

// 使用范围表达式和字符串模板
PrintLine("\n=== 成绩统计 ===")
totalStudents <- manager.students.length
averageAverages <- 0.0
for student in manager.students {
    averageAverages <- averageAverages + student.getAverage()
}
averageAverages <- averageAverages / totalStudents

PrintLine($"总学生数: {totalStudents}")
PrintLine($"所有学生平均平均分: {averageAverages:.2f}")

// 测试控制流和复杂表达式
PrintLine("\n=== 成绩分析 ===")
for i in [0~2] {
    student <- manager.students[i]
    avg <- student.getAverage()
    PrintLine($"{student.name}: {avg:.2f} - {avg >= 80 ? '优秀' : (avg >= 70 ? '良好' : (avg >= 60 ? '及格' : '不及格'))}")
}

// 测试函数作为参数
PrintLine("\n=== 使用函数作为参数 ===")

func processStudents(students:list, processor:function) -> {
    results <- list[]
    for student in students {
        results += processor(student)
    }
    return results
}

// 使用Lambda表达式处理学生数据
studentNames <- processStudents(manager.students, student -> student.name)
PrintLine("学生姓名列表: " + studentNames)

studentIds <- processStudents(manager.students, student -> student.id)
PrintLine("学生ID列表: " + studentIds)

// 测试类型转换和混合表达式
PrintLine("\n=== 类型转换和混合表达式 ===")
totalGrades <- 0
for student in manager.students {
    totalGrades <- totalGrades + student.grades.length
}

PrintLine($"总成绩记录数: {totalGrades}")
PrintLine($"平均每个学生的成绩记录数: {(totalGrades as double) / manager.students.length:.2f}")

// 测试字典和列表推导式
PrintLine("\n=== 字典和列表推导式 ===")

// 创建学生字典
studentDict <- {student.id: student for student in manager.students}
PrintLine("学生字典: " + studentDict)

// 使用字典推导式创建成绩映射
gradeMap <- {student.name: student.getLetterGrade() for student in manager.students}
PrintLine("学生成绩映射: " + gradeMap)

// 测试嵌套循环和条件
PrintLine("\n=== 嵌套循环和条件 ===")

PrintLine("成绩详情:")
for student in manager.students {
    PrintLine($"{student.name}:")
    for i, grade in enumerate(student.grades) {
        PrintLine($"  第{i+1}次成绩: {grade} - {grade >= 80 ? '优秀' : '一般'}")
    }
}

// 测试生成器表达式（如果支持）
PrintLine("\n=== 生成器表达式 ===")

gradeGenerator <- (grade for student in manager.students for grade in student.grades)
PrintLine("所有成绩: ")
for grade in gradeGenerator {
    PrintLine(grade)
}

// 测试最终报告
PrintLine("\n=== 最终报告 ===")

PrintLine($"=== 学生成绩管理系统报告 ===")
PrintLine($"生成时间: {DateTime.Now}")
PrintLine($"总学生数: {manager.students.length}")
PrintLine($"平均平均分: {averageAverages:.2f}")
PrintLine($"优秀学生数: {topStudents.length}")

PrintLine("\n=== 报告结束 ===")