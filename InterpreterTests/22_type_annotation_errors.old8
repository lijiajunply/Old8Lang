// 测试类型注解的错误使用场景
// 验证类型注解在不允许的场景中使用时会产生错误

PrintLine("=== 测试类型注解的错误使用场景 ===")

// 1. 变量引用中的类型注解 - 应该失败
PrintLine("\n1. 变量引用中的类型注解：")
a <- 123
PrintLine(a:int) // 错误：类型注解只能在赋值语句、函数参数和lambda参数中使用

// 2. 函数调用中的类型注解 - 应该失败
PrintLine("\n2. 函数调用中的类型注解：")
func testFunc(b, c) {
    return b
}
testFunc(456:int, "test":string) // 错误：类型注解只能在赋值语句、函数参数和lambda参数中使用
