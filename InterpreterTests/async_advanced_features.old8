// 测试高级异步功能

import Async
import Time

// 测试1: 任务组合方法 - WhenAll
PrintLine("=== 测试1: 任务组合方法 - WhenAll ===")

async func task1() {
    Sleep(200)
    return 1
}

async func task2() {
    Sleep(100)
    return 2
}

result1 <- await Task.WhenAll([task1(), task2()])

// 测试2: 任务组合方法 - WhenAny
PrintLine("\n=== 测试2: 任务组合方法 - WhenAny ===")

result2 <- await Task.WhenAny([task1(), task2()])
PrintLine("WhenAny 结果: " + result2)
// PrintLine("WhenAny 方法暂不可用(Task类未暴露)")

// 测试3: 任务组合方法 - Then
PrintLine("\n=== 测试3: 任务组合方法 - Then ===")

result3 <- await task1().Then((res) -> {
    PrintLine("前一个任务结果: " + res)
    return task2()
})
PrintLine("Then 结果: " + result3)
// PrintLine("Then 方法暂不可用")

// 测试4: 任务组合方法 - WithTimeout
PrintLine("\n=== 测试4: 任务组合方法 - WithTimeout ===")

try {
    // result4 <- await task1().WithTimeout(150)
    // PrintLine("WithTimeout 成功结果: " + result4)
    PrintLine("WithTimeout 方法暂不可用")
} catch (e) {
    PrintLine("WithTimeout 超时异常")
}

// 测试5: 任务组合方法 - Retry
PrintLine("\n=== 测试5: 任务组合方法 - Retry ===")

// 注意：由于异步函数的作用域隔离机制，每次重试都会使用独立的作用域副本
// 这确保了并发安全性和函数的纯度
// 因此我们使用基于时间的方式来测试重试功能

currentTime <- GetUnixTimeMilliseconds()

async func flakyTask() {
    now <- GetUnixTimeMilliseconds()
    elapsed <- now - currentTime

    // 前2秒内失败，之后成功
    if elapsed < 2000 {
        PrintLine("任务失败，需要重试 (已过 " + elapsed.ToStr() + "ms)")
        throw "任务失败，需要重试"
    }

    PrintLine("任务成功 (已过 " + elapsed.ToStr() + "ms)")
    return "重试成功"
}

result5 <- await flakyTask().Retry(5, 500)
PrintLine("Retry 结果: " + result5)
// PrintLine("Retry 方法暂不可用")

// 测试6: 任务取消机制
PrintLine("\n=== 测试6: 任务取消机制 ===")

// 测试创建取消令牌源
ctsId <- CreateCancellationTokenSource()
PrintLine("取消令牌源创建成功")
// PrintLine("取消令牌功能暂不可用")

// 测试延迟取消
Sleep(100)
CancelAfter(ctsId, 200)
PrintLine("已设置延迟取消")

Sleep(300)
PrintLine("取消已执行")

PrintLine("\n所有测试完成!")