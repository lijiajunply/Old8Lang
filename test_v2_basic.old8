// 测试 V2 架构的基本类功能

class Person {
    public name <- ""
    public age <- 0

    func init(n, a) {
        this.name <- n
        this.age <- a
    }

    public greet() {
        PrintLine("Hello, my name is " + this.name + " and I am " + this.age.ToStr() + " years old.")
    }

    public haveBirthday() {
        this.age <- this.age + 1
        PrintLine(this.name + " is now " + this.age.ToStr() + " years old!")
    }
}

// 创建实例
person <- Person("Alice", 25)
person.greet()
person.haveBirthday()
person.greet()
