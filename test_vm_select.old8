// 测试虚拟机模式下的 select 语句

// 测试1: 基本的 select 发送和接收
func test_basic_select() -> void {
    PrintLine("测试1: 基本的 select 发送和接收")

    ch <- ChannelCreate()

    // 发送数据
    select {
        case ch <- 100 -> {
            PrintLine("成功发送 100 到通道")
        }
        default -> {
            PrintLine("发送失败")
        }
    }

    // 接收数据
    select {
        case val from ch -> {
            PrintLine("成功接收: " + val.ToStr())
        }
        default -> {
            PrintLine("接收失败")
        }
    }

    ChannelClose(ch)
    PrintLine("测试1 完成\n")
}

// 测试2: 带 default 的 select
func test_select_with_default() -> void {
    PrintLine("测试2: 带 default 的 select")

    ch <- ChannelCreate()

    // 尝试从空通道接收（应该执行 default）
    select {
        case val from ch -> {
            PrintLine("接收到: " + val.ToStr())
        }
        default -> {
            PrintLine("通道为空，执行 default 分支")
        }
    }

    ChannelClose(ch)
    PrintLine("测试2 完成\n")
}

// 测试3: 多个 case 的 select
func test_multiple_cases() -> void {
    PrintLine("测试3: 多个 case 的 select")

    ch1 <- ChannelCreate()
    ch2 <- ChannelCreate()

    // 向 ch1 发送数据
    ChannelSend(ch1, 111)

    // select 应该从 ch1 接收
    select {
        case val from ch1 -> {
            PrintLine("从 ch1 接收到: " + val.ToStr())
        }
        case val from ch2 -> {
            PrintLine("从 ch2 接收到: " + val.ToStr())
        }
        default -> {
            PrintLine("没有通道就绪")
        }
    }

    ChannelClose(ch1)
    ChannelClose(ch2)
    PrintLine("测试3 完成\n")
}

// 主函数
test_basic_select()
test_select_with_default()
test_multiple_cases()

PrintLine("所有测试完成！")
