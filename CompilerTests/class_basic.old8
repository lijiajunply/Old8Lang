// 类基本结构测试

// 1. 基本类定义

class Person{
    name <- ""
    age <- 0
}

// 2. 类实例化

// 创建类的实例
p <- Person()

// 3. 访问类成员

// 设置字段值
p.name <- "Alice"
p.age <- 30

// 获取字段值
person_name <- p.name
person_age <- p.age

// 4. 带方法的类定义

class Calculator{
    // 方法定义（多行）
    func add(a, b)
    {
        return a + b
    }
    
    // 方法定义（单行）
    func multiply(a, b) return a * b
}

// 5. 类方法调用

calc <- Calculator()
sum_result <- calc.add(10, 20)
product_result <- calc.multiply(10, 20)

// 6. 带构造函数的类
class Student{
    name <- ""
    age <- 0
    
    func init(name, age)
    {
        this.name <- name
        this.age <- age
    }
}

// 使用构造函数创建实例
// student1 <- Student("Bob", 25)

// 7. 类的多个实例

// 创建多个类实例
p1 <- Person()
p1.name <- "Bob"
p1.age <- 25

p2 <- Person()
p2.name <- "Charlie"
p2.age <- 35

// 8. 类的嵌套使用

class Company{
    name <- ""
    ceo <- Person()
}

// 使用嵌套类
test_company <- Company()
test_company.name <- "Test Corp"
test_company.ceo.name <- "David"
test_company.ceo.age <- 45

// 9. 类方法中的this访问

class Counter{
    count <- 0
    
    func increment()
    {
        this.count <- this.count + 1
    }
    
    func get_count() return this.count
}

// 测试this访问
counter <- Counter()
counter.increment()
counter_value <- counter.get_count()
