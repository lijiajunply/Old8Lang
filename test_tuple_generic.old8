// Tuple 通用方法测试

print("=== Tuple 通用方法测试 ===\n")

// 1. 测试 Contains 方法
print("\n1. 测试 Contains 方法\n")

tuple1 <- (100, 200, 300)
print("tuple1 = ")
print(tuple1)
print("\n")

contains1 <- tuple1.Contains(200)
print("tuple1.Contains(200) = ")
print(contains1)
print("\n")

contains2 <- tuple1.Contains(999)
print("tuple1.Contains(999) = ")
print(contains2)
print("\n")

// 2. 测试 Reverse 方法
print("\n2. 测试 Reverse 方法\n")

reversed1 <- tuple1.Reverse()
print("tuple1.Reverse() = ")
print(reversed1)
print("\n")

// 3. 测试 Filter 方法
print("\n3. 测试 Filter 方法\n")

filtered1 <- tuple1.Filter((x) -> x >= 200)
print("tuple1.Filter(x >= 200) = ")
print(filtered1)
print("\n")

// 4. 测试 Map 方法
print("\n4. 测试 Map 方法\n")

mapped1 <- tuple1.Map((x) -> x / 100)
print("tuple1.Map(x / 100) = ")
print(mapped1)
print("\n")

// 5. 测试 Any 方法
print("\n5. 测试 Any 方法\n")

any1 <- tuple1.Any()
print("tuple1.Any() = ")
print(any1)
print("\n")

// 6. 测试 All 方法
print("\n6. 测试 All 方法\n")

all1 <- tuple1.All((x) -> x > 0)
print("tuple1.All(x > 0) = ")
print(all1)
print("\n")

all2 <- tuple1.All((x) -> x > 200)
print("tuple1.All(x > 200) = ")
print(all2)
print("\n")

// 7. 测试空元组
print("\n7. 测试单元素元组\n")

tuple2 <- (42,)
print("tuple2 = ")
print(tuple2)
print("\n")

contains3 <- tuple2.Contains(42)
print("tuple2.Contains(42) = ")
print(contains3)
print("\n")

any2 <- tuple2.Any()
print("tuple2.Any() = ")
print(any2)
print("\n")

print("\n=== 所有测试完成 ===\n")
