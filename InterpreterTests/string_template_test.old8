// 字符串模板测试

// 基本字符串模板
PrintLine("=== 基本字符串模板测试 ===")

simple_template <- $("Hello, World!")
PrintLine(simple_template)

// 带有变量的模板
PrintLine("\n=== 带有变量的模板测试 ===")

name <- "Alice"
age <- 30

name_template <- $("My name is {name}.")
PrintLine(name_template)

age_template <- $("I'm {age} years old.")
PrintLine(age_template)

// 带有多个变量的模板
PrintLine("\n=== 带有多个变量的模板测试 ===")

full_template <- $("My name is {name} and I'm {age} years old.")
PrintLine(full_template)

// 带有表达式的模板
PrintLine("\n=== 带有表达式的模板测试 ===")

x <- 5
y <- 10

expr_template <- $("5 + 10 = {x + y}")
PrintLine(expr_template)

complex_expr_template <- $("(5 + 10) * 2 = {(x + y) * 2}")
PrintLine(complex_expr_template)

// 带有逻辑表达式的模板
PrintLine("\n=== 带有逻辑表达式的模板测试 ===")

is_adult <- age >= 18
adult_template <- $("I'm {is_adult ? 'an adult' : 'a minor'}.")
PrintLine(adult_template)

// 转义大括号测试
PrintLine("\n=== 转义大括号测试 ===")

escaped_brace_template <- $("This is a {{curly brace}}.")
PrintLine(escaped_brace_template)

double_escaped_template <- $("This is {{}} double curly braces.")
PrintLine(double_escaped_template)

// 混合使用普通文本和模板
PrintLine("\n=== 混合使用普通文本和模板测试 ===")

mixed_template <- $("Hello, {name}!\n" +
                   "Today is a {age >= 30 ? 'great' : 'good'} day.\n" +
                   "This is a {{template}} example.")
PrintLine(mixed_template)

// 模板中的函数调用
PrintLine("\n=== 模板中的函数调用测试 ===")

func greet(name:string) -> {
    return "Hello, " + name + "!"
}

func_template <- $("Greeting: {greet(name)}")
PrintLine(func_template)

// 模板中的数组和列表
PrintLine("\n=== 模板中的数组和列表测试 ===")

numbers <- [1, 2, 3, 4, 5]
array_template <- $("Array: [{numbers}]")
PrintLine(array_template)

list_data <- list["apple", "banana", "cherry"]
list_template <- $("List: [{list_data}]")
PrintLine(list_template)

// 模板中的字典
PrintLine("\n=== 模板中的字典测试 ===")

person <- {"name": "Bob", "age": 25, "city": "New York"}
dict_template <- $("Person: {person}")
PrintLine(dict_template)

dict_field_template <- $("Name: {person.name}, City: {person.city}")
PrintLine(dict_field_template)

// 模板中的类实例
PrintLine("\n=== 模板中的类实例测试 ===")

class Person {
    name:string <- ""
    age:int <- 0
    
    func Person(name:string, age:int) -> {
        this.name <- name
        this.age <- age
    }
    
    func toString() -> {
        return "Person({name}, {age})"
    }
}

person_obj <- Person("Charlie", 35)
class_template <- $("Class instance: {person_obj}")
PrintLine(class_template)

class_field_template <- $("Person name: {person_obj.name}, age: {person_obj.age}")
PrintLine(class_field_template)

// 空模板测试
PrintLine("\n=== 空模板测试 ===")

empty_template <- $()
PrintLine("Empty template length: " + empty_template.length)

// 带有特殊字符的模板
PrintLine("\n=== 带有特殊字符的模板测试 ===")

special_chars_template <- $("Special chars: \n\t\"'\\")
PrintLine(special_chars_template)

// 动态模板内容
PrintLine("\n=== 动态模板内容测试 ===")

for i <- 0, i < 3, i++ {
    dynamic_template <- $("Iteration {i}: {i * 2}")
    PrintLine(dynamic_template)
}

// 模板中的类型转换
PrintLine("\n=== 模板中的类型转换测试 ===")

num <- 42
str_num <- num as string

type_conversion_template <- $("Number: {num}, String: {str_num}, Type: {typeof(num)}")
PrintLine(type_conversion_template)