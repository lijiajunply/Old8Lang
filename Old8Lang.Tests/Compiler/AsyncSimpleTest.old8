// 简单异步测试

// 测试1: 基本异步函数
async func basic_async() -> int {
    return 42
}

// 测试2: 带参数的异步函数
async func async_add(a: int, b: int) -> int {
    return a + b
}

// 测试3: 异步函数中的await
async func async_with_await() -> int {
    task <- Task.Delay(10)
    await task
    return 100
}

// 主函数
func main() {
    PrintLine("=== 开始简单异步测试 ===")
    
    // 测试1
    PrintLine("\n1. 测试基本异步函数:")
    result <- await basic_async()
    PrintLine("   结果: " + result.ToStr())
    
    // 测试2
    PrintLine("\n2. 测试带参数的异步函数:")
    result <- await async_add(5, 7)
    PrintLine("   5 + 7 = " + result.ToStr())
    
    // 测试3
    PrintLine("\n3. 测试异步函数中的await:")
    result <- await async_with_await()
    PrintLine("   结果: " + result.ToStr())
    
    PrintLine("\n=== 简单异步测试完成 ===")
}