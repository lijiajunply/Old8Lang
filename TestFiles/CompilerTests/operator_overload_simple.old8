// 编译器模式运算符重载测试 - 简化版

class Number {
    public value

    func init(v) {
        this.value <- v
    }

    func _add(other) -> int {
        return this.value + other.value
    }

    func _sub(other) -> int {
        return this.value - other.value
    }

    func _mul(other:int) -> int {
        return this.value * other
    }

    func _eq(other) -> bool {
        return this.value == other.value
    }

    func _lt(other) -> bool {
        return this.value < other.value
    }

    func _gt(other) -> bool {
        return this.value > other.value
    }
}

// 测试加法
n1 <- Number(10)
n2 <- Number(20)
result <- n1 + n2
PrintLine("10 + 20 = " + result.ToStr())  // 应输出 30

// 测试减法
result2 <- n2 - n1
PrintLine("20 - 10 = " + result2.ToStr())  // 应输出 10

// 测试乘法
result3 <- n1 * 3
PrintLine("10 * 3 = " + result3.ToStr())  // 应输出 30

// 测试相等比较
n3 <- Number(10)
if n1 == n3 {
    PrintLine("相等测试通过")
}

// 测试小于比较
if n1 < n2 {
    PrintLine("小于测试通过")
}

// 测试大于比较
if n2 > n1 {
    PrintLine("大于测试通过")
}

PrintLine("所有运算符重载测试完成!")
