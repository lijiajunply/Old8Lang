class Product {
    public name <- ""
    public price <- 0.0
    public category <- ""
    public discount <- 0.0

    func init(name:string, price:double) {
        PrintLine("  [2参] 开始")
        this.name <- name
        this.price <- price
        this.category <- "General"
        PrintLine("  [2参] this.category = " + this.category)
        PrintLine("  [2参] 结束")
    }

    func init(name:string, price:double, category:string, discount:double) {
        PrintLine("[4参] 开始")
        PrintLine("[4参] 调用 this.init 前")
        // 先调用基础构造函数
        this.init(name, price)
        PrintLine("[4参] 调用 this.init 后")
        PrintLine("[4参] this.category = " + this.category)
        PrintLine("[4参] 设置 this.category <- category")
        this.category <- category
        PrintLine("[4参] 设置后 this.category = " + this.category)
        this.discount <- discount
        PrintLine("[4参] 结束")
    }
}

PrintLine("========== 创建 product2 ==========")
product2 <- Product("Laptop", 999.99, "Electronics", 0.1)
PrintLine("========== product2 创建完成 ==========")
PrintLine("product2.category = " + product2.category)
PrintLine("product2.discount = " + product2.discount.ToStr())
