// 变量查找性能测试
global_var <- 100

func test_variable_lookup() {
    local_var <- 50
    sum <- 0

    // 大量变量查找操作
    for i <- 0, i < 1000, i <- i + 1 {
        sum <- sum + local_var + global_var
    }

    return sum
}

// 嵌套循环测试
func test_nested_loops() {
    sum <- 0
    for i <- 0, i < 100, i <- i + 1 {
        for j <- 0, j < 100, j <- j + 1 {
            sum <- sum + i + j
        }
    }
    return sum
}

// 执行测试
PrintLine("开始性能测试...")
result1 <- test_variable_lookup()
PrintLine("变量查找测试完成: " + result1)

result2 <- test_nested_loops()
PrintLine("嵌套循环测试完成: " + result2)

PrintLine("所有测试完成")
