// 测试字符串单个字符访问功能
PrintLine("=== 字符串单个字符访问测试 ===")

// 定义一个字符串
str <- "Hello"
PrintLine("字符串: " + str)

// 访问单个字符
char0 <- str[0]
PrintLine("str[0] = " + char0)

char1 <- str[1]
PrintLine("str[1] = " + char1)

char2 <- str[2]
PrintLine("str[2] = " + char2)

char3 <- str[3]
PrintLine("str[3] = " + char3)

char4 <- str[4]
PrintLine("str[4] = " + char4)

// 测试负索引
charLast <- str[-1]
PrintLine("str[-1] = " + charLast)

charSecondLast <- str[-2]
PrintLine("str[-2] = " + charSecondLast)

PrintLine("\n✅ 字符串单个字符访问测试完成")
