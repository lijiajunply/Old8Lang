// 测试 ValueType 转换方法在三种模式下的通用性

PrintLine("=== ToInt 测试 ===")
intVal <- 42
PrintLine(intVal.ToInt())

doubleVal <- 3.14
PrintLine(doubleVal.ToInt())

boolVal <- true
PrintLine(boolVal.ToInt())

strVal <- "123"
PrintLine(strVal.ToInt())

PrintLine("=== ToDouble 测试 ===")
PrintLine(intVal.ToDouble())
PrintLine(doubleVal.ToDouble())
PrintLine(boolVal.ToDouble())

PrintLine("=== ToBool 测试 ===")
PrintLine(intVal.ToBool())

zeroVal <- 0
PrintLine(zeroVal.ToBool())

PrintLine(doubleVal.ToBool())

trueStr <- "true"
PrintLine(trueStr.ToBool())

falseStr <- "false"
PrintLine(falseStr.ToBool())

PrintLine("=== ToChar 测试 ===")
charCode <- 65
PrintLine(charCode.ToChar())

charStr <- "B"
PrintLine(charStr.ToChar())

PrintLine("=== ToStr 测试 ===")
PrintLine(intVal.ToStr())
PrintLine(doubleVal.ToStr())
PrintLine(boolVal.ToStr())

PrintLine("=== ToHash 测试 ===")
PrintLine(intVal.ToHash())
PrintLine(strVal.ToHash())

PrintLine("=== ToType 测试 ===")
PrintLine(intVal.ToType())
PrintLine(doubleVal.ToType())
PrintLine(boolVal.ToType())
PrintLine(strVal.ToType())

PrintLine("=== Equal 测试 ===")
PrintLine(intVal.Equal(42))
PrintLine(intVal.Equal(43))
PrintLine(strVal.Equal("123"))
PrintLine(strVal.EqualsTo("456"))

PrintLine("所有测试完成！")
