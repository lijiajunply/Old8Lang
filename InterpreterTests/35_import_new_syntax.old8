// 测试新的 import 语法

PrintLine("=== 测试新的 import 语法 ===")

// 测试 1: 命名导入
PrintLine("\n1. 测试命名导入: import { export_func1, export_var1 } from 'test_import_module'")
import { export_func1, export_var1 } from "test_import_module"
PrintLine("export_func1(): " + export_func1())
PrintLine("export_var1: " + export_var1)

// 测试 2: 重命名导入
PrintLine("\n2. 测试重命名导入: import { export_func2 as func2, export_var2 as var2 } from 'test_import_module'")
import { export_func2 as func2, export_var2 as var2 } from "test_import_module"
PrintLine("func2(): " + func2())
PrintLine("var2: " + var2)

// 测试 3: 默认导入
PrintLine("\n3. 测试默认导入: import test_import_module as module")
import test_import_module as module
// 注意：这里的默认导入目前会导入所有内容，因为我们还没有实现模块对象包装
PrintLine("module 导入测试: ")
PrintLine("   export_func1(): " + export_func1())
PrintLine("   export_var1: " + export_var1)

// 测试 4: 传统导入（保持向后兼容）
PrintLine("\n4. 测试传统导入: import 'test_import_module'")
import "test_import_module"
PrintLine("传统导入测试: ")
PrintLine("   export_func1(): " + export_func1())
PrintLine("   export_func2(): " + export_func2())

// 测试 5: 使用标识符作为模块名
PrintLine("\n5. 测试使用标识符作为模块名: import { export_var1 } from test_import_module")
import { export_var1 } from test_import_module
PrintLine("export_var1: " + export_var1)

PrintLine("\n✅ 所有 import 语法测试完成")
