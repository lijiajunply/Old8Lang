// vm_module_alias_example.old8 - 别名导入示例

// 使用别名导入
import { add as sum, multiply as mul } from "vm_math_module"

func main() -> void {
    PrintLine("=== 别名导入示例 ===")

    // 使用别名
    result1 <- sum(100, 200)
    PrintLine("sum(100, 200) = " + result1.ToStr())

    result2 <- mul(7, 8)
    PrintLine("mul(7, 8) = " + result2.ToStr())

    PrintLine("=== 测试完成 ===")
}
