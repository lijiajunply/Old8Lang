// Generic Class
class Box<T> {
    private value: T
    func set(v: T) {
        this.value <- v
    }
    func get() -> T {
        return this.value
    }
}

// Generic Function
func identity<T>(v: T) -> T {
    if v == null {
       PrintLine("v is null")
    } else {
       PrintLine("v is not null")
    }
    return v
}

// Test
box <- Box<int>()
box.set(123)
PrintLine(box.get()) // Expected: 123

val <- identity<string>("hello")
PrintLine(val) // Expected: hello
