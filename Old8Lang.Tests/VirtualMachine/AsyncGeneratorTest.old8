// 异步生成器测试

async func async_gen(max: int) {
    i <- 0
    while i < max {
        yield i
        i <- i + 1
    }
}

func main() {
    PrintLine("Start Async Generator")
    
    gen <- async_gen(3)
    
    async for item in gen {
        PrintLine("Got: " + item.ToStr())
    }
    
    PrintLine("Done")
}
