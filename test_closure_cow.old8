// 测试闭包 COW 优化

PrintLine("=== 测试闭包 COW 优化 ===")

// 测试 1: 只读闭包（最常见，应该零拷贝）
func testReadOnlyClosure() {
    PrintLine("测试 1: 只读闭包")

    x <- 100
    y <- 200

    // 创建只读闭包
    closure <- () -> {
        return x + y
    }

    result <- closure()
    PrintLine("闭包结果: " + result.ToStr())

    if result == 300 {
        PrintLine("✓ 只读闭包测试通过")
        return true
    } else {
        PrintLine("✗ 只读闭包测试失败")
        return false
    }
}

// 测试 2: 写入闭包（应该触发 COW 拷贝）
func testWriteClosure() {
    PrintLine("")
    PrintLine("测试 2: 写入闭包")

    counter <- 0

    // 创建会修改外部变量的闭包
    increment <- () -> {
        counter <- counter + 1
        return counter
    }

    result1 <- increment()
    result2 <- increment()
    result3 <- increment()

    PrintLine("调用 3 次后 counter = " + counter.ToStr())

    if counter == 3 and result3 == 3 {
        PrintLine("✓ 写入闭包测试通过")
        return true
    } else {
        PrintLine("✗ 写入闭包测试失败")
        return false
    }
}

// 测试 3: 嵌套闭包
func testNestedClosure() {
    PrintLine("")
    PrintLine("测试 3: 嵌套闭包")

    a <- 10

    // 外层闭包
    outer <- () -> {
        b <- 20

        // 内层闭包，访问外层和最外层变量
        inner <- () -> {
            return a + b
        }

        return inner()
    }

    result <- outer()
    PrintLine("嵌套闭包结果: " + result.ToStr())

    if result == 30 {
        PrintLine("✓ 嵌套闭包测试通过")
        return true
    } else {
        PrintLine("✗ 嵌套闭包测试失败")
        return false
    }
}

// 测试 4: 多个闭包共享变量
func testMultipleClosures() {
    PrintLine("")
    PrintLine("测试 4: 多个闭包共享变量")

    shared <- 0

    // 第一个闭包：递增
    inc <- () -> {
        shared <- shared + 1
        return shared
    }

    // 第二个闭包：递减
    dec <- () -> {
        shared <- shared - 1
        return shared
    }

    inc()
    inc()
    inc()
    dec()

    PrintLine("最终 shared = " + shared.ToStr())

    if shared == 2 {
        PrintLine("✓ 多个闭包共享变量测试通过")
        return true
    } else {
        PrintLine("✗ 多个闭包共享变量测试失败")
        return false
    }
}

// 运行所有测试
r1 <- testReadOnlyClosure()
r2 <- testWriteClosure()
r3 <- testNestedClosure()
r4 <- testMultipleClosures()

PrintLine("")
PrintLine("=== 测试汇总 ===")
if r1 and r2 and r3 and r4 {
    PrintLine("所有测试通过 ✓")
} else {
    PrintLine("部分测试失败 ✗")
}
