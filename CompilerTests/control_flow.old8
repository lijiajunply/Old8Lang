// 控制流测试

// 1. if-elif-else 条件判断

// 基本if语句
a:int <- 10
if a > 5 {
    a <- a + 1
}

// if-else语句
b:int <- 5
if b > 10 {
    b <- 100
} else {
    b <- 200
}

// if-elif-else语句
c:int <- 15
if c < 10 {
    c <- 100
} elif c < 20 {
    c <- 200
} else {
    c <- 300
}

// 嵌套if语句
d:int <- 25
if d > 20 {
    if d < 30 {
        d <- 250
    } else {
        d <- 350
    }
}

// 2. while 循环

// 基本while循环
e:int <- 0
while e < 5 {
    e <- e + 1
}

// while循环与break
e:int <- 0
while e < 10 {
    if e == 5 {
        break
    }
    e <- e + 1
}

// while循环与continue
f:int <- 0
g:int <- 0
while f < 10 {
    f <- f + 1
    if f % 2 == 0 {
        continue
    }
    g <- g + 1
}

// 3. for 循环

// 基本for循环（根据EBNF：forStatement = "for" set "," expression "," statement block）
h:int <- 0
for i <- 0, i < 5, i <- i + 1 {
    h <- h + i
}

// for-in循环（根据EBNF：forInStatement = "for" identifier "in" expression block）
j:array <- [1, 2, 3, 4, 5]
k:int <- 0
for item in j {
    k <- k + item
}

// 4. 复合控制流

// if-while组合
l:int <- 0
if l == 0 {
    while l < 5 {
        l <- l + 1
    }
}

// while-if组合
m:int <- 0
while m < 10 {
    if m % 2 == 0 {
        m <- m + 1
    } else {
        m <- m + 2
    }
}
