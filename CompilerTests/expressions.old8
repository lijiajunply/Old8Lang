// 表达式测试

// 1. 算术表达式

// 整数算术
a:int <- 10 + 5          // 加法
b:int <- 10 - 5          // 减法
c:int <- 10 * 5          // 乘法
d:int <- 10 / 5          // 除法
e:int <- 10 % 3          // 取模

// 浮点数算术
f:double <- 3.14 + 2.71   // 加法
g:double <- 3.14 - 2.71   // 减法
h:double <- 3.14 * 2      // 乘法
i:double <- 3.14 / 2      // 除法

// 混合类型算术（如果支持）
// j:double <- 10 + 3.14    // 整数+浮点数

// 2. 逻辑表达式

j:bool <- true and false   // 逻辑与
k:bool <- true or false    // 逻辑或
l:bool <- not true         // 逻辑非
m:bool <- true xor false   // 逻辑异或

// 3. 比较表达式

n:bool <- 10 == 5          // 等于
p:bool <- 10 != 5          // 不等于
q:bool <- 10 < 5           // 小于
r:bool <- 10 > 5           // 大于
// s:bool <- 10 <= 10         // 小于等于
// t:bool <- 10 >= 5          // 大于等于

// 4. 复合表达式

u:int <- (10 + 5) * 2       // 带括号的表达式
v:bool <- (10 > 5) and (3.14 < 5.0)  // 复合逻辑表达式
w:double <- (10.5 - 5.2) / (2.0 + 1.0)  // 复杂算术表达式

// 5. 赋值表达式

x:int <- 10
x <- x + 1                 // 自增
x <- x - 1                 // 自减

// 6. 数组访问表达式（注释掉，因为可能导致数组越界错误）
// y:array <- [1, 2, 3, 4, 5]
// z:int <- y[0]              // 数组索引访问

// 7. 字典访问表达式（注释掉，因为可能导致数组越界错误）

// user:dictionary <- {"name": "Alice", "age": 30}
// user_name:string <- user["name"]  // 字典键访问
// user_age:int <- user["age"]      // 字典键访问
