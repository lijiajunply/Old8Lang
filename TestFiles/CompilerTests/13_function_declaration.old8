// 函数重载（如果支持）
PrintLine("\n=== 函数重载（如果支持） ===")

func testOverload(a:int) -> void {
    PrintLine("单参数函数: " + a)
}

func testOverload(a:int, b:int) -> void {
    PrintLine("双参数函数: " + a + ", " + b)
}

testOverload(1)
testOverload(1, 2)

// 带默认参数的函数
// 注意：编译模式下默认参数语法的限制
// 当参数有类型注解时，默认参数功能受限
PrintLine("\n=== 带默认参数的函数 ===")

// 简化版本：只用必填参数
func greetWithDefault(name:string, message:string) -> void {
    PrintLine(message + ", " + name + "!")
}

greetWithDefault("Alice", "Hello")
greetWithDefault("Bob", "Hi")

// 简化版本：基本税率计算
func calculateTotal(price:int, taxRate:double) -> double {
    total <- price * (1 + taxRate)
    PrintLine("总价: " + total)
    return total
}

calculateTotal(100, 0.1)
calculateTotal(100, 0.15)

//注意：默认参数与类型注解的组合在编译模式下暂不完全支持
//因此删除了部分测试用例

PrintLine("\n✅ 所有函数声明和调用测试完成")
