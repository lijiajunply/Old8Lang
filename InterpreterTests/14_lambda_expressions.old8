// 测试Lambda表达式

PrintLine("=== Lambda表达式测试 ===")

// 基本的Lambda表达式
PrintLine("\n=== 基本的Lambda表达式 ===")

add <- (a, b) -> a + b
result <- add(1, 2)
PrintLine("1 + 2 = " + result)

// 带类型假注的Lambda表达式
PrintLine("\n=== 带类型假注的Lambda表达式 ===")

multiply <- (a:int, b:int) -> a * b
product <- multiply(3, 4)
PrintLine("3 * 4 = " + product)

// 单参数的Lambda表达式
PrintLine("\n=== 单参数的Lambda表达式 ===")

square <- (x) -> x * x
squareResult <- square(5)
PrintLine("5的平方 = " + squareResult)

// 无参数的Lambda表达式
PrintLine("\n=== 无参数的Lambda表达式 ===")

greet <- () -> "Hello, Lambda!"
message <- greet()
PrintLine(message)

// 多语句的Lambda表达式
PrintLine("\n=== 多语句的Lambda表达式 ===")

complexLambda <- (a, b) -> {
    sum <- a + b
    product <- a * b
    return "Sum: " + sum + ", Product: " + product
}

complexResult <- complexLambda(2, 3)
PrintLine(complexResult)

// Lambda表达式作为函数参数
PrintLine("\n=== Lambda表达式作为函数参数 ===")

func applyOperation(x, y, operation) {
    return operation(x, y)
}

// 使用Lambda作为参数
addResult <- applyOperation(5, 3, (a, b) -> a + b)
PrintLine("5 + 3 = " + addResult)

subtractResult <- applyOperation(5, 3, (a, b) -> a - b)
PrintLine("5 - 3 = " + subtractResult)

// Lambda表达式作为返回值
PrintLine("\n=== Lambda表达式作为返回值 ===")

func createMultiplier(factor) {
    return (x) -> x * factor
}

double <- createMultiplier(2)
doubleResult <- double(5)
PrintLine("5的2倍 = " + doubleResult)

triple <- createMultiplier(3)
tripleResult <- triple(5)
PrintLine("5的3倍 = " + tripleResult)

// Lambda表达式中的变量捕获
PrintLine("\n=== Lambda表达式中的变量捕获 ===")

globalVar <- 10
captureLambda <- (x) -> x + globalVar
captureResult <- captureLambda(5)
PrintLine("5 + globalVar(" + globalVar + ") = " + captureResult)

// 修改全局变量后再次调用
globalVar <- 20
captureResult2 <- captureLambda(5)
PrintLine("5 + globalVar(" + globalVar + ") = " + captureResult2)

// Lambda表达式的嵌套
PrintLine("\n=== Lambda表达式的嵌套 ===")

outerLambda <- (x) -> {
    innerLambda <- (y) -> x + y
    return innerLambda
}

nestedLambda <- outerLambda(10)
nestedResult <- nestedLambda(5)
PrintLine("10 + 5 = " + nestedResult)

// 使用Lambda表达式进行排序
PrintLine("\n=== 使用Lambda表达式进行排序 ===")

// 这里需要假设有一个sort函数接受比较函数
// sort([3, 1, 4, 1, 5, 9], (a, b) -> a - b)
// PrintLine("排序后的数组：" + sortedArray)

// Lambda表达式与条件判断
PrintLine("\n=== Lambda表达式与条件判断 ===")

maxFunc <- (a, b) -> {
    if a > b {
        return a
    } else {
        return b
    }
}

maxValue <- maxFunc(10, 15)
PrintLine("10和15中的最大值 = " + maxValue)

// Lambda表达式中的数学运算
PrintLine("\n=== Lambda表达式中的数学运算 ===")

circleArea <- (radius) -> 3.14159 * radius * radius
area <- circleArea(5)
PrintLine("半径为5的圆面积 = " + area)

// Lambda表达式与字符串操作
PrintLine("\n=== Lambda表达式与字符串操作 ===")

stringLength <- (str) -> str.length
length <- stringLength("hello")
PrintLine("\"hello\"的长度 = " + length)

// 拼接字符串的Lambda
concat <- (str1, str2) -> str1 + str2
combined <- concat("Hello, ", "World!")
PrintLine(combined)

PrintLine("\n✅ 所有Lambda表达式测试完成")
