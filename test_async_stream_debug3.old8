// 更简单的测试 - 直接的嵌套异步流
PrintLine("=== Direct nested async stream test ===")

outerStream <- async {
    PrintLine("[outerStream] start")

    innerStream <- async {
        PrintLine("  [innerStream] start")
        for i in [1~3] {
            PrintLine("  [innerStream] yielding " + i.ToStr())
            yield i
        }
        PrintLine("  [innerStream] done")
    }

    PrintLine("[outerStream] about to iterate innerStream")
    async for num in innerStream {
        PrintLine("[outerStream] got " + num.ToStr() + " from innerStream, yielding " + (num * 10).ToStr())
        yield num * 10
    }
    PrintLine("[outerStream] done")
}

PrintLine("Starting final iteration...")
results <- {}
async for value in outerStream {
    PrintLine("[main] got " + value.ToStr())
    results.Add(value)
}

PrintLine("Results: " + results.ToStr())
PrintLine("Expected: {10, 20, 30}")
