// 列表推导式测试文件

// 测试1: 基本列表推导式
// 对列表中的每个元素应用表达式
numbers <- [1, 2, 3, 4, 5]
squares <- [x * x for x in numbers]
doubles <- [x * 2 for x in numbers]
increments <- [x + 1 for x in numbers]

// 测试2: 带条件的列表推导式
// 只包含满足条件的元素
evens <- [x for x in numbers if x % 2 == 0]
odds <- [x for x in numbers if x % 2 != 0]
greater_than_2 <- [x for x in numbers if x > 2]

// 测试3: 使用范围表达式的列表推导式
range_squares <- [x * x for x in [1~5]]
range_doubles <- [x * 2 for x in [0~10]]

// 测试4: 使用数组的列表推导式
array_numbers <- [10, 20, 30, 40, 50]
array_squares <- [x * x for x in array_numbers]
array_halves <- [x / 2 for x in array_numbers]

// 测试5: 使用字符串的列表推导式
// 将字符串转换为字符列表
word <- "hello"
characters <- [c for c in word]
uppercase <- [c.upper() for c in word]

// 测试6: 复杂表达式的列表推导式
complex_expr <- [x * x + y * y for x, y in [(1, 2), (3, 4), (5, 6)]]
mixed_expr <- [x + "_" + y for x, y in [("a", "1"), ("b", "2"), ("c", "3")]]

// 测试7: 嵌套列表推导式
// 处理二维列表
matrix <- [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
flattened <- [x for row in matrix for x in row]
squared_matrix <- [[x * x for x in row] for row in matrix]

transposed <- [[row[i] for row in matrix] for i in [0, 1, 2]]

// 测试8: 使用字典的列表推导式
// 遍历字典的键
person <- {"name": "Alice", "age": 30, "city": "New York"}
keys <- [key for key in person]
values <- [person[key] for key in person]
key_value_pairs <- [key + ": " + person[key] for key in person]

// 测试9: 多重循环的列表推导式
// 生成笛卡尔积
a <- [1, 2, 3]
b <- ["a", "b"]
cartesian_product <- [(x, y) for x in a for y in b]

// 测试10: 带多个条件的列表推导式
mixed_conditions <- [x for x in [1~10] if x % 2 == 0 if x > 5]
// 等同于
// mixed_conditions <- [x for x in [1~10] if x % 2 == 0 and x > 5]

// 测试11: 使用函数的列表推导式
func is_even(n) {
    return n % 2 == 0
}

func square(n) {
    return n * n
}

function_comprehension1 <- [is_even(x) for x in [1~10]]
function_comprehension2 <- [square(x) for x in [1~5]]

// 测试12: 空列表推导式
empty1 <- [x for x in []]
empty2 <- [x for x in [1~5] if x > 10]

// 测试13: 包含lambda的列表推导式
lambda_comprehension <- [(x) -> x * 2 for x in [1~5]]

// 测试14: 复杂的条件表达式
complex_condition <- [x if x % 2 == 0 else -x for x in [1~10]]

// 测试15: 列表推导式与其他语法结合
result <- 0
// 在循环中使用列表推导式
for i in [1~3] {
    temp <- [x * i for x in [1~5]]
    result <- result + temp[0]
}

// 打印结果（语法测试，实际运行时会输出）
PrintLine(squares)
PrintLine(evens)
PrintLine(flattened)