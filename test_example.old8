// Old8Lang 测试框架示例
// 展示如何使用 AssertLib, TestRunner 和 MockLib

// 导入测试框架
native "Old8LangLib" AssertLib *
native "Old8LangLib" TestRunner *
native "Old8LangLib" MockLib *

// ===== 基础断言示例 =====
PrintLine("=== 基础断言测试 ===")

// 相等性断言
AssertEqual(5, 5, "数字相等测试")
AssertEqual("hello", "hello", "字符串相等测试")
AssertNotEqual(5, 10, "数字不相等测试")

// 布尔断言
AssertTrue(5 > 3, "大于判断测试")
AssertFalse(5 < 3, "小于判断测试")

// Null 检查
value <- null
AssertNull(value, "Null 检查测试")
value <- 123
AssertNotNull(value, "非 Null 检查测试")

PrintLine("✓ 基础断言测试通过")

// ===== 数值比较断言示例 =====
PrintLine("\n=== 数值比较测试 ===")

AssertGreater(10, 5, "大于测试")
AssertGreaterOrEqual(10, 10, "大于等于测试")
AssertLess(5, 10, "小于测试")
AssertLessOrEqual(5, 5, "小于等于测试")

PrintLine("✓ 数值比较测试通过")

// ===== 字符串断言示例 =====
PrintLine("\n=== 字符串断言测试 ===")

text <- "Hello, World!"
AssertContains(text, "World", "包含测试")
AssertNotContains(text, "xyz", "不包含测试")
AssertStartsWith(text, "Hello", "以...开头测试")
AssertEndsWith(text, "!", "以...结尾测试")

PrintLine("✓ 字符串断言测试通过")

// ===== 集合断言示例 =====
PrintLine("\n=== 集合断言测试 ===")

list <- {1, 2, 3, 4, 5}
AssertContainsItem(list, 3, "集合包含元素测试")
AssertNotContainsItem(list, 10, "集合不包含元素测试")
AssertNotEmpty(list, "集合非空测试")
AssertLength(list, 5, "集合长度测试")

emptyList <- {}
AssertEmpty(emptyList, "空集合测试")

PrintLine("✓ 集合断言测试通过")

// ===== 测试运行器示例 =====
PrintLine("\n=== 测试运行器示例 ===")

// 清除之前的测试
TestRunner.Clear()

// 定义测试套件
Describe("数学运算测试", () -> {
    It("加法应该正确", () -> {
        result <- 2 + 3
        AssertEqual(5, result)
    })

    It("减法应该正确", () -> {
        result <- 10 - 3
        AssertEqual(7, result)
    })

    It("乘法应该正确", () -> {
        result <- 4 * 5
        AssertEqual(20, result)
    })

    It("除法应该正确", () -> {
        result <- 20 / 4
        AssertEqual(5, result)
    })
})

Describe("字符串操作测试", () -> {
    It("字符串拼接应该正确", () -> {
        result <- "Hello" + ", " + "World"
        AssertEqual("Hello, World", result)
    })

    It("字符串长度应该正确", () -> {
        str <- "test"
        AssertEqual(4, str.Length)
    })
})

// 运行测试并显示报告
PrintLine("\n运行测试...")
TestRunner.RunAllWithReport()

// ===== Mock 对象示例 =====
PrintLine("\n=== Mock 对象示例 ===")

// 创建 Mock 对象
mock <- CreateMock("UserService")

// 设置返回值
mock.SetReturnValue("GetUserName", "张三")
mock.SetReturnValue("GetUserAge", 25)

// 模拟方法调用
userName <- mock.Call("GetUserName")
PrintLine($"用户名: {userName}")

userAge <- mock.Call("GetUserAge")
PrintLine($"用户年龄: {userAge}")

// 验证方法被调用
VerifyCalled(mock, "GetUserName")
VerifyCalled(mock, "GetUserAge")

// 验证调用次数
VerifyCallCount(mock, "GetUserName", 1)
VerifyCalledOnce(mock, "GetUserAge")

PrintLine("✓ Mock 对象测试通过")

// ===== Mock 参数验证示例 =====
PrintLine("\n=== Mock 参数验证示例 ===")

// 创建另一个 Mock
calculatorMock <- CreateMock("Calculator")
calculatorMock.SetReturnValue("Add", 15)

// 调用并记录参数
result <- calculatorMock.Call("Add", 10, 5)
PrintLine($"计算结果: {result}")

// 验证参数
VerifyLastCallArgs(calculatorMock, "Add", 10, 5)
PrintLine("✓ Mock 参数验证通过")

// ===== 存根 (Stub) 示例 =====
PrintLine("\n=== 存根示例 ===")

// 创建存根对象
stub <- CreateStub("DatabaseStub")

// 设置多个方法的返回值
returns <- {}
returns["FindUser"] <- {"id": 1, "name": "李四"}
returns["CountUsers"] <- 100
StubReturns(stub, returns)

// 使用存根
user <- stub.Call("FindUser")
PrintLine($"查找用户: {user}")

count <- stub.Call("CountUsers")
PrintLine($"用户总数: {count}")

PrintLine("✓ 存根测试通过")

PrintLine("\n=== 所有测试完成! ===")
