// 追踪方法执行
PrintLine("1. Before class")

class Test {
    func test1() {
        PrintLine("2. In test1 - start")
        a <- 1
        PrintLine("3. In test1 - after assignment")
    }

    func test2() {
        PrintLine("4. In test2 - start")
        return 42
    }
}

PrintLine("5. After class")
t <- Test()
PrintLine("6. After instantiation")
t.test1()
PrintLine("7. After test1")
result <- t.test2()
PrintLine("8. After test2, result: " + result)
