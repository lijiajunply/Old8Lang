// 泛型实例化语法测试

// 泛型类声明
class Box<T> {
    private value:T

    func set(v:T) -> void {
        this.value <- v
    }

    func get() -> T {
        return this.value
    }
}

// 泛型函数声明
func identity<T>(x:T) -> T {
    return x
}

// 泛型类实例化
intBox <- Box<int>()
stringBox <- Box<string>()
doubleBox <- Box<double>()

// 泛型函数调用
result1 <- identity<int>(42)
result2 <- identity<string>("hello")
result3 <- identity<double>(3.14)

// 嵌套泛型实例化
listBox <- Box<List<int>>()
matrixBox <- Box<List<List<string>>>()

// 多类型参数实例化
pair <- KeyValuePair<int, string>()
triple <- Triple<int, string, double>()

// 泛型类型作为参数类型
func processBox(box:Box<int>) -> void {
    // 处理 box
}

// 泛型类型作为返回类型
func createStringBox() -> Box<string> {
    box <- Box<string>()
    return box
}
