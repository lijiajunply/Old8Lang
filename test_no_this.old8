// 测试不使用 this 前缀直接访问字段
class Student {
    public name <- ""
    grade <- 0

    func init(n, g) {
        PrintLine("Init: setting name to " + n + ", grade to " + g.ToStr())
        this.name <- n
        this.grade <- g
        PrintLine("Init: after setting, this.name = " + this.name + ", this.grade = " + this.grade.ToStr())
    }

    func getInfo() {
        PrintLine("getInfo: reading name = " + name + ", grade = " + grade.ToStr())
        return name + " is in grade " + grade.ToStr()
    }
}

PrintLine("Creating student...")
student <- Student("Bob", 10)
PrintLine("Calling getInfo...")
info <- student.getInfo()
PrintLine("Result: " + info)
