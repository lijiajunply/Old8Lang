// 编译模式类型注解测试 - 正向测试
// 所有函数参数和返回值都有完整的类型注解

// 测试1：完整类型注解的普通函数
func add(a:int, b:int) -> int {
    return a + b
}

// 测试2：无参数函数
func sayHello() -> void {
    PrintLine("Hello from Old8Lang!")
}

// 测试3：完整类型注解的Lambda
multiply <- (a:int, b:int) -> a * b

// 测试4：无参数Lambda
greet <- () -> "Hello World"

// 测试5：void返回的函数
func printNum(n:int) -> void {
    PrintLine(n.ToStr())
}

// 测试6：多语句Lambda
process <- (x:int, y:double) -> {
    result <- x + y
    return result
}

// 测试7：带字符串参数的函数
func printMessage(msg:string) -> void {
    PrintLine(msg)
}

// 测试8：返回double的函数
func divide(a:int, b:int) -> double {
    return a / b
}

// 测试9：布尔返回值
func isPositive(n:int) -> bool {
    return n > 0
}

// 主函数测试
func main() -> void {
    PrintLine("===== 编译模式类型注解测试 =====")

    // 测试普通函数
    result1 <- add(10, 20)
    PrintLine("add(10, 20) = " + result1.ToStr())

    // 测试Lambda
    result2 <- multiply(5, 6)
    PrintLine("multiply(5, 6) = " + result2.ToStr())

    // 测试无参数函数
    sayHello()

    // 测试无参数Lambda
    PrintLine(greet())

    // 测试void函数
    printNum(42)

    // 测试多语句Lambda
    result3 <- process(10, 5.5)
    PrintLine("process(10, 5.5) = " + result3.ToStr())

    // 测试除法
    result4 <- divide(10, 3)
    PrintLine("divide(10, 3) = " + result4.ToStr())

    // 测试布尔返回
    result5 <- isPositive(-5)
    PrintLine("isPositive(-5) = " + result5.ToStr())

    PrintLine("===== 所有测试通过 =====")
}

main()
