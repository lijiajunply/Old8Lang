// 范围表达式测试

// 基本范围表达式
PrintLine("=== 基本范围表达式测试 ===")

// 创建范围
range1 <- [1~5]
PrintLine("范围 [1~5] 的元素:")
for i in range1 {
    PrintLine(i)
}

// 负数范围
PrintLine("\n=== 负数范围测试 ===")

range2 <- [-5~0]
PrintLine("范围 [-5~0] 的元素:")
for i in range2 {
    PrintLine(i)
}

// 单元素范围
PrintLine("\n=== 单元素范围测试 ===")

range3 <- [10~10]
PrintLine("范围 [10~10] 的元素:")
for i in range3 {
    PrintLine(i)
}

// 使用范围创建列表
PrintLine("\n=== 使用范围创建列表测试 ===")

list_from_range <- [x for x in [1~5]]
PrintLine("从范围 [1~5] 创建的列表: " + list_from_range)

// 范围与条件结合
PrintLine("\n=== 范围与条件结合测试 ===")

// 范围中的偶数
even_in_range <- [x for x in [1~10] if x % 2 == 0]
PrintLine("范围 [1~10] 中的偶数: " + even_in_range)

// 范围中的奇数
odd_in_range <- [x for x in [1~10] if x % 2 != 0]
PrintLine("范围 [1~10] 中的奇数: " + odd_in_range)

// 范围与函数结合
PrintLine("\n=== 范围与函数结合测试 ===")

func square(x:int) -> {
    return x * x
}

// 范围元素的平方
squares_in_range <- [square(x) for x in [1~5]]
PrintLine("范围 [1~5] 元素的平方: " + squares_in_range)

// 范围的长度
PrintLine("\n=== 范围的长度测试 ===")

range4 <- [1~10]
PrintLine("范围 [1~10] 的长度: " + range4.length)

range5 <- [5~15]
PrintLine("范围 [5~15] 的长度: " + range5.length)

range6 <- [-5~5]
PrintLine("范围 [-5~5] 的长度: " + range6.length)

// 范围的包含性测试
PrintLine("\n=== 范围的包含性测试 ===")

range7 <- [1~5]
PrintLine("3 是否在范围 [1~5] 中: " + (3 in range7))
PrintLine("6 是否在范围 [1~5] 中: " + (6 in range7))
PrintLine("0 是否在范围 [1~5] 中: " + (0 in range7))

// 范围的比较测试
PrintLine("\n=== 范围的比较测试 ===")

range8 <- [1~5]
range9 <- [1~5]
range10 <- [1~10]

PrintLine("范围 [1~5] 是否等于范围 [1~5]: " + (range8 == range9))
PrintLine("范围 [1~5] 是否等于范围 [1~10]: " + (range8 == range10))

// 范围的迭代器测试
PrintLine("\n=== 范围的迭代器测试 ===")

range11 <- [1~3]
iter <- range11.iterator
PrintLine("迭代器访问范围 [1~3]:")
while iter.hasNext {
    PrintLine(iter.next)
}

// 嵌套范围
PrintLine("\n=== 嵌套范围测试 ===")

PrintLine("嵌套范围 [1~2] 和 [3~4]:")
for i in [1~2] {
    for j in [3~4] {
        PrintLine("i = " + i + ", j = " + j)
    }
}

// 范围与算术运算
PrintLine("\n=== 范围与算术运算测试 ===")

// 范围元素加上一个值
range12 <- [1~5]
range_plus <- [x + 10 for x in range12]
PrintLine("范围 [1~5] 元素加 10: " + range_plus)

// 范围元素乘以一个值
range13 <- [1~5]
range_times <- [x * 2 for x in range13]
PrintLine("范围 [1~5] 元素乘以 2: " + range_times)

// 范围的最大值和最小值
PrintLine("\n=== 范围的最大值和最小值测试 ===")

range14 <- [5~15]
PrintLine("范围 [5~15] 的最小值: " + range14.min)
PrintLine("范围 [5~15] 的最大值: " + range14.max)

range15 <- [-10~10]
PrintLine("范围 [-10~10] 的最小值: " + range15.min)
PrintLine("范围 [-10~10] 的最大值: " + range15.max)

// 范围的步长（如果支持）
PrintLine("\n=== 范围的步长测试 ===")

// 尝试使用步长
range16 <- [1~10 step 2]
PrintLine("范围 [1~10 step 2] 的元素:")
for i in range16 {
    PrintLine(i)
}

// 反向范围
PrintLine("\n=== 反向范围测试 ===")

range17 <- [5~1]
PrintLine("反向范围 [5~1] 的元素:")
for i in range17 {
    PrintLine(i)
}

// 范围的字符串表示
PrintLine("\n=== 范围的字符串表示测试 ===")

range18 <- [1~5]
PrintLine("范围 [1~5] 的字符串表示: " + range18)

// 范围与类型转换
PrintLine("\n=== 范围与类型转换测试 ===")

// 范围元素转换为字符串
range19 <- [1~3]
string_range <- [str(x) for x in range19]
PrintLine("范围 [1~3] 元素转换为字符串: " + string_range)

// 范围元素转换为浮点数
float_range <- [x as double for x in range19]
PrintLine("范围 [1~3] 元素转换为浮点数: " + float_range)