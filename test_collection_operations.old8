// 集合操作方法测试

print("=== 集合操作方法测试 ===\n")

// 1. 测试 Union 方法
print("\n1. 测试 Union 方法\n")

tuple1 <- (1, 2, 3, 4)
tuple2 <- (3, 4, 5, 6)
print("tuple1 = ")
print(tuple1)
print("\n")
print("tuple2 = ")
print(tuple2)
print("\n")

union1 <- tuple1.Union(tuple2)
print("tuple1.Union(tuple2) = ")
print(union1)
print("\n")

// 2. 测试 Intersect 方法
print("\n2. 测试 Intersect 方法\n")

intersect1 <- tuple1.Intersect(tuple2)
print("tuple1.Intersect(tuple2) = ")
print(intersect1)
print("\n")

// 3. 测试 Except 方法
print("\n3. 测试 Except 方法\n")

except1 <- tuple1.Except(tuple2)
print("tuple1.Except(tuple2) = ")
print(except1)
print("\n")

except2 <- tuple2.Except(tuple1)
print("tuple2.Except(tuple1) = ")
print(except2)
print("\n")

// 4. 测试 Zip 方法
print("\n4. 测试 Zip 方法\n")

arr1 <- [1, 2, 3]
arr2 <- ["a", "b", "c"]
print("arr1 = ")
print(arr1)
print("\n")
print("arr2 = ")
print(arr2)
print("\n")

zipped1 <- arr1.Zip(arr2)
print("arr1.Zip(arr2) = ")
print(zipped1)
print("\n")

// 5. 测试 Zip 方法（带 zipper 函数）
print("\n5. 测试 Zip 方法（带 zipper 函数）\n")

zipped2 <- arr1.Zip(arr2, (x, y) -> x + y)
print("arr1.Zip(arr2, (x, y) -> x + y) = ")
print(zipped2)
print("\n")

// 6. 测试 GroupBy 方法
print("\n6. 测试 GroupBy 方法\n")

arr3 <- [1, 2, 3, 4, 5, 6]
print("arr3 = ")
print(arr3)
print("\n")

grouped1 <- arr3.GroupBy((x) -> x % 2)
print("arr3.GroupBy((x) -> x % 2):\n")
print(grouped1)
print("\n")

// 7. 测试字符串数组的集合操作
print("\n7. 测试字符串数组的集合操作\n")

arr4 <- ["apple", "banana", "cherry"]
arr5 <- ["banana", "cherry", "date"]
print("arr4 = ")
print(arr4)
print("\n")
print("arr5 = ")
print(arr5)
print("\n")

union2 <- arr4.Union(arr5)
print("arr4.Union(arr5) = ")
print(union2)
print("\n")

intersect2 <- arr4.Intersect(arr5)
print("arr4.Intersect(arr5) = ")
print(intersect2)
print("\n")

except3 <- arr4.Except(arr5)
print("arr4.Except(arr5) = ")
print(except3)
print("\n")

print("\n=== 所有测试完成 ===\n")
