// 测试 String 方法

// 测试 Length
str <- "Hello, World!"
PrintLine("Length: " + str.Length().ToStr())

// 测试 Substring
sub1 <- str.Substring(0, 5)
sub2 <- str.Substring(7)
PrintLine("Substring(0, 5): " + sub1)
PrintLine("Substring(7): " + sub2)

// 测试 Replace
replaced <- str.Replace("World", "Old8Lang")
PrintLine("Replace: " + replaced)

// 测试 Split
parts <- "apple,banana,cherry".Split(",")
PrintLine("Split: " + parts.ToStr())

// 测试 ToUpper 和 ToLower
text <- "Hello World"
PrintLine("ToUpper: " + text.ToUpper())
PrintLine("ToLower: " + text.ToLower())

// 测试 Trim
padded <- "  hello  "
PrintLine("Trim: '" + padded.Trim() + "'")

// 测试 Contains
PrintLine("Contains 'World': " + str.Contains("World").ToStr())
PrintLine("Contains 'xyz': " + str.Contains("xyz").ToStr())

// 测试 IndexOf
PrintLine("IndexOf 'World': " + str.IndexOf("World").ToStr())
PrintLine("IndexOf 'xyz': " + str.IndexOf("xyz").ToStr())

// 测试 StartsWith 和 EndsWith
PrintLine("StartsWith 'Hello': " + str.StartsWith("Hello").ToStr())
PrintLine("EndsWith '!': " + str.EndsWith("!").ToStr())

// 测试 PadLeft 和 PadRight
num <- "42"
PrintLine("PadLeft(5): '" + num.PadLeft(5) + "'")
PrintLine("PadRight(5): '" + num.PadRight(5) + "'")
PrintLine("PadLeft(5, '0'): '" + num.PadLeft(5, "0") + "'")

// 测试 Reverse
PrintLine("Reverse: " + "Hello".Reverse())

// 测试 ToCharArray
chars <- "ABC".ToCharArray()
PrintLine("ToCharArray: " + chars.ToStr())
