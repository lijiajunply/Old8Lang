func fibonacci(n) {
    PrintLine("fibonacci(" + n + ") called")
    if n <= 1 {
        PrintLine("fibonacci(" + n + ") returning 1")
        return 1
    }
    PrintLine("fibonacci(" + n + ") calculating fibonacci(" + (n-1) + ") + fibonacci(" + (n-2) + ")")
    result <- fibonacci(n - 1) + fibonacci(n - 2)
    PrintLine("fibonacci(" + n + ") returning " + result)
    return result
}

fibResult <- fibonacci(3)
PrintLine("斐波那契数列第3项 = " + fibResult)