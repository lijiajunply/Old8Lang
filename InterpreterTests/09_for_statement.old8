// 测试for循环语句

PrintLine("=== for循环语句测试 ===")

// 基本for循环
PrintLine("\n=== 基本for循环 ===")

PrintLine("从0到4循环：")
for i <- 0, i < 5, i++ {
    PrintLine("i = " + i)
}

// for循环求和
PrintLine("\n=== for循环求和 ===")

sum <- 0
for i <- 1, i <= 10, i++ {
    sum <- sum + i
}
PrintLine("1到10的和：" + sum)

// 不同步长的for循环
PrintLine("\n=== 不同步长的for循环 ===")

PrintLine("步长为2：")
for i <- 0, i < 10, i += 2 {
    PrintLine("i = " + i)
}

PrintLine("\n步长为3：")
for i <- 1, i <= 10, i += 3 {
    PrintLine("i = " + i)
}

// 反向for循环
PrintLine("\n=== 反向for循环 ===")

PrintLine("从10到1循环：")
for i <- 10, i >= 1, i-- {
    PrintLine("i = " + i)
}

PrintLine("\n从10到2，步长为-2：")
for i <- 10, i >= 2, i -= 2 {
    PrintLine("i = " + i)
}

// 嵌套for循环
PrintLine("\n=== 嵌套for循环 ===")

PrintLine("打印3x3矩阵：")
for i <- 1, i <= 3, i++ {
    line <- ""
    for j <- 1, j <= 3, j++ {
        line <- line + (i * j) + " "
    }
    PrintLine(line)
}

// for循环中的条件变化
PrintLine("\n=== for循环中的条件变化 ===")

PrintLine("动态条件：")
max <- 5
for i <- 0, i < max, i++ {
    PrintLine("i = " + i + ", max = " + max)
    // 动态修改max值
    if i == 2 {
        max <- 8
    }
}

// for循环遍历数组
PrintLine("\n=== for循环遍历数组 ===")

array <- [10, 20, 30, 40, 50]
PrintLine("数组元素：")
for i <- 0, i < 5, i++ {
    PrintLine("array[" + i + "] = " + array[i])
}

// 计算数组元素和
PrintLine("\n数组元素和：")
arraySum <- 0
for i <- 0, i < 5, i++ {
    arraySum <- arraySum + array[i]
}
PrintLine("sum = " + arraySum)

// 空的for循环体
PrintLine("\n=== 空的for循环体 ===")

counter <- 0
for i <- 0, i < 5, i++ {
    // 空循环体
    counter <- counter + 1
}
PrintLine("循环执行了 " + counter + " 次")

PrintLine("\n✅ 所有for循环语句测试完成")
