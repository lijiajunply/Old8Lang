// 简单switch测试 - 编译模式
// 只测试switch语句

PrintLine("=== 简单switch测试 ===")

// 只测试基本switch语句
option:int <- 2
switch option {
    case 1 {
        PrintLine("选项 1")
    }
    case 2 {
        PrintLine("选项 2")
    }
    case 3 {
        PrintLine("选项 3")
    }
    default {
        PrintLine("默认选项")
    }
}
