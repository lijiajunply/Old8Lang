<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Microsoft.NET.Test.Sdk 会生成一个入口点，但本工程用 Program.cs 的顶级语句作为入口；
         被忽略的自动入口点是测试 SDK 的既有行为，与本工程代码无关。 -->
    <NoWarn>$(NoWarn);CS7022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Old8Lang.Benchmarks" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
        <ProjectReference Include="..\Old8Lang.Interpreter\Old8Lang.Interpreter.csproj" />
<ProjectReference Include="..\Old8Lang.Compiler\Old8Lang.Compiler.csproj" />
<ProjectReference Include="..\Old8Lang.VirtualMachine\Old8Lang.VirtualMachine.csproj" />
<ProjectReference Include="..\Old8Lang.Runtime\Old8Lang.Runtime.csproj" />
    <ProjectReference Include="..\Old8Lang.Hosting\Old8Lang.Hosting.csproj" />
    <ProjectReference Include="..\Old8Lang.Modules.Official\Old8Lang.Modules.Official.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
