// 简单的异步功能测试

// 测试任务组合方法 - Then

async func task1() {
    return 1
}

async func task2() {
    return 2
}

// 测试 Then 方法
result <- await task1().Then((res) -> {
    return task2()
})

// 打印结果（使用 Old8Lang 的内置打印函数）
PrintLine("Then 结果: " + result)

// 测试 Retry 方法
retryCount <- 0

async func flakyTask() {
    retryCount++
    if retryCount < 3 {
        throw new Error("任务失败，需要重试")
    }
    return "重试成功"
}

retryResult <- await flakyTask().Retry(3, 100)
PrintLine("Retry 结果: " + retryResult)