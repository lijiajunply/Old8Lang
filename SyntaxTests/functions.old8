// 函数测试文件

// 测试1: 基本函数声明与调用（使用func关键字）
func add(a, b) {
    return a + b
}

result1 <- add(1, 2)

// 测试2: 另一种函数声明形式
subtract(a, b) -> {
    return a - b
}

result2 <- subtract(5, 3)

// 测试3: 带类型注解的函数
func sumNumbers(a:int, b:int) {
    return a + b
}

result3 <- sumNumbers(10, 20)

// 测试4: 无参数函数
func sayHello() {
    return "Hello, World!"
}

result4 <- sayHello()

// 测试5: 单个参数函数
func greet(name) {
    return "Hello, " + name
}

result5 <- greet("Alice")

// 测试6: 多个参数函数
func multiply(a, b, c) {
    return a * b * c
}

result6 <- multiply(2, 3, 4)

// 测试7: 无返回值函数
func printMessage() {
    PrintLine("This is a message")
}

printMessage()

// 测试8: 带默认参数的函数
func power(base, exponent <- 2) {
    result <- 1
    for i <- 0, i < exponent, i++ {
        result <- result * base
    }
    return result
}

result7 <- power(3)
result8 <- power(3, 4)

// 测试9: 递归函数
func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

result9 <- factorial(5)

// 测试10: 函数嵌套
func outerFunction(x) {
    func innerFunction(y) {
        return y * 2
    }
    return innerFunction(x) + x
}

result10 <- outerFunction(5)

// 测试11: 函数作为参数
func applyOperation(a, b, operation) {
    return operation(a, b)
}

func addOperation(x, y) {
    return x + y
}

func multiplyOperation(x, y) {
    return x * y
}

result11 <- applyOperation(3, 4, addOperation)
result12 <- applyOperation(3, 4, multiplyOperation)

// 测试12: 函数作为返回值
func createMultiplier(factor) {
    func multiplier(x) {
        return x * factor
    }
    return multiplier
}

multiplyBy3 <- createMultiplier(3)
result13 <- multiplyBy3(5)

multiplyBy5 <- createMultiplier(5)
result14 <- multiplyBy5(5)

// 测试13: 带多个返回值的函数（通过元组）
func getMinMax(numbers) {
    min <- numbers[0]
    max <- numbers[0]
    for num in numbers {
        if num < min {
            min <- num
        }
        if num > max {
            max <- num
        }
    }
    return (min, max)
}

minMax <- getMinMax([1, 3, 5, 2, 4])
minValue <- minMax[0]
maxValue <- minMax[1]

// 测试14: 复杂函数声明（多种特性组合）
func complexFunction(a:int, b:double, c:string, d:bool) -> {
    result <- a + b
    if d {
        result <- result * 2
    }
    return c + " " + result
}

result15 <- complexFunction(10, 3.14, "Result:", true)