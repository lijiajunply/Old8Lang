fibIter(a) -> {
    fib_list <- list[1,1]
    for i <- 2 , i < a , i++{
        b <- fib_list[i-1]+fib_list[i-2]
        fib_list.Add(b)
    }
    return fib_list
}

fib2(a) -> {
    Last <- 1
    Second <- 1
    Now <- 1
    for i <- 2 , i < a , i++{
        Now <- Last + Second
        Second <- Last
        Last <- Now
    }
    return Now
}

