// 编译模式 - 类方法类型注解测试
// 测试类中方法的类型注解要求

PrintLine("=== 类方法类型注解测试 ===\n")

// ========== 基本类测试 ==========
PrintLine("【基本类定义测试】")

class Person {
    public name:string <- ""
    public age:int <- 0

    func init(name:string, age:int) -> void {
        this.name <- name
        this.age <- age
    }

    func getName() -> string {
        return this.name
    }

    func getAge() -> int {
        return this.age
    }

    func setAge(newAge:int) -> void {
        this.age <- newAge
    }

    func getInfo() -> string {
        return "姓名: " + this.name + ", 年龄: " + this.age.ToStr()
    }

    func isAdult() -> bool {
        return this.age >= 18
    }
}

person1 <- Person("张三", 25)
PrintLine(person1.getInfo())
PrintLine("是否成年: " + person1.isAdult().ToStr())
person1.setAge(30)
PrintLine("更新后年龄: " + person1.getAge().ToStr())

// ========== 数学计算类 ==========
PrintLine("\n【数学计算类测试】")

class Calculator {
    public result:double <- 0.0

    func init() -> void {
        this.result <- 0.0
    }

    func add(a:double, b:double) -> double {
        this.result <- a + b
        return this.result
    }

    func subtract(a:double, b:double) -> double {
        this.result <- a - b
        return this.result
    }

    func multiply(a:double, b:double) -> double {
        this.result <- a * b
        return this.result
    }

    func divide(a:double, b:double) -> double {
        if b == 0 {
            PrintLine("错误：除数不能为0")
            return 0.0
        }
        this.result <- a / b
        return this.result
    }

    func getResult() -> double {
        return this.result
    }

    func reset() -> void {
        this.result <- 0.0
    }
}

calc <- Calculator()
PrintLine("加法: " + calc.add(10.5, 20.3).ToStr())
PrintLine("减法: " + calc.subtract(50.0, 15.5).ToStr())
PrintLine("乘法: " + calc.multiply(4.5, 3.0).ToStr())
PrintLine("除法: " + calc.divide(100.0, 4.0).ToStr())
PrintLine("当前结果: " + calc.getResult().ToStr())

// ========== 计数器类 ==========
PrintLine("\n【计数器类测试】")

class Counter {
    private count:int <- 0

    func init(initialValue:int) -> void {
        this.count <- initialValue
    }

    func increment() -> void {
        this.count <- this.count + 1
    }

    func decrement() -> void {
        this.count <- this.count - 1
    }

    func incrementBy(amount:int) -> void {
        this.count <- this.count + amount
    }

    func getCount() -> int {
        return this.count
    }

    func reset() -> void {
        this.count <- 0
    }

    func isPositive() -> bool {
        return this.count > 0
    }
}

counter <- Counter(5)
PrintLine("初始计数: " + counter.getCount().ToStr())
counter.increment()
PrintLine("增加后: " + counter.getCount().ToStr())
counter.incrementBy(10)
PrintLine("增加10后: " + counter.getCount().ToStr())
counter.decrement()
PrintLine("减少后: " + counter.getCount().ToStr())
PrintLine("是否为正: " + counter.isPositive().ToStr())

// ========== 矩形类 ==========
PrintLine("\n【矩形类测试】")

class Rectangle {
    public width:double <- 0.0
    public height:double <- 0.0

    func init(width:double, height:double) -> void {
        this.width <- width
        this.height <- height
    }

    func getArea() -> double {
        return this.width * this.height
    }

    func getPerimeter() -> double {
        return 2 * (this.width + this.height)
    }

    func isSquare() -> bool {
        return this.width == this.height
    }

    func scale(factor:double) -> void {
        this.width <- this.width * factor
        this.height <- this.height * factor
    }

    func getDimensions() -> string {
        return "宽: " + this.width.ToStr() + ", 高: " + this.height.ToStr()
    }
}

rect <- Rectangle(10.0, 5.0)
PrintLine("矩形尺寸: " + rect.getDimensions())
PrintLine("矩形面积: " + rect.getArea().ToStr())
PrintLine("矩形周长: " + rect.getPerimeter().ToStr())
PrintLine("是否为正方形: " + rect.isSquare().ToStr())
rect.scale(2.0)
PrintLine("放大2倍后: " + rect.getDimensions())

// ========== 学生类 ==========
PrintLine("\n【学生类测试】")

class Student {
    public name:string <- ""
    public studentId:int <- 0
    public grade:double <- 0.0

    func init(name:string, studentId:int) -> void {
        this.name <- name
        this.studentId <- studentId
        this.grade <- 0.0
    }

    func setGrade(grade:double) -> void {
        this.grade <- grade
    }

    func getGrade() -> double {
        return this.grade
    }

    func isPassing() -> bool {
        return this.grade >= 60.0
    }

    func getGradeLevel() -> string {
        if this.grade >= 90.0 {
            return "优秀"
        } elif this.grade >= 80.0 {
            return "良好"
        } elif this.grade >= 70.0 {
            return "中等"
        } elif this.grade >= 60.0 {
            return "及格"
        } else {
            return "不及格"
        }
    }

    func getStudentInfo() -> string {
        return "学生: " + this.name + ", 学号: " + this.studentId.ToStr() + ", 成绩: " + this.grade.ToStr()
    }
}

student <- Student("李四", 2024001)
student.setGrade(85.5)
PrintLine(student.getStudentInfo())
PrintLine("成绩等级: " + student.getGradeLevel())
PrintLine("是否及格: " + student.isPassing().ToStr())

// ========== 银行账户类 ==========
PrintLine("\n【银行账户类测试】")

class BankAccount {
    private accountNumber:string <- ""
    private balance:double <- 0.0

    func init(accountNumber:string, initialBalance:double) -> void {
        this.accountNumber <- accountNumber
        this.balance <- initialBalance
    }

    func deposit(amount:double) -> void {
        if amount > 0 {
            this.balance <- this.balance + amount
            PrintLine("存入: " + amount.ToStr() + ", 当前余额: " + this.balance.ToStr())
        } else {
            PrintLine("存入金额必须大于0")
        }
    }

    func withdraw(amount:double) -> bool {
        if amount <= 0 {
            PrintLine("取款金额必须大于0")
            return false
        }
        if amount > this.balance {
            PrintLine("余额不足")
            return false
        }
        this.balance <- this.balance - amount
        PrintLine("取出: " + amount.ToStr() + ", 当前余额: " + this.balance.ToStr())
        return true
    }

    func getBalance() -> double {
        return this.balance
    }

    func getAccountNumber() -> string {
        return this.accountNumber
    }
}

account <- BankAccount("6222021234567890", 1000.0)
PrintLine("账号: " + account.getAccountNumber())
PrintLine("初始余额: " + account.getBalance().ToStr())
account.deposit(500.0)
account.withdraw(300.0)
account.withdraw(2000.0)
PrintLine("最终余额: " + account.getBalance().ToStr())

PrintLine("\n✅ 所有类方法类型注解测试完成")
