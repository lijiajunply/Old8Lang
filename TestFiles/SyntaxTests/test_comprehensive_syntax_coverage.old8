// 全面语法覆盖测试（简化版）
// 仅包含Old8Lang肯定支持的语法结构

// 1. 基本类型和字面量
int_literal <- 123
neg_int_literal <- -456
float_literal <- 3.14
neg_float_literal <- -6.789
string_literal <- "hello world"
char_literal <- 'a'
bool_true <- true
bool_false <- false
null_literal <- null

// 2. 复杂表达式
complex_expr <- (10 + 20) * 30 / 40 - 50 % 60
nested_expr <- ((1 + 2) * (3 + 4)) / ((5 + 6) - (7 - 8))
comparison_expr <- a > b && c < d || e == f

// 3. 变量赋值和操作
// 基本赋值
var1 <- 123
// 基本赋值（替代复合赋值）
var2 <- 10
var2 <- var2 + 5
var2 <- var2 - 3
var2 <- var2 * 2
var2 <- var2 / 4
var2 <- var2 % 2
// 单独赋值（替代链式赋值）
var5 <- 100
var4 <- var5
var3 <- var4

// 4. 数组和字典
// 基本数组
arr1 <- [1, 2, 3, 4, 5]
// 空数组
arr2 <- []
// 嵌套数组
arr3 <- [1, [2, 3], [4, [5, 6]]]
// 基本字典
dict1 <- {"name": "test", "value": 123}
// 空字典
dict2 <- {}
// 嵌套字典
dict3 <- {"level1": {"level2": {"level3": "deep"}}}
// 混合类型字典
dict4 <- {"int": 123, "string": "test", "bool": true, "array": [1, 2, 3]}

// 5. 控制流语句
// if-elif-else 各种组合
if a > 10 {
    result <- "greater"
} elif a < 10 {
    result <- "less"
} else {
    result <- "equal"
}

// 单行if
if b {
    c <- 1
}

// 没有else的if
if d > 0 {
    e <- d
}

// for循环各种形式
// 传统for循环
for i <- 0, i < 10, i <- i+1 {
    PrintLine(i)
}

// while循环
while counter < 10 {
    counter <- counter + 1
}

// switch语句（仅支持单个case值）
switch value {
    case 1 {
        result <- "one"
    }
    case 2 {
        result <- "two"
    }
    default {
        result <- "other"
    }
}

// 6. 函数定义和调用
// 基本函数
func add(a, b) {
    return a + b
}

// 无返回值函数
func print_hello() {
    PrintLine("Hello")
}

// 递归函数
func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

// 高阶函数
func apply(func, value) {
    return func(value)
}

// 函数调用各种形式
result1 <- add(10, 20)
result2 <- print_hello()
result3 <- factorial(5)

// 7. Lambda表达式（基本形式）
lambda1 <- (x, y) -> x + y
lambda2 <- (x, y) -> {
    temp <- x + y
    return temp * 2
}

// 8. 类和对象
// 基本类定义
class BasicClass {
    field1 <- 100
    field2 <- "test"
    
    func init() {
        this.field1 <- 200
    }
    
    func get_field1() {
        return this.field1
    }
    
    func set_field1(value) {
        this.field1 <- value
    }
}

// 类实例化和方法调用
basic_obj <- BasicClass()
basic_obj.set_field1(300)
basic_field <- basic_obj.get_field1()

// 9. 异常处理
// 基本try-catch
try {
    risky_operation()
} catch {
    error_occurred <- true
}

// 10. 列表和字典操作
// 列表操作
my_list <- [1, 2, 3, 4, 5]

// 字典操作
my_dict <- {"name": "test", "value": 123}

// 11. 字符串操作
string <- "hello world"

// 12. 注释和空白
// 单行注释
var <- 123 // 这是单行注释

/*
这是多行注释
跨越了多个行
*/
var2 <- 456

// 13. 嵌套块
if a > 0 {
    if b > 0 {
        if c > 0 {
            nested <- true
        }
    }
}

// 14. 简单的嵌套函数
func outer() {
    func inner() {
        return 42
    }
    return inner()
}

// 15. 基本的数组和字典访问
array <- [1, 2, 3, 4, 5]
array_element <- array[0]

array[1] <- 100

my_dict2 <- {"key": "value"}
dict_element <- my_dict2["key"]

my_dict2["new_key"] <- "new_value"