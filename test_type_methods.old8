// 测试 TypeLangValue 实例方法
class Person {
    var name
    var age
    func init(n, a) {
        this.name <- n
        this.age <- a
    }
    func greet() {
        PrintLine("Hello, I'm " + this.name)
    }
}
person <- Person("Alice", 30)
personType <- GetType("Person")
PrintLine("=== 测试 TypeLangValue 实例方法 ===")
PrintLine("类型名: " + personType.Value)
PrintLine("=== 测试 GetMethodNames ===")
methods <- personType.GetMethodNames()
PrintLine("方法数量: " + Len(methods))
PrintLine("=== 测试 GetFieldNames ===")
fields <- personType.GetFieldNames()
PrintLine("字段数量: " + Len(fields))
PrintLine("=== 测试 IsClass ===")
isClass <- personType.IsClass()
PrintLine("是类: " + isClass)
PrintLine("=== 测试 IsInterface ===")
isInterface <- personType.IsInterface()
PrintLine("是接口: " + isInterface)
PrintLine("=== 测试 IsPrimitive ===")
isPrimitive <- personType.IsPrimitive()
PrintLine("是基本类型: " + isPrimitive)
PrintLine("=== 测试 GetBaseType ===")
baseType <- personType.GetBaseType()
PrintLine("父类型: " + baseType)
PrintLine("=== 测试 GetInterfaces ===")
interfaces <- personType.GetInterfaces()
PrintLine("接口数量: " + Len(interfaces))
PrintLine("所有测试完成！")
