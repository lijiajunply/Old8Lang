// 最终测试三元表达式语法

// 测试1: 简单的三元表达式
result <- true ? 1 : 2
PrintLine(result)

// 测试2: 比较表达式作为条件
result <- 5 > 3 ? "大于" : "小于等于"
PrintLine(result)

// 测试3: 嵌套三元表达式
result <- true ? (false ? 1 : 2) : 3
PrintLine(result)

// 测试4: 逻辑表达式作为条件
result <- true && false ? "真" : "假"
PrintLine(result)

// 测试5: 赋值语句中的三元表达式
x <- 10
y <- 20
max <- x > y ? x : y
PrintLine(max)
