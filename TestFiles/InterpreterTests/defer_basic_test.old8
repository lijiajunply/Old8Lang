// defer 解释器测试

// 基本defer执行测试
func testBasicDefer() -> void {
    PrintLine("开始执行")
    defer PrintLine("defer: 清理资源")
    PrintLine("函数主体")
}

// defer后进先出测试
func testDeferOrder() -> void {
    defer PrintLine("defer 1")
    defer PrintLine("defer 2")
    defer PrintLine("defer 3")
    PrintLine("函数体执行")
}

// defer访问变量
func testDeferVariable() -> void {
    x <- "初始值"
    defer PrintLine("defer看到的x: " + x)
    x <- "修改后的值"
    PrintLine("函数体中的x: " + x)
}

// defer与return
func testDeferWithReturn() -> string {
    defer PrintLine("函数即将返回")
    return "返回值"
}

// 执行测试
PrintLine("=== 测试1: 基本defer ===")
testBasicDefer()

PrintLine("\n=== 测试2: defer执行顺序 ===")
testDeferOrder()

PrintLine("\n=== 测试3: defer访问变量 ===")
testDeferVariable()

PrintLine("\n=== 测试4: defer与return ===")
result <- testDeferWithReturn()
PrintLine("收到返回值: " + result)
