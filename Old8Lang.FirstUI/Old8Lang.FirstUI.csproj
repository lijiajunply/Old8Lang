<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <RootNamespace>Old8Lang.FirstUI</RootNamespace>
        <AssemblyName>Old8Lang.FirstUI</AssemblyName>
        <Version>0.1.0-alpha</Version>
        <Description>Old8Lang 的现代化跨平台 GUI 标准库，基于 Avalonia UI</Description>
        <Authors>Old8Lang Team</Authors>
        <PackageTags>old8lang;gui;ui;avalonia;declarative-ui</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avalonia UI 核心包 -->
        <PackageReference Include="Avalonia" Version="11.3.10"/>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.10"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10"/>

        <!-- 可选：Avalonia 扩展 -->
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.10"/>
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10" Condition="'$(Configuration)' == 'Debug'"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    </ItemGroup>

    <ItemGroup>
        <!-- 示例代码和资源 -->
        <None Update="Examples\*.old8">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
