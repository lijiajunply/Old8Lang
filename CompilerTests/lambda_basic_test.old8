// 测试Lambda表达式的基本功能
PrintLine("=== 简单Lambda表达式测试 ===")

// 基本算术Lambda
avg <- (a, b) -> (a + b) / 2
result1 <- avg(4, 6)
PrintLine("(4 + 6) / 2 = " + result1)

// 字符串处理Lambda
greet <- (name) -> "Hello, " + name
result2 <- greet("World")
PrintLine(result2)

// 条件Lambda
getMax <- (a, b) -> a > b ? a : b
result3 <- getMax(10, 20)
PrintLine("max(10, 20) = " + result3)

PrintLine("✅ Lambda表达式测试完成")