// 测试类方法调试
PrintLine("1. Before class")

class Test {
    func test1() {
        PrintLine("2. In test1")
    }

    func test2() {
        PrintLine("3. In test2")
        return 42
    }
}

PrintLine("4. After class")
t <- Test()
PrintLine("5. After instantiation")
t.test1()
PrintLine("6. After test1")
result <- t.test2()
PrintLine("7. After test2, result: " + result)
