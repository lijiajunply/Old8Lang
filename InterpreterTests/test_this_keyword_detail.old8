// 测试this关键字的详细使用
PrintLine("=== this关键字详细测试 ===")

// 定义一个简单的类
class Person {
    name <- ""
    age <- 0
    
    func init(name, age) {
        PrintLine("进入init方法")
        PrintLine("参数name: " + name)
        PrintLine("参数age: " + age)
        
        this.name <- name
        this.age <- age
        
        PrintLine("init方法中this.name: " + this.name)
        PrintLine("init方法中this.age: " + this.age)
    }
    
    func getName() {
        return this.name
    }
    
    func getAge() {
        return this.age
    }
    
    func updateAge(newAge) {
        this.age <- newAge
    }
}

// 实例化类
PrintLine("\n=== 实例化类 ===")
alice <- Person("Alice", 30)

// 测试实例属性
PrintLine("\n=== 测试实例属性 ===")
PrintLine("alice.name: " + alice.name)
PrintLine("alice.age: " + alice.age)

// 测试方法调用
PrintLine("\n=== 测试方法调用 ===")
PrintLine("alice.getName(): " + alice.getName())
PrintLine("alice.getAge(): " + alice.getAge())

// 测试修改属性
PrintLine("\n=== 测试修改属性 ===")
alice.updateAge(31)
PrintLine("修改后 alice.age: " + alice.age)
PrintLine("修改后 alice.getAge(): " + alice.getAge())

// 测试多个实例
PrintLine("\n=== 测试多个实例 ===")
bob <- Person("Bob", 25)
PrintLine("bob.name: " + bob.name)
PrintLine("bob.age: " + bob.age)
PrintLine("alice.name: " + alice.name)
PrintLine("alice.age: " + alice.age)

PrintLine("\n✅ 所有this关键字详细测试完成")