// 简单类型假注测试 - 编译模式
// 只测试基本的类型假注功能

PrintLine("=== 简单类型假注测试 ===")

// 基本类型假注测试
PrintLine("\n1. 基本类型假注:")

// 整数类型假注
a:int <- 123
PrintLine("a:int <- 123, 值: " + a)

// 浮点数类型假注
b:double <- 3.14
PrintLine("b:double <- 3.14, 值: " + b)

// 字符串类型假注
c:string <- "hello"
PrintLine("c:string <- \"hello\", 值: " + c)

// 布尔类型假注
d:bool <- true
PrintLine("d:bool <- true, 值: " + d)

// 字符类型假注
e:char <- 'a'
PrintLine("e:char <- 'a', 值: " + e)

// 类型假注的运算测试
PrintLine("\n2. 类型假注的运算:")

// 整数运算
f:int <- a + 100
PrintLine("f:int <- a + 100 = " + f)

// 浮点数运算
g:double <- b * 2
PrintLine("g:double <- b * 2 = " + g)

// 字符串运算
h:string <- c + " world"
PrintLine("h:string <- c + \" world\" = " + h)

// 函数参数类型假注
PrintLine("\n3. 函数参数类型假注:")

func add(x:int, y:int) {
    return x + y
}

result1 <- add(1, 2)
PrintLine("add(1, 2) = " + result1)

func greet(name:string) {
    return "Hello, " + name
}

result2 <- greet("Alice")
PrintLine("greet(\"Alice\") = " + result2)
