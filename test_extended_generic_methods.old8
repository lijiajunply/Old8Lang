// 扩展的 ILangList 通用方法测试

print("=== 扩展的 ILangList 通用方法测试 ===\n")

// 1. 测试 Tuple 的新方法
print("\n1. 测试 Tuple 的查询和访问方法\n")

tuple1 <- (10, 20, 30, 40, 50)
print("tuple1 = ")
print(tuple1)
print("\n")

// First 方法
first1 <- tuple1.First()
print("tuple1.First() = ")
print(first1)
print("\n")

// Last 方法
last1 <- tuple1.Last()
print("tuple1.Last() = ")
print(last1)
print("\n")

// Skip 方法
skipped1 <- tuple1.Skip(2)
print("tuple1.Skip(2) = ")
print(skipped1)
print("\n")

// Take 方法
taken1 <- tuple1.Take(3)
print("tuple1.Take(3) = ")
print(taken1)
print("\n")

// IndexOf 方法
index1 <- tuple1.IndexOf(30)
print("tuple1.IndexOf(30) = ")
print(index1)
print("\n")

index2 <- tuple1.IndexOf(999)
print("tuple1.IndexOf(999) = ")
print(index2)
print("\n")

// Distinct 方法
tuple2 <- (1, 2, 2, 3, 3, 3, 4)
print("tuple2 = ")
print(tuple2)
print("\n")

distinct1 <- tuple2.Distinct()
print("tuple2.Distinct() = ")
print(distinct1)
print("\n")

// Concat 方法
tuple3 <- (100, 200)
print("tuple3 = ")
print(tuple3)
print("\n")

concatenated1 <- tuple1.Concat(tuple3)
print("tuple1.Concat(tuple3) = ")
print(concatenated1)
print("\n")

// Find 方法
found1 <- tuple1.Find((x) -> x > 25)
print("tuple1.Find(x > 25) = ")
print(found1)
print("\n")

// FirstOrDefault 方法
emptyTuple <- (1,)
first2 <- emptyTuple.First()
print("(1,).First() = ")
print(first2)
print("\n")

// 2. 测试 Array 的新方法
print("\n2. 测试 Array 的查询和访问方法\n")

arr1 <- [5, 10, 15, 20, 25, 30]
print("arr1 = ")
print(arr1)
print("\n")

// First 方法
first3 <- arr1.First()
print("arr1.First() = ")
print(first3)
print("\n")

// Last 方法
last2 <- arr1.Last()
print("arr1.Last() = ")
print(last2)
print("\n")

// Skip 方法
skipped2 <- arr1.Skip(2)
print("arr1.Skip(2) = ")
print(skipped2)
print("\n")

// Take 方法
taken2 <- arr1.Take(4)
print("arr1.Take(4) = ")
print(taken2)
print("\n")

// IndexOf 方法
index3 <- arr1.IndexOf(20)
print("arr1.IndexOf(20) = ")
print(index3)
print("\n")

// Distinct 方法
arr2 <- [1, 1, 2, 2, 3, 3]
distinct2 <- arr2.Distinct()
print("[1,1,2,2,3,3].Distinct() = ")
print(distinct2)
print("\n")

// Concat 方法
arr3 <- [100, 200]
concatenated2 <- arr1.Concat(arr3)
print("arr1.Concat([100,200]) = ")
print(concatenated2)
print("\n")

// Filter 方法
filtered1 <- arr1.Filter((x) -> x >= 20)
print("arr1.Filter(x >= 20) = ")
print(filtered1)
print("\n")

// Map 方法
mapped1 <- arr1.Map((x) -> x * 2)
print("arr1.Map(x * 2) = ")
print(mapped1)
print("\n")

// Find 方法
found2 <- arr1.Find((x) -> x > 18)
print("arr1.Find(x > 18) = ")
print(found2)
print("\n")

print("\n=== 所有测试完成 ===\n")
