// 测试类型注解的错误使用场景
// 验证类型注解在不允许的场景中使用时会产生错误

PrintLine("=== 测试类型注解的错误使用场景 ===")

// 1. 变量引用中的类型注解 - 应该失败
PrintLine("\n1. 变量引用中的类型注解：")
try {
    a <- 123
    // 以下代码应该失败：类型注解只能在声明时使用
    PrintLine(a:int)
    PrintLine("✗ 变量引用中的类型注解测试失败：应该抛出错误")
} catch (e) {
    PrintLine("✓ 变量引用中的类型注解测试成功：正确抛出错误")
    PrintLine("  错误信息：" + e.Message)
}
