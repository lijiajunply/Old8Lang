// 测试类成员的访问修饰符
class A {
    static public staticPublic <- 1
    static private staticPrivate <- 2
    public publicField <- 3
    private privateField <- 4
    
    static public func staticPublicMethod() {
        return A.staticPublic + A.staticPrivate
    }
    
    public func getPublicField() {
        return this.publicField
    }
    
    public func getPrivateField() {
        return this.privateField
    }
    
    static public func getStaticPrivate() {
        return A.staticPrivate
    }
}

PrintLine(A.staticPublic)
PrintLine(A.staticPublicMethod())
PrintLine(A.getStaticPrivate())

obj = A()

PrintLine(obj.publicField)
PrintLine(obj.getPublicField())
PrintLine(obj.getPrivateField())
