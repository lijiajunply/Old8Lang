// Old8Lang FirstUI - Hello World 示例
// 这是最简单的 FirstUI 应用程序

import "firstui" as ui

// 创建应用程序实例
app <- ui.App()

// 定义主视图
HelloWorldView() -> {
    return ui.Column({
        children: {
            ui.Text("Hello, Old8Lang FirstUI!", {
                fontSize: 32,
                fontWeight: "bold",
                color: "#333333"
            }),

            ui.Text("欢迎来到声明式 UI 的世界", {
                fontSize: 16,
                color: "#666666"
            }),

            ui.Button("点击我", {
                onClick: () -> {
                    ui.ShowToast("你好，世界！")
                }
            })
        }
    })
}

// 运行应用程序
app.Run(() -> HelloWorldView())
