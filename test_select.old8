// 测试 select 语句（Channel 多路选择）
// 由于 val <- ch 和 ch <- val 在语法上无法区分，我们主要测试发送case

// 测试 1: select 发送（单个case）
PrintLine("=== 测试 1: select 发送 ===")
ch1 <- ChannelCreateBounded(1)

select {
    case ch1 <- 100 -> {
        PrintLine("成功发送 100 到 ch1")
    }
}

// 验证发送的值
result1 <- ChannelReceive(ch1)
PrintLine("从 ch1 接收到: " + result1.ToStr())

ChannelDispose(ch1)

// 测试 2: select 多个发送case
PrintLine("=== 测试 2: select 多个发送case ===")
ch2 <- ChannelCreateBounded(1)
ch3 <- ChannelCreateBounded(1)

select {
    case ch2 <- 200 -> {
        PrintLine("成功发送 200 到 ch2")
    }
    case ch3 <- 300 -> {
        PrintLine("成功发送 300 到 ch3")
    }
}

// 检查哪个发送成功了
result2 <- ChannelTryReceive(ch2, 10)
if result2 != null {
    PrintLine("ch2 收到: " + result2.ToStr())
} else {
    PrintLine("ch2 为空")
}

result3 <- ChannelTryReceive(ch3, 10)
if result3 != null {
    PrintLine("ch3 收到: " + result3.ToStr())
} else {
    PrintLine("ch3 为空")
}

ChannelDispose(ch2)
ChannelDispose(ch3)

// 测试 3: select 与 default（所有channel已满）
PrintLine("=== 测试 3: select 与 default ===")
ch4 <- ChannelCreateBounded(1)
ch5 <- ChannelCreateBounded(1)

// 填满 channels
ChannelSend(ch4, 999)
ChannelSend(ch5, 888)

select {
    case ch4 <- 400 -> {
        PrintLine("成功发送 400 到 ch4")
    }
    case ch5 <- 500 -> {
        PrintLine("成功发送 500 到 ch5")
    }
    default -> {
        PrintLine("所有 channel 已满，执行 default 分支")
    }
}

ChannelDispose(ch4)
ChannelDispose(ch5)

PrintLine("=== 所有测试完成 ===")
