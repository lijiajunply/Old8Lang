// 测试基本数据类型

// 整数
a <- 123

b <- -456

// 浮点数
c <- 123.45

d <- -67.89

// 字符串
e <- "hello"

f <- "world"

// 布尔值
g <- true

h <- false

// 测试复合数据类型

// 列表（使用方括号）
i <- list[1, 2, 3, 4, 5]

// 数组（使用方括号）
j <- [1, 2, 3, 4, 5]

// 元组
k <- (1, "test")

l <- (true, 3.14)

// 字典
m <- {"name": "test", "age": 20, "isStudent": true}

// 范围
n <- [1~10]

// 切片
array <- [1, 2, 3, 4, 5]
o <- array[1:3]
p <- array[:3]
q <- array[2:]

// 测试函数
func add(x, y) {
    return x + y
}

r <- add(1, 2)

// 测试类
class Person {
    name <- ""
    age <- 0
    
    func setName(n) {
        name <- n
    }
    
    func getName() {
        return name
    }
}

s <- Person()
s.setName("test")
t <- s.getName()

// 测试字符串模板
name <- "test"
u <- ${"Hello, " + name + "!"}

// 测试自增自减
i <- 0
i++
i--
