// 语句测试：嵌套循环
PrintLine("=== 嵌套循环测试 ===")

// 二重循环 - 打印乘法表
PrintLine("九九乘法表:")
for i <- 1; i <= 9; i <- i + 1 {
    line <- ""
    for j <- 1; j <= i; j <- j + 1 {
        result <- i * j
        line <- line + j.ToStr() + "x" + i.ToStr() + "=" + result.ToStr() + " "
    }
    PrintLine(line)
}

// 三重循环
PrintLine("\n三重循环测试:")
count <- 0
for i <- 0; i < 3; i <- i + 1 {
    for j <- 0; j < 3; j <- j + 1 {
        for k <- 0; k < 3; k <- k + 1 {
            count <- count + 1
        }
    }
}
PrintLine("三重循环执行次数: " + count.ToStr())

// 嵌套循环中的break
PrintLine("\n嵌套循环中的break:")
for i <- 0; i < 5; i <- i + 1 {
    for j <- 0; j < 5; j <- j + 1 {
        if j == 3 {
            break
        }
        PrintLine("i=" + i.ToStr() + ", j=" + j.ToStr())
    }
}

// 嵌套循环中的continue
PrintLine("\n嵌套循环中的continue:")
for i <- 0; i < 3; i <- i + 1 {
    for j <- 0; j < 5; j <- j + 1 {
        if j % 2 == 0 {
            continue
        }
        PrintLine("i=" + i.ToStr() + ", j=" + j.ToStr())
    }
}

PrintLine("✅ 嵌套循环测试完成")
