using Old8Lang.AST.Expression;
using Old8Lang.AST.Expression.Value;
using Old8Lang.AST.Statement;
using Old8Lang.Error;

namespace Old8Lang.AST.Visitor;

/// <summary>
/// InterpreterVisitor - 缺失的 Statement 节点实现
/// </summary>
public partial class InterpreterVisitor
{
    /// <summary>
    /// 访问 AsyncForInStatement 节点
    /// </summary>
    public LangValueType VisitAsyncForInStatement(AsyncForInStatement node)
    {
        // 迁移自 AsyncForInStatement.Run()
        // 检查是否在生成器上下文中
        if (manager.GeneratorContext != null)
        {
            return RunAsyncForInWithGeneratorContext(node);
        }
        else
        {
            return RunAsyncForInStandard(node);
        }
    }

    private LangValueType RunAsyncForInStandard(AsyncForInStatement node)
    {
        // 迁移自 AsyncForInStatement.RunStandard()
        // 运行表达式获取可枚举对象
        var iterableResult = node.expression.Accept(this);

        // 处理不同类型的可迭代对象
        if (iterableResult is AsyncStreamLangValue asyncStream)
        {
            return RunAsyncStreamLoop(node, asyncStream);
        }
        else if (iterableResult is AsyncGeneratorLangValue asyncGen)
        {
            return RunAsyncGeneratorLoop(node, asyncGen);
        }
        else if (iterableResult is ListLangValue list)
        {
            return RunListLoop(node, list);
        }
        else
        {
            throw new InvalidOperationError(node, "async for-in只能用于异步流、异步生成器或列表");
        }
    }

    private LangValueType RunAsyncStreamLoop(AsyncForInStatement node, AsyncStreamLangValue asyncStream)
    {
        // 简化版实现：直接运行循环体
        manager.AddChildren();

        while (true)
        {
            try
            {
                // 尝试获取下一个元素（这里简化处理）
                var currentValue = new NullLangValue();

                // 赋值给标识符
                if (node.AllIds.Count > 0)
                {
                    manager.SetValue(node.AllIds[0].IdName, currentValue);
                }

                // 运行循环体
                node.body.Accept(this);

                // 检查break
                if (manager.ControlFlowManager.BreakFlag)
                {
                    manager.ControlFlowManager.BreakFlag = false;
                    break;
                }

                // 检查continue
                if (manager.ControlFlowManager.ContinueFlag)
                {
                    manager.ControlFlowManager.ContinueFlag = false;
                    continue;
                }

                // 检查return
                if (manager.IsReturn)
                {
                    break;
                }
            }
            catch
            {
                break;
            }
        }

        manager.RemoveChildren();
        return new VoidLangValue();
    }

    private LangValueType RunAsyncGeneratorLoop(AsyncForInStatement node, AsyncGeneratorLangValue asyncGen)
    {
        // 简化实现
        manager.AddChildren();

        // 运行循环体（简化）
        node.body.Accept(this);

        manager.RemoveChildren();
        return new VoidLangValue();
    }

    private LangValueType RunListLoop(AsyncForInStatement node, ListLangValue list)
    {
        manager.AddChildren();

        foreach (var item in list.Values)
        {
            // 赋值给标识符
            if (node.AllIds.Count > 0)
            {
                manager.SetValue(node.AllIds[0].IdName, item);
            }

            // 运行循环体
            node.body.Accept(this);

            // 检查break
            if (manager.ControlFlowManager.BreakFlag)
            {
                manager.ControlFlowManager.BreakFlag = false;
                break;
            }

            // 检查continue
            if (manager.ControlFlowManager.ContinueFlag)
            {
                manager.ControlFlowManager.ContinueFlag = false;
                continue;
            }

            // 检查return
            if (manager.IsReturn)
            {
                break;
            }
        }

        manager.RemoveChildren();
        return new VoidLangValue();
    }

    private LangValueType RunAsyncForInWithGeneratorContext(AsyncForInStatement node)
    {
        // 迁移自 AsyncForInStatement.RunWithGeneratorContext()
        // 简化实现：在生成器上下文中运行
        return RunAsyncForInStandard(node);
    }

    /// <summary>
    /// 访问 AsyncFuncInit 节点
    /// </summary>
    public LangValueType VisitAsyncFuncInit(AsyncFuncInit node)
    {
        // 迁移自 AsyncFuncInit.Run()
        // 检查函数重复声明
        if (node.AsyncFuncValue.Id != null)
        {
            var existingFunc = manager.ImportInfos.FirstOrDefault(info =>
                info is AsyncFuncLangValue func &&
                func.Id?.IdName == node.AsyncFuncValue.Id.IdName &&
                func.Ids?.Count == node.AsyncFuncValue.Ids?.Count);

            if (existingFunc != null)
            {
                throw new DuplicateNameError(
                    node,
                    node.AsyncFuncValue.Id.IdName,
                    "异步函数"
                );
            }
        }

        // 添加到导入信息列表
        manager.AddClassAndFunc(node.AsyncFuncValue);

        return new VoidLangValue();
    }

    /// <summary>
    /// 访问 SwitchStatement 节点
    /// </summary>
    public LangValueType VisitSwitchStatement(SwitchStatement node)
    {
        // 迁移自 SwitchStatement.Run()
        var switchValue = node.switchExpression.Accept(this);

        foreach (var oldCase in node.switchCaseList)
        {
            var caseValue = oldCase.expression.Accept(this);
            bool isMatch;

            // 处理范围匹配：如果 caseValue 是数组，检查 switchValue 是否在数组中
            if (caseValue is ArrayLangValue arrayValue)
            {
                isMatch = arrayValue.GetItems().Any(item => switchValue.Equal(item));
            }
            // 普通相等匹配
            else
            {
                isMatch = switchValue.Equal(caseValue);
            }

            if (isMatch)
            {
                oldCase.BlockStatement.Accept(this);

                // 如果case块中执行了return语句，直接返回
                if (manager.IsReturn)
                {
                    return new VoidLangValue();
                }

                // 如果case块中执行了break，保留break标志（让它能够跳出外层循环）
                if (manager.ControlFlowManager.BreakFlag)
                {
                    return new VoidLangValue();
                }

                // 如果case块中执行了continue，保留continue标志（让外层循环处理）
                if (manager.ControlFlowManager.ContinueFlag)
                {
                    return new VoidLangValue();
                }

                return new VoidLangValue();
            }
        }

        node.defaultBlockStatement?.Accept(this);

        // default块中的break和continue保持原样，不需要特殊处理
        // break和continue标志会被保留，让外层循环处理

        return new VoidLangValue();
    }

    /// <summary>
    /// 访问 TryStatement 节点
    /// </summary>
    public LangValueType VisitTryStatement(TryStatement node)
    {
        // 迁移自 TryStatement.Run()
        // 检查是否在生成器上下文中
        if (manager.GeneratorContext != null)
        {
            return RunTryWithGeneratorContext(node);
        }
        else
        {
            return RunTryStandard(node);
        }
    }

    private LangValueType RunTryStandard(TryStatement node)
    {
        // 迁移自 TryStatement.RunStandard()
        try
        {
            node.tryBlock.Accept(this);
        }
        catch (Exception ex)
        {
            bool handled = false;

            foreach (var (exceptionType, exceptionVar, catchBlock) in node.catchBlocks)
            {
                // 检查异常类型（简化：捕获所有异常）
                manager.AddChildren();

                // 如果有异常变量，将异常添加到作用域
                if (exceptionVar != null && !string.IsNullOrEmpty(exceptionVar.IdName))
                {
                    manager.SetValue(exceptionVar.IdName, new ErrorLangValue(ex));
                }

                // 运行catch块
                catchBlock.Accept(this);

                manager.RemoveChildren();
                handled = true;
                break;
            }

            if (!handled)
            {
                throw;
            }
        }
        finally
        {
            // 运行finally块（如果有）
            if (node.finallyBlock != null)
            {
                node.finallyBlock.Accept(this);
            }
        }

        return new VoidLangValue();
    }

    private LangValueType RunTryWithGeneratorContext(TryStatement node)
    {
        // 迁移自 TryStatement.RunWithGeneratorContext()
        // 简化实现：在生成器上下文中运行
        return RunTryStandard(node);
    }

    /// <summary>
    /// 访问 YieldStatement 节点
    /// </summary>
    public LangValueType VisitYieldStatement(YieldStatement node)
    {
        // 迁移自 YieldStatement.Run()
        // 计算yield表达式的值
        var yieldValue = node.YieldExpression.Accept(this);

        // 通过生成器上下文设置yield值和标志
        var genContext = manager.GeneratorContext;
        if (genContext != null)
        {
            genContext.CurrentValue = yieldValue;
            genContext.HasYielded = true;

            // 保存当前执行路径，以便下次从这里恢复
            genContext.ExecutionPath = genContext.GetCurrentPath() + "/yield";
        }
        else
        {
            // 如果在非生成器上下文中使用yield，设置全局标志（用于兼容旧代码）
            manager.Result = yieldValue;
            manager.IsYield = true;
        }

        return yieldValue;
    }
}
