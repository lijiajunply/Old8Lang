// 类方法测试

// 1. 基本方法定义和调用

class BasicMethods {
    // 无参数无返回值方法
    func say_hello() -> {
        // print("Hello from BasicMethods")
    }
    
    // 调用其他方法
    func call_other_method() -> {
        this.say_hello()
    }
}

// 测试基本方法调用
obj1:BasicMethods <- BasicMethods()
obj1.say_hello()
obj1.call_other_method()

