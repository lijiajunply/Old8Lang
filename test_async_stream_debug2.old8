// 测试异步流的基本功能 - 更简单的版本
PrintLine("=== Test 1: Simple async stream ===")
simpleStream <- async {
    PrintLine("Creating values in simpleStream")
    for i in [1~3] {
        PrintLine("About to yield: " + i.ToStr())
        yield i
    }
    PrintLine("SimpleStream completed")
}

PrintLine("Starting iteration...")
count <- 0
async for item in simpleStream {
    count <- count + 1
    PrintLine("Got item: " + item.ToStr() + ", count: " + count.ToStr())
}
PrintLine("Final count: " + count.ToStr())

PrintLine("")
PrintLine("=== Test 2: Nested async stream ===")
numberStream <- async {
    PrintLine("numberStream: creating values")
    for i in [1~3] {
        PrintLine("numberStream: yielding " + i.ToStr())
        yield i
    }
    PrintLine("numberStream: completed")
}

PrintLine("Creating squaredStream...")
squaredStream <- async {
    PrintLine("squaredStream: starting")
    async for num in numberStream {
        PrintLine("squaredStream: got " + num.ToStr() + ", yielding " + (num * num).ToStr())
        yield num * num
    }
    PrintLine("squaredStream: completed")
}

PrintLine("Starting final iteration...")
sum <- 0
async for squared in squaredStream {
    PrintLine("Final: got " + squared.ToStr())
    sum <- sum + squared
}
PrintLine("Final sum: " + sum.ToStr())
