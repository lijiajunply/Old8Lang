// 虚拟机测试 - 控制流(if/while/for)

// if语句测试
PrintLine("=== If语句测试 ===")
x <- 10
if x > 5 {
    PrintLine("x > 5 为真")
} else {
    PrintLine("x > 5 为假")
}

// while循环测试
PrintLine("\n=== While循环测试 ===")
i <- 0
while i < 5 {
    PrintLine("i = " + i.ToStr())
    i <- i + 1
}

// for循环测试
PrintLine("\n=== For循环测试 ===")
for j <- 0; j < 5; j <- j + 1 {
    PrintLine("j = " + j.ToStr())
}

// 嵌套循环测试
PrintLine("\n=== 嵌套循环测试(九九乘法表前3行) ===")
for a <- 1; a <= 3; a <- a + 1 {
    line <- ""
    for b <- 1; b <= 3; b <- b + 1 {
        result <- a * b
        line <- line + a.ToStr() + "x" + b.ToStr() + "=" + result.ToStr() + " "
    }
    PrintLine(line)
}

PrintLine("\n控制流测试完成!")
