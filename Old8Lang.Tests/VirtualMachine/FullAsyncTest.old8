// Full Async/Concurrency Test

async func async_op(x: int) -> int {
    // await TaskDelay(100) // TaskDelay returns TaskLangValue, so await works
    await TaskDelay(100)
    return x * 2
}

func thread_worker(name: string) {
    PrintLine("Thread " + name + " running")
    Sleep(100)
    PrintLine("Thread " + name + " done")
}

func main() {
    PrintLine("--- Async/Await ---")
    t1 <- async_op(10)
    res1 <- await t1
    PrintLine("Async Result: " + res1.ToStr())
    
    PrintLine("--- Task API ---")
    t2 <- TaskRun(() -> { return 42 })
    res2 <- await t2
    PrintLine("TaskRun Result: " + res2.ToStr())
    
    t3 <- TaskDelay(50)
    await t3
    PrintLine("TaskDelay done")
    
    PrintLine("--- Async Generator ---")
    async func gen_func() {
        yield 1
        yield 2
    }
    g <- gen_func()
    async for item in g {
        PrintLine("Gen item: " + item.ToStr())
    }
    
    PrintLine("--- Multithreading ---")
    th1 <- spawn(thread_worker, "TH1")
    ThreadJoin(th1)
    
    PrintLine("All tests passed")
}
