// 网络库的导入定义
// 这个文件定义了Old8Lang如何导入C#实现的网络库
// 导入SocketClient类的方法
native "Old8Lang.NetLib" SocketClient
// 导入HttpClient类的方法
native "Old8Lang.NetLib" HttpWebClient
// 导入MqttClient类的方法
native "Old8Lang.NetLib" MqttClient
// 导入WebSocketClient类的方法
native "Old8Lang.NetLib" WebSocketClient
// 导入WebApiClient类的方法
native "Old8Lang.NetLib" WebApiClient