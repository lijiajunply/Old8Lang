// 测试表达式

// 算术运算（加减）
a <- 10 + 5
PrintLine("10 + 5 = " + a)
b <- 10 - 5
PrintLine("10 - 5 = " + b)

// 算术运算（乘除）
c <- 10 * 5
PrintLine("10 * 5 = " + c)
d <- 10 / 5
PrintLine("10 / 5 = " + d)
e <- 10 / 3
PrintLine("10 / 3 = " + e)

// 混合算术运算
f <- 10 + 5 * 2
PrintLine("10 + 5 * 2 = " + f)
g <- (10 + 5) * 2
PrintLine("(10 + 5) * 2 = " + g)

// 比较运算
h <- 10 > 5
PrintLine("10 > 5 = " + h)
i <- 10 < 5
PrintLine("10 < 5 = " + i)
j <- 10 == 10
PrintLine("10 == 10 = " + j)
k <- 10 != 5
PrintLine("10 != 5 = " + k)
l <- 10 <= 10
PrintLine("10 <= 10 = " + l)
m <- 10 >= 5
PrintLine("10 >= 5 = " + m)

// 布尔运算
n <- true and false
PrintLine("true and false = " + n)
o <- true or false
PrintLine("true or false = " + o)
p <- true xor false
PrintLine("true xor false = " + p)
q <- true xor true
PrintLine("true xor true = " + q)

// 复杂布尔运算
r <- (10 > 5) and (20 < 30)
PrintLine("(10 > 5) and (20 < 30) = " + r)
s <- (10 > 5) or (20 > 30)
PrintLine("(10 > 5) or (20 > 30) = " + s)

// 点表达式
class Test {
    value <- 42
    
    func getValue() -> {
        return value
    }
}

testObj <- Test()
testVal <- testObj.value
PrintLine("testObj.value = " + testVal)
testMethodVal <- testObj.getValue()
PrintLine("testObj.getValue() = " + testMethodVal)

// 字符串树
name <- "World"
stringTree1 <- ${"Hello, ", name}
PrintLine(stringTree1)

// 列表切片
list1 <- list[1, 2, 3, 4, 5]
slice1 <- list1[1:3]
PrintLine("list1[1:3] = " + slice1)

// 列表索引
list2 <- list[10, 20, 30]
indexVal <- list2[1]
PrintLine("list2[1] = " + indexVal)

// 数组索引
array1 <- [100, 200, 300]
arrayVal <- array1[0]
PrintLine("array1[0] = " + arrayVal)

// 字典索引
dict1 <- {"name": "Old8Lang", "version": 1.0}
dictVal <- dict1["name"]
PrintLine("dict1['name'] = " + dictVal)
