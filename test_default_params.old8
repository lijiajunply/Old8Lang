// 测试默认参数值缓存优化
PrintLine("=== 默认参数测试 ===")

PrintLine("\n--- 测试1：常量默认参数（会被缓存）---")
func greet(name:string, greeting: "Hello") {
    return greeting + ", " + name + "!"
}

PrintLine(greet("Alice"))           // 使用默认值 "Hello"
PrintLine(greet("Bob", "Hi"))       // 提供自定义值
PrintLine(greet("Charlie"))         // 再次使用默认值（从缓存）

PrintLine("\n--- 测试2：数字默认参数 ---")
func power(base:int, exp: 2) {
    result:int <- 1
    i:int <- 0
    while i < exp {
        result <- result * base
        i <- i + 1
    }
    return result
}

PrintLine("power(3) = " + power(3))        // 3^2 = 9
PrintLine("power(3, 3) = " + power(3, 3))  // 3^3 = 27
PrintLine("power(5) = " + power(5))        // 5^2 = 25（从缓存）

PrintLine("\n--- 测试3：多个默认参数 ---")
func configure(name:string, port: 8080, host: "localhost", debug: false) {
    return name + " @ " + host + ":" + port + " (debug=" + debug + ")"
}

PrintLine(configure("app1"))
PrintLine(configure("app2", 3000))
PrintLine(configure("app3", 4000, "0.0.0.0"))
PrintLine(configure("app4", 5000, "127.0.0.1", true))

PrintLine("\n--- 测试4：算术表达式默认参数（会被缓存）---")
func calculate(x:int, offset: 10 + 5) {
    return x + offset
}

PrintLine("calculate(100) = " + calculate(100))  // 100 + 15 = 115
PrintLine("calculate(200) = " + calculate(200))  // 200 + 15 = 215（缓存）

PrintLine("\n✅ 默认参数测试完成")
