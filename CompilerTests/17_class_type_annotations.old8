// 类类型假注测试 - 编译模式
// 测试类的类型假注功能

PrintLine("=== 类类型假注测试 ===")

// 类声明
class Person {
    public name:string <- ""
    age:int <- 0
    
    func init(name:string, age:int) {
        this.name <- name
        this.age <- age
    }
    
    public func sayHello() {
        return "Hello, my name is " + this.name
    }
    
    public func getAge() {
        return this.age
    }
}

// 实例化类
PrintLine("\n1. 类实例化测试:")
p:Person <- Person("Alice", 30)
PrintLine("Person name: " + p.name)
PrintLine("Person age: " + p.age)

// 类方法调用
PrintLine("\n2. 类方法调用测试:")
helloMsg <- p.sayHello()
PrintLine(helloMsg)

age <- p.getAge()
PrintLine("Person age from method: " + age)

// 类属性修改
PrintLine("\n3. 类属性修改测试:")
p.name <- "Bob"
p.age <- 35
PrintLine("Updated name: " + p.name)
PrintLine("Updated age: " + p.age)
PrintLine(p.sayHello())
