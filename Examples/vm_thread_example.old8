// 虚拟机模式下的多线程示例 - 使用 Spawn

// 示例1: 简单的线程创建和等待
func worker() -> int {
    PrintLine("Worker thread running...")
    return 42
}

// 示例2: 带参数的线程
func add(a:int, b:int) -> int {
    PrintLine("Adding " + a.ToStr() + " + " + b.ToStr())
    return a + b
}

// 示例3: 多线程计算
func calculate(id:int) -> int {
    PrintLine("Thread " + id.ToStr() + " calculating...")
    Sleep(100)
    return id * id
}

// 示例4: 使用互斥锁保护共享资源
counter <- 0
mutexId <- MutexCreate()

func incrementCounter() -> void {
    MutexLock(mutexId)
    counter <- counter + 1
    PrintLine("Counter: " + counter.ToStr())
    MutexUnlock(mutexId)
}

func main() -> void {
    PrintLine("=== 示例1: 简单线程 ===")
    t1 <- Spawn(worker)
    result1 <- t1.Join()
    PrintLine("Result: " + result1.ToStr())

    PrintLine("\n=== 示例2: 带参数的线程 ===")
    t2 <- Spawn(add, 10, 20)
    result2 <- t2.Join()
    PrintLine("Result: " + result2.ToStr())

    PrintLine("\n=== 示例3: 多线程计算 ===")
    threads <- {}
    i <- 1
    while i <= 5 {
        t <- Spawn(calculate, i)
        threads.Add(t)
        i <- i + 1
    }

    sum <- 0
    for t in threads {
        result <- t.Join()
        sum <- sum + result
    }
    PrintLine("Total sum: " + sum.ToStr())

    PrintLine("\n=== 示例4: 使用互斥锁 ===")
    counterThreads <- {}
    i <- 1
    while i <= 10 {
        t <- Spawn(incrementCounter)
        counterThreads.Add(t)
        i <- i + 1
    }

    for t in counterThreads {
        t.Join()
    }

    PrintLine("Final counter: " + counter.ToStr())
    MutexDispose(mutexId)

    PrintLine("\n=== 示例5: 检查线程状态 ===")
    t5 <- Spawn(calculate, 100)

    if t5.IsAlive {
        PrintLine("Thread is still running...")
    }

    t5.Join()

    PrintLine("\nAll tests completed!")
}
