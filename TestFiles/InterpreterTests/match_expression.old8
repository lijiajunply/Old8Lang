// Match 表达式测试
// 测试 match 表达式的各种用法

PrintLine("=== Match 表达式测试 ===")

// 测试 1: 基本值匹配
PrintLine("\n1. 基本值匹配:")
result1 <- match 2 {
    case 0 -> "zero"
    case 1 -> "one"
    case 2 -> "two"
    case 3 -> "three"
    case _ -> "other"
}
PrintLine("match 2 = " + result1)  // 应输出 "two"

// 测试 2: 字符串匹配
PrintLine("\n2. 字符串匹配:")
name <- "Bob"
greeting <- match name {
    case "Alice" -> "Hello Alice!"
    case "Bob" -> "Hi Bob!"
    case "Charlie" -> "Hey Charlie!"
    case _ -> "Hello stranger!"
}
PrintLine("Greeting for " + name + ": " + greeting)  // 应输出 "Hi Bob!"

// 测试 3: 通配符
PrintLine("\n3. 通配符:")
unknownValue <- 999
result3 <- match unknownValue {
    case 1 -> "one"
    case 2 -> "two"
    case _ -> "unknown number"
}
PrintLine("match 999 = " + result3)  // 应输出 "unknown number"

// 测试 4: 变量绑定
PrintLine("\n4. 变量绑定:")
value <- 42
result4 <- match value {
    case 0 -> "zero"
    case x -> "The value is " + x.ToStr()
}
PrintLine(result4)  // 应输出 "The value is 42"

// 测试 5: 布尔值匹配
PrintLine("\n5. 布尔值匹配:")
flag <- true
status <- match flag {
    case true -> "enabled"
    case false -> "disabled"
}
PrintLine("Status: " + status)  // 应输出 "enabled"

// 测试 6: 浮点数匹配
PrintLine("\n6. 浮点数匹配:")
pi <- 3.14
result6 <- match pi {
    case 2.71 -> "Euler's number"
    case 3.14 -> "Pi"
    case 1.41 -> "Square root of 2"
    case _ -> "Unknown constant"
}
PrintLine(result6)  // 应输出 "Pi"

// 测试 7: 匹配表达式结果
PrintLine("\n7. 匹配表达式结果:")
x <- 5
y <- 3
result7 <- match x + y {
    case 8 -> "eight"
    case 10 -> "ten"
    case 5 -> "five"
    case _ -> "other"
}
PrintLine("5 + 3 = " + result7)  // 应输出 "eight"

// 测试 8: 返回数值
PrintLine("\n8. 返回数值:")
input <- 3
result8 <- match input {
    case 1 -> 10
    case 2 -> 20
    case 3 -> 30
    case _ -> -1
}
PrintLine("Result: " + result8.ToStr())  // 应输出 "30"

// 测试 9: 嵌套 match
PrintLine("\n9. 嵌套 match:")
outerValue <- 1
result9 <- match outerValue {
    case 0 -> "zero"
    case x -> match x * 2 {
        case 2 -> "double of one"
        case 4 -> "double of two"
        case _ -> "double of something else"
    }
}
PrintLine(result9)  // 应输出 "double of one"

// 测试 10: 在函数中使用 match
PrintLine("\n10. 在函数中使用 match:")
func getGrade(score:int) -> string {
    result <- match score {
        case 90 -> "A"
        case 80 -> "B"
        case 70 -> "C"
        case 60 -> "D"
        case _ -> "F"
    }
    return result
}

PrintLine("Grade for 90: " + getGrade(90))  // 应输出 "A"
PrintLine("Grade for 70: " + getGrade(70))  // 应输出 "C"
PrintLine("Grade for 50: " + getGrade(50))  // 应输出 "F"

// 测试 11: 作用域隔离
PrintLine("\n11. 作用域隔离:")
outerX <- 100
result11 <- match 42 {
    case x -> "matched: " + x.ToStr()
}
PrintLine(result11)  // 应输出 "matched: 42"
PrintLine("outerX still = " + outerX.ToStr())  // 应输出 "100"

// 测试 12: 第一个匹配的 case 执行
PrintLine("\n12. 第一个匹配的 case 执行:")
result12 <- match 5 {
    case 5 -> "first match"
    case 5 -> "second match"
    case _ -> "no match"
}
PrintLine(result12)  // 应输出 "first match"

// 测试 13: 复杂表达式作为结果
PrintLine("\n13. 复杂表达式作为结果:")
a <- 10
b <- 20
result13 <- match "calculate" {
    case "add" -> a + b
    case "subtract" -> a - b
    case "multiply" -> a * b
    case "calculate" -> a * 2 + b
    case _ -> 0
}
PrintLine("Result: " + result13.ToStr())  // 应输出 "40"

// 测试 14: Match 作为函数返回值
PrintLine("\n14. Match 作为函数返回值:")
func getDayType(day:int) -> string {
    return match day {
        case 6 -> "Weekend"
        case 7 -> "Weekend"
        case _ -> "Weekday"
    }
}

PrintLine("Day 3: " + getDayType(3))  // 应输出 "Weekday"
PrintLine("Day 6: " + getDayType(6))  // 应输出 "Weekend"

// 测试 15: 字符类型匹配
PrintLine("\n15. 字符类型匹配:")
grade <- 'A'
description <- match grade {
    case 'A' -> "Excellent"
    case 'B' -> "Good"
    case 'C' -> "Average"
    case 'D' -> "Below Average"
    case 'F' -> "Fail"
    case _ -> "Invalid Grade"
}
PrintLine("Grade " + grade + ": " + description)  // 应输出 "Excellent"

PrintLine("\n=== 所有测试完成 ===")
