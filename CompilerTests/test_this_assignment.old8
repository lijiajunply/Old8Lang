// 测试this赋值
class Person {
    name <- "default"
    
    func init(newName) {
        PrintLine("Before assignment, this.name = " + this.name)
        this.name <- newName
        PrintLine("After assignment, this.name = " + this.name)
    }
}

person <- Person("Bob")
PrintLine("Outside class, person.name = " + person.name)
