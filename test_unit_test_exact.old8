class Calculator {
    public value <- 0

    func init(initialValue:int) {
        value <- initialValue
    }

    func Add(number:int) -> int {
        value <- value + number
        return value
    }

    func Multiply(factor:int) -> int {
        value <- value * factor
        return value
    }
}

calc <- Calculator(10)
PrintLine("After init, calc.value = " + calc.value.ToStr())
result1 <- calc.Add(5)
PrintLine("After Add(5), result1 = " + result1.ToStr())
PrintLine("After Add(5), calc.value = " + calc.value.ToStr())
result2 <- calc.Multiply(2)
PrintLine("After Multiply(2), result2 = " + result2.ToStr())
finalValue <- calc.value
PrintLine("Final value = " + finalValue.ToStr())
