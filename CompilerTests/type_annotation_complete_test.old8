// 编译模式 - 完整类型注解功能测试
// 测试各种数据类型的函数参数和返回值

PrintLine("=== 编译模式类型注解完整测试 ===\n")

// ========== 基本类型测试 ==========
PrintLine("【基本类型测试】")

func addInt(a:int, b:int) -> int {
    return a + b
}

func multiplyDouble(a:double, b:double) -> double {
    return a * b
}

func concatenateString(s1:string, s2:string) -> string {
    return s1 + s2
}

func negateBoolean(flag:bool) -> bool {
    return not flag
}

func charToString(c:char) -> string {
    return c.ToStr()
}

PrintLine("整数加法: " + addInt(10, 20).ToStr())
PrintLine("浮点乘法: " + multiplyDouble(3.5, 2.0).ToStr())
PrintLine("字符串拼接: " + concatenateString("Hello", " World"))
PrintLine("布尔取反: " + negateBoolean(true).ToStr())
PrintLine("字符转字符串: " + charToString('A'))

// ========== Void返回类型测试 ==========
PrintLine("\n【Void返回类型测试】")

func printInfo(name:string, age:int) -> void {
    PrintLine("姓名: " + name + ", 年龄: " + age.ToStr())
}

func logMessage(message:string) -> void {
    PrintLine("[LOG] " + message)
}

printInfo("张三", 25)
logMessage("系统启动成功")

// ========== 类型转换测试 ==========
PrintLine("\n【类型转换测试】")

func intToDouble(n:int) -> double {
    return n
}

func doubleToInt(d:double) -> int {
    return d
}

func intToString(n:int) -> string {
    return n.ToStr()
}

PrintLine("Int转Double: " + intToDouble(42).ToStr())
PrintLine("Double转Int: " + doubleToInt(3.14).ToStr())
PrintLine("Int转String: " + intToString(100))

// ========== 数组和列表类型测试 ==========
PrintLine("\n【集合类型测试】")

func sumArray(arr:array) -> int {
    sum <- 0
    for i in arr {
        sum <- sum + i
    }
    return sum
}

func getArrayLength(arr:array) -> int {
    return Len(arr)
}

func createStringArray(s1:string, s2:string, s3:string) -> array {
    return [s1, s2, s3]
}

testArray <- [1, 2, 3, 4, 5]
PrintLine("数组求和: " + sumArray(testArray).ToStr())
PrintLine("数组长度: " + getArrayLength(testArray).ToStr())

strArray <- createStringArray("A", "B", "C")
PrintLine("创建字符串数组长度: " + Len(strArray).ToStr())

// ========== 条件逻辑测试 ==========
PrintLine("\n【条件逻辑测试】")

func max(a:int, b:int) -> int {
    if a > b {
        return a
    } else {
        return b
    }
}

func min(a:int, b:int) -> int {
    if a < b {
        return a
    }
    return b
}

func isEven(n:int) -> bool {
    return n % 2 == 0
}

func isPositive(n:int) -> bool {
    return n > 0
}

PrintLine("最大值(10, 20): " + max(10, 20).ToStr())
PrintLine("最小值(10, 20): " + min(10, 20).ToStr())
PrintLine("8是偶数: " + isEven(8).ToStr())
PrintLine("-5是正数: " + isPositive(-5).ToStr())

// ========== 循环逻辑测试 ==========
PrintLine("\n【循环逻辑测试】")

func factorial(n:int) -> int {
    if n <= 1 {
        return 1
    }
    result <- 1
    for i in Range(2, n + 1) {
        result <- result * i
    }
    return result
}

func fibonacci(n:int) -> int {
    if n <= 1 {
        return n
    }
    a <- 0
    b <- 1
    for i in Range(2, n + 1) {
        temp <- a + b
        a <- b
        b <- temp
    }
    return b
}

PrintLine("5的阶乘: " + factorial(5).ToStr())
PrintLine("斐波那契第10项: " + fibonacci(10).ToStr())

// ========== Lambda表达式测试 ==========
PrintLine("\n【Lambda表达式测试】")

// 基本Lambda
square <- (x:int) -> x * x
PrintLine("Lambda平方(5): " + square(5).ToStr())

// 多参数Lambda
power <- (base:int, exp:int) -> {
    result <- 1
    for i in Range(0, exp) {
        result <- result * base
    }
    return result
}
PrintLine("Lambda幂运算(2^8): " + power(2, 8).ToStr())

// 字符串处理Lambda
toUpper <- (s:string) -> s
reverse <- (s:string) -> {
    // 简单示例，实际反转需要更多逻辑
    return s + " (reversed)"
}
PrintLine("Lambda字符串: " + reverse("Hello"))

// 无参数Lambda
getPI <- () -> 3.14159
PrintLine("Lambda获取PI: " + getPI().ToStr())

// ========== 嵌套函数调用测试 ==========
PrintLine("\n【嵌套函数调用测试】")

func triple(n:int) -> int {
    return n * 3
}

func addThenTriple(a:int, b:int) -> int {
    return triple(addInt(a, b))
}

func calculateExpression(x:int, y:int) -> int {
    return addInt(triple(x), multiplyDouble(y, 2))
}

PrintLine("嵌套调用 addThenTriple(5, 3): " + addThenTriple(5, 3).ToStr())
PrintLine("复杂表达式 calculateExpression(4, 5): " + calculateExpression(4, 5).ToStr())

// ========== 字符串处理测试 ==========
PrintLine("\n【字符串处理测试】")

func repeatString(s:string, times:int) -> string {
    result <- ""
    for i in Range(0, times) {
        result <- result + s
    }
    return result
}

func joinStrings(s1:string, s2:string, separator:string) -> string {
    return s1 + separator + s2
}

func stringLength(s:string) -> int {
    return Len(s)
}

PrintLine("重复字符串: " + repeatString("Ha", 3))
PrintLine("连接字符串: " + joinStrings("Apple", "Orange", " & "))
PrintLine("字符串长度: " + stringLength("Hello World").ToStr())

// ========== 数学运算测试 ==========
PrintLine("\n【数学运算测试】")

func average(a:int, b:int) -> double {
    return (a + b) / 2.0
}

func percentage(part:double, total:double) -> double {
    return (part / total) * 100.0
}

func absolute(n:int) -> int {
    if n < 0 {
        return -n
    }
    return n
}

PrintLine("平均值(10, 20): " + average(10, 20).ToStr())
PrintLine("百分比(25, 200): " + percentage(25.0, 200.0).ToStr() + "%")
PrintLine("绝对值(-42): " + absolute(-42).ToStr())

// ========== 类型注解与默认行为测试 ==========
PrintLine("\n【返回值默认行为测试】")

func voidFunction() -> void {
    PrintLine("  这是一个void函数")
}

func emptyIntFunction() -> int {
    // 没有显式return，应该返回0
}

func emptyDoubleFunction() -> double {
    // 没有显式return，应该返回0.0
}

func emptyBoolFunction() -> bool {
    // 没有显式return，应该返回false
}

voidFunction()
PrintLine("空int函数返回: " + emptyIntFunction().ToStr())
PrintLine("空double函数返回: " + emptyDoubleFunction().ToStr())
PrintLine("空bool函数返回: " + emptyBoolFunction().ToStr())

PrintLine("\n✅ 所有类型注解功能测试完成")
