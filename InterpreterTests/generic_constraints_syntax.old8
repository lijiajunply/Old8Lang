// 测试泛型约束的语法支持（仅语法测试）

// 定义接口
interface IComparable {
    func compareTo(other: any) -> int
}

interface ICloneable {
    func clone() -> any
}

// 测试1: 类的泛型约束（单个约束）
class Box1<T: IComparable> {
    value: T

    func init(v: T) {
        this.value <- v
    }
}

// 测试2: 类的泛型约束（多个约束，& 分隔）
class Box2<T: IComparable & ICloneable> {
    value: T

    func init(v: T) {
        this.value <- v
    }
}

// 测试3: 函数的泛型约束（where 子句）
func process<T>(value: T) -> T where T: IComparable {
    return value
}

// 测试4: 函数的多类型参数 where 子句
func combine<K, V>(key: K, value: V) -> any where K: IComparable, V: ICloneable {
    return null
}

// 测试5: 混合约束语法
func mixed<T: IComparable>(value: T) -> T where T: ICloneable {
    return value
}

PrintLine("测试1: 类泛型约束（单个） - 通过")
PrintLine("测试2: 类泛型约束（&分隔） - 通过")
PrintLine("测试3: 函数 where 子句 - 通过")
PrintLine("测试4: 多参数 where 子句 - 通过")
PrintLine("测试5: 混合约束语法 - 通过")
PrintLine("")
PrintLine("所有语法测试通过！")
