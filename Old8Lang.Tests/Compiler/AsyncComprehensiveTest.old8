// 异步功能全面测试 - 编译器模式
// 包含至少15个测试用例，验证异步功能的完善

// 测试用例1: 基本异步函数
async func basic_async() -> int {
    return 42
}

// 测试用例2: 带参数的异步函数
async func async_add(a: int, b: int) -> int {
    return a + b
}

// 测试用例3: 异步函数中的await
async func async_with_await() -> int {
    task <- Task.Delay(10)
    await task
    return 100
}

// 测试用例4: 异步生成器函数
async func async_generator(n: int) {
    for i in [0~n] {
        task <- Task.Delay(5)
        await task
        yield i
    }
}

// 测试用例5: Task.Delay 测试
func test_task_delay() {
    PrintLine("开始延迟测试...")
    task <- Task.Delay(50)
    await task
    PrintLine("延迟完成")
}

// 测试用例6: Task.FromResult 测试
func test_task_from_result() {
    task <- Task.FromResult("Hello from Task")
    result <- await task
    PrintLine("FromResult结果: " + result)
}

// 测试用例7: Task.Run 测试
func test_task_run() {
    // 注意：Old8Lang的Task.Run实现是简化的，不支持传递函数参数
    // 这里测试Task.Run的基本功能
    task <- Task.Run()
    result <- await task
    PrintLine("Task.Run结果: " + result.ToStr())
}

// 测试用例8: Task.WhenAll 测试
func test_task_when_all() {
    tasks:list<Task<string>> <- {}
    
    async func task1() -> string {
        task <- Task.Delay(20)
        await task
        return "任务1完成"
    }
    
    async func task2() -> string {
        task <- Task.Delay(30)
        await task
        return "任务2完成"
    }
    
    async func task3() -> string {
        task <- Task.Delay(10)
        await task
        return "任务3完成"
    }
    
    tasks.Add(task1())
    tasks.Add(task2())
    tasks.Add(task3())
    
    all_task <- Task.WhenAll(tasks)
    results <- await all_task
    
    PrintLine("WhenAll结果:")
    // 使用foreach循环遍历结果
    index <- 1
    for result in results {
        PrintLine("  任务" + index.ToStr() + ": " + result)
        index <- index + 1
    }
}

// 测试用例9: Task.WhenAny 测试
func test_task_when_any() {
    tasks:list<Task<string>> <- {}
    
    async func fast_task() -> string {
        return "快速任务完成"
    }
    
    async func slow_task() -> string {
        task <- Task.Delay(100)
        await task
        return "慢速任务完成"
    }
    
    tasks.Add(fast_task())
    tasks.Add(slow_task())
    
    any_task <- Task.WhenAny(tasks)
    completed_task <- await any_task
    result <- await completed_task
    
    PrintLine("WhenAny结果: " + result)
}

// 测试用例10: 异步for循环
func test_async_for_loop() {
    async func number_generator(count: int) {
        for i in [0~count] {
            task <- Task.Delay(1)
            await task
            yield i
        }
    }
    
    PrintLine("开始异步for循环:")
    async for num in number_generator(5) {
        PrintLine("  生成数字: " + num.ToStr())
    }
}

// 测试用例11: 异步异常处理
func test_async_exception() {
    async func throwing_task() -> string {
        throw "异步函数中抛出异常"
    }
    
    try {
        task <- throwing_task()
        result <- await task
        PrintLine("不应该执行到这里")
    } catch (e) {
        PrintLine("捕获到异步异常: " + e)
    }
}

// 测试用例12: Task.FromException 测试
func test_task_from_exception() {
    task <- Task.FromException("测试异常")
    
    try {
        result <- await task
        PrintLine("不应该执行到这里")
    } catch (e) {
        PrintLine("FromException测试成功，捕获异常: " + e)
    }
}

// 测试用例13: 取消令牌测试
func test_cancellation_token() {
    cts:CancellationTokenSource <- CancellationTokenSource()
    
    async func cancellable_task(token: CancellationToken) -> string {
        for i in [0~10] {
            if token.IsCancellationRequested {
                return "任务被取消"
            }
            task <- Task.Delay(10)
            await task
        }
        return "任务完成"
    }
    
    task <- cancellable_task(cts.Token)
    
    // 立即取消
    cts.Cancel()
    
    try {
        result <- await task
        PrintLine("取消测试结果: " + result)
    } catch (e) {
        PrintLine("取消时捕获异常: " + e)
    }
}

// 测试用例14: 异步链式调用
func test_async_chaining() {
    async func step1() -> int {
        task <- Task.Delay(10)
        await task
        return 10
    }
    
    async func step2(value: int) -> int {
        task <- Task.Delay(10)
        await task
        return value * 2
    }
    
    async func step3(value: int) -> string {
        task <- Task.Delay(10)
        await task
        return "最终结果: " + value.ToStr()
    }
    
    result1 <- await step1()
    result2 <- await step2(result1)
    final_result <- await step3(result2)
    
    PrintLine("异步链式调用结果: " + final_result)
}

// 测试用例15: 并行异步任务
func test_parallel_async() {
    async func parallel_task(id: int, delay: int) -> string {
        task <- Task.Delay(delay)
        await task
        return "任务" + id.ToStr() + "完成，延迟" + delay.ToStr() + "ms"
    }
    
    // 同时启动多个任务
    task1 <- parallel_task(1, 30)
    task2 <- parallel_task(2, 20)
    task3 <- parallel_task(3, 10)
    
    // 等待所有任务完成
    result1 <- await task1
    result2 <- await task2
    result3 <- await task3
    
    PrintLine("并行任务结果:")
    PrintLine("  " + result1)
    PrintLine("  " + result2)
    PrintLine("  " + result3)
}

// 测试用例16: 异步生成器组合
func test_async_generator_composition() {
    async func even_numbers(max: int) {
        for i in [0~max] {
            if i % 2 == 0 {
                task <- Task.Delay(2)
                await task
                yield i
            }
        }
    }
    
    async func square_numbers() {
        async for num in even_numbers(10) {
            yield num * num
        }
    }
    
    PrintLine("异步生成器组合测试:")
    async for squared in square_numbers() {
        PrintLine("  平方数: " + squared.ToStr())
    }
}

// 主函数 - 运行所有测试
func main() {
    PrintLine("=== 开始异步功能全面测试 ===")
    
    // 测试1: 基本异步函数
    PrintLine("\n1. 测试基本异步函数:")
    result <- await basic_async()
    PrintLine("   结果: " + result.ToStr())
    
    // 测试2: 带参数的异步函数
    PrintLine("\n2. 测试带参数的异步函数:")
    result <- await async_add(5, 7)
    PrintLine("   5 + 7 = " + result.ToStr())
    
    // 测试3: 异步函数中的await
    PrintLine("\n3. 测试异步函数中的await:")
    result <- await async_with_await()
    PrintLine("   结果: " + result.ToStr())
    
    // 测试4: 异步生成器
    PrintLine("\n4. 测试异步生成器:")
    count <- 0
    async for num in async_generator(3) {
        PrintLine("   生成值: " + num.ToStr())
        count <- count + 1
    }
    PrintLine("   总共生成: " + count.ToStr() + " 个值")
    
    // 测试5: Task.Delay
    PrintLine("\n5. 测试Task.Delay:")
    test_task_delay()
    
    // 测试6: Task.FromResult
    PrintLine("\n6. 测试Task.FromResult:")
    test_task_from_result()
    
    // 测试7: Task.Run
    PrintLine("\n7. 测试Task.Run:")
    test_task_run()
    
    // 测试8: Task.WhenAll
    PrintLine("\n8. 测试Task.WhenAll:")
    test_task_when_all()
    
    // 测试9: Task.WhenAny
    PrintLine("\n9. 测试Task.WhenAny:")
    test_task_when_any()
    
    // 测试10: 异步for循环
    PrintLine("\n10. 测试异步for循环:")
    test_async_for_loop()
    
    // 测试11: 异步异常处理
    PrintLine("\n11. 测试异步异常处理:")
    test_async_exception()
    
    // 测试12: Task.FromException
    PrintLine("\n12. 测试Task.FromException:")
    test_task_from_exception()
    
    // 测试13: 取消令牌
    PrintLine("\n13. 测试取消令牌:")
    test_cancellation_token()
    
    // 测试14: 异步链式调用
    PrintLine("\n14. 测试异步链式调用:")
    test_async_chaining()
    
    // 测试15: 并行异步任务
    PrintLine("\n15. 测试并行异步任务:")
    test_parallel_async()
    
    // 测试16: 异步生成器组合
    PrintLine("\n16. 测试异步生成器组合:")
    test_async_generator_composition()
    
    PrintLine("\n=== 异步功能全面测试完成 ===")
}