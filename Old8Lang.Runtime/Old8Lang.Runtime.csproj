<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.18.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="dnlib" Version="4.5.0" />
    <PackageReference Include="pythonnet" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 解释后端迁出后仍复用 Runtime 内部的执行辅助，先以 friend assembly 固定边界；
         公开 API 收敛后再移除。 -->
    <InternalsVisibleTo Include="Old8Lang.Interpreter" />
    <InternalsVisibleTo Include="Old8Lang.Compiler" />
    <InternalsVisibleTo Include="Old8Lang.VirtualMachine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Old8Lang.Core\Old8Lang.Core.csproj" />
    <ProjectReference Include="..\Old8Lang.Concurrency\Old8Lang.Concurrency.csproj" />
    <ProjectReference Include="..\Old8Lang.Modules.Abstractions\Old8Lang.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\Old8Lang.Observability\Old8Lang.Observability.csproj" />
    <ProjectReference Include="..\Old8Lang.ProjectSystem\Old8Lang.ProjectSystem.csproj" />
    <ProjectReference Include="..\Old8Lang.Syntax\Old8Lang.Syntax.csproj" />
  </ItemGroup>

</Project>
