// 测试递归函数

PrintLine("=== 递归函数测试 ===")

PrintLine("\n--- 阶乘递归测试 ---")
// 定义阶乘函数
func factorial(n:int) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

// 测试阶乘
PrintLine("factorial(5) = " + factorial(5))
PrintLine("factorial(10) = " + factorial(10))
PrintLine("factorial(1) = " + factorial(1))
PrintLine("factorial(0) = " + factorial(0))

PrintLine("\n--- 斐波那契数列递归测试 ---")
// 定义斐波那契函数
func fibonacci(n:int) {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

// 测试斐波那契数列
PrintLine("fibonacci(0) = " + fibonacci(0))
PrintLine("fibonacci(1) = " + fibonacci(1))
PrintLine("fibonacci(5) = " + fibonacci(5))
PrintLine("fibonacci(10) = " + fibonacci(10))
PrintLine("fibonacci(15) = " + fibonacci(15))

PrintLine("\n--- 递归求和测试 ---")
// 定义递归求和函数
func sumRecursive(n:int) {
    if n <= 0 {
        return 0
    }
    return n + sumRecursive(n - 1)
}

// 测试递归求和
PrintLine("sumRecursive(10) = " + sumRecursive(10))
PrintLine("sumRecursive(100) = " + sumRecursive(100))
PrintLine("sumRecursive(1) = " + sumRecursive(1))

PrintLine("\n--- 递归幂运算测试 ---")
// 定义递归幂函数
func powerRecursive(base:int, exp:int) {
    if exp == 0 {
        return 1
    }
    if exp == 1 {
        return base
    }
    return base * powerRecursive(base, exp - 1)
}

// 测试递归幂运算
PrintLine("powerRecursive(2, 5) = " + powerRecursive(2, 5))
PrintLine("powerRecursive(3, 4) = " + powerRecursive(3, 4))
PrintLine("powerRecursive(10, 2) = " + powerRecursive(10, 2))
PrintLine("powerRecursive(5, 0) = " + powerRecursive(5, 0))

PrintLine("\n--- 递归最大公约数测试 ---")
// 定义递归 GCD 函数（欧几里得算法）
func gcd(a:int, b:int) {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

// 测试 GCD
PrintLine("gcd(48, 18) = " + gcd(48, 18))
PrintLine("gcd(100, 50) = " + gcd(100, 50))
PrintLine("gcd(17, 13) = " + gcd(17, 13))
PrintLine("gcd(1000, 500) = " + gcd(1000, 500))

PrintLine("\n--- 递归数组求和测试 ---")
// 定义递归数组求和函数
func arraySum(arr, index:int) {
    if index >= Len(arr) {
        return 0
    }
    return arr[index] + arraySum(arr, index + 1)
}

// 测试递归数组求和
arr1 <- [1, 2, 3, 4, 5]
PrintLine("arraySum([1, 2, 3, 4, 5]) = " + arraySum(arr1, 0))

arr2 <- [10, 20, 30]
PrintLine("arraySum([10, 20, 30]) = " + arraySum(arr2, 0))

PrintLine("\n--- 递归字符串反转测试 ---")
// 定义递归字符串处理函数
func countDown(n:int) {
    if n <= 0 {
        PrintLine("发射!")
        return 0
    }
    PrintLine("倒计时: " + n)
    return countDown(n - 1)
}

// 测试递归倒计时
PrintLine("递归倒计时:")
countDown(5)

PrintLine("\n--- 嵌套递归测试 ---")
// 定义 Ackermann 函数（嵌套递归）
func ackermann(m:int, n:int) {
    if m == 0 {
        return n + 1
    }
    if n == 0 {
        return ackermann(m - 1, 1)
    }
    return ackermann(m - 1, ackermann(m, n - 1))
}

// 测试 Ackermann 函数（使用较小的值）
PrintLine("ackermann(0, 5) = " + ackermann(0, 5))
PrintLine("ackermann(1, 3) = " + ackermann(1, 3))
PrintLine("ackermann(2, 2) = " + ackermann(2, 2))
PrintLine("ackermann(3, 1) = " + ackermann(3, 1))

PrintLine("\n--- 递归树遍历模拟测试 ---")
// 递归打印层级
func printLevel(level:int, prefix) {
    if level <= 0 {
        return 0
    }
    PrintLine(prefix + "Level " + level)
    return printLevel(level - 1, prefix + "  ")
}

PrintLine("递归层级打印:")
printLevel(5, "")

PrintLine("\n✅ 递归函数测试完成")
