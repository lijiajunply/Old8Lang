// 简单字典for-in测试 - 编译模式
// 只测试字典的for-in循环

PrintLine("=== 简单字典for-in测试 ===")

// 只测试字典的for-in循环
dict:dictionary <- {"name": "Alice", "age": 30, "city": "New York"}
PrintLine("字典内容: " + dict)

// 测试字典的for-in循环
PrintLine("\n字典的for-in循环测试:")
for key in dict {
    PrintLine("键: " + key + ", 值: " + dict[key])
}
