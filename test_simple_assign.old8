class Product {
    public name <- ""
    public price <- 0.0
    public category <- ""
    public discount <- 0.0

    func init(name:string, price:double, category:string, discount:double) {
        PrintLine("[4参] 开始, 参数 category = " + category)
        this.category <- category
        PrintLine("[4参] 设置后")
        cat <- this.category
        PrintLine("[4参] cat = " + cat)
    }
}

product2 <- Product("Laptop", 999.99, "Electronics", 0.1)
PrintLine("product2.category = " + product2.category)
