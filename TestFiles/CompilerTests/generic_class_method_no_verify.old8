#verify-il false

// 编译器模式：测试泛型类方法调用（禁用IL验证）

// 定义简单的泛型Box类
class Box<T> {
    private value:T

    func set(v:T) -> void {
        this.value <- v
    }

    func get() -> T {
        return this.value
    }
}

// 测试int类型的Box
intBox <- Box<int>()
intBox.set(42)
PrintLine("Set value successfully!")

result <- intBox.get()
PrintLine("Get value: " + result.ToStr())
