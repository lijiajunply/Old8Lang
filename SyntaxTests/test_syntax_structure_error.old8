}

// 方括号不匹配 - 缺少右方括号
array[0 <- 10
{1 <- 20
dict["key" <- "value"
range[1~10 <- 1

// 方括号不匹配 - 缺少左方括号
array]0] <- 10
list}1] <- 20
dict]"key"] <- "value"
range]1~10] <- 1

// 缺少关键字
if a > 5 {
    PrintLine("缺少左括号")
}

elif a == 5 {
    PrintLine("缺少if关键字")
}

else {
    PrintLine("缺少if关键字")
}

for i <- 0, i < 10, i++
    PrintLine("缺少大括号")

while b < 10
    PrintLine("缺少大括号")

// 无效语句序列
PrintLine("语句1") PrintLine("语句2") // 缺少语句分隔

PrintLine("语句1")

PrintLine("语句2")

PrintLine("语句3") // 多余的空行

// 无效语句终止符
