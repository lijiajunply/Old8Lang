# 测试基本表达式类型

# 整数类型
a <- 10
b <- 20
c <- a + b
print(c)  # 应该输出 30

# 浮点数类型
d <- 3.14
e <- 2.71
f <- d + e
print(f)  # 应该输出 5.85

# 字符串类型
g <- "Hello"
h <- " World"
i <- g + h
print(i)  # 应该输出 "Hello World"

# 布尔类型
j <- true
k <- false
l <- j and k
print(l)  # 应该输出 false

# 字符类型
m <- 'a'
n <- 'b'
op <- m + n
print(op)  # 应该输出 "ab"
