// 调试 MathLib 返回值
import Math

printLine("=== 调试 MathLib 返回值 ===\n")

// 测试 Abs (返回 double)
result1 <- Abs(42.0)
printLine("Abs(42.0) 返回类型: " + type(result1).ToStr())
printLine("Abs(42.0) 值: " + result1.ToStr())
printLine("")

// 测试 Max (返回 double)
result2 <- Max(10.0, 20.0)
printLine("Max(10.0, 20.0) 返回类型: " + type(result2).ToStr())
printLine("Max(10.0, 20.0) 值: " + result2.ToStr())
printLine("")

// 测试 Factorial (返回 long)
result3 <- Factorial(5)
printLine("Factorial(5) 返回类型: " + type(result3).ToStr())
printLine("Factorial(5) 值: " + result3.ToStr())
printLine("")

// 测试 Pow (返回 double)
result4 <- Pow(2.0, 3.0)
printLine("Pow(2.0, 3.0) 返回类型: " + type(result4).ToStr())
printLine("Pow(2.0, 3.0) 值: " + result4.ToStr())
