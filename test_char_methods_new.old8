// Char 方法测试

Print("=== Char 方法测试 ===")

// 测试字符
c1 <- 'A'
c2 <- 'a'
c3 <- '5'
c4 <- ' '
c5 <- '!'
c6 <- '+'

// 测试 IsUpper
Print("\n测试 IsUpper:")
Print("'A'.IsUpper() = " + c1.IsUpper().ToStr())
Print("'a'.IsUpper() = " + c2.IsUpper().ToStr())

// 测试 IsLower
Print("\n测试 IsLower:")
Print("'A'.IsLower() = " + c1.IsLower().ToStr())
Print("'a'.IsLower() = " + c2.IsLower().ToStr())

// 测试 IsDigit
Print("\n测试 IsDigit:")
Print("'5'.IsDigit() = " + c3.IsDigit().ToStr())
Print("'A'.IsDigit() = " + c1.IsDigit().ToStr())

// 测试 IsLetter
Print("\n测试 IsLetter:")
Print("'A'.IsLetter() = " + c1.IsLetter().ToStr())
Print("'5'.IsLetter() = " + c3.IsLetter().ToStr())

// 测试 IsLetterOrDigit
Print("\n测试 IsLetterOrDigit:")
Print("'A'.IsLetterOrDigit() = " + c1.IsLetterOrDigit().ToStr())
Print("'5'.IsLetterOrDigit() = " + c3.IsLetterOrDigit().ToStr())
Print("'!'.IsLetterOrDigit() = " + c5.IsLetterOrDigit().ToStr())

// 测试 IsWhiteSpace
Print("\n测试 IsWhiteSpace:")
Print("' '.IsWhiteSpace() = " + c4.IsWhiteSpace().ToStr())
Print("'A'.IsWhiteSpace() = " + c1.IsWhiteSpace().ToStr())

// 测试 IsPunctuation
Print("\n测试 IsPunctuation:")
Print("'!'.IsPunctuation() = " + c5.IsPunctuation().ToStr())
Print("'A'.IsPunctuation() = " + c1.IsPunctuation().ToStr())

// 测试 IsSymbol
Print("\n测试 IsSymbol:")
Print("'+'.IsSymbol() = " + c6.IsSymbol().ToStr())
Print("'A'.IsSymbol() = " + c1.IsSymbol().ToStr())

// 测试 IsControl
Print("\n测试 IsControl:")
tab <- '\t'
Print("'\\t'.IsControl() = " + tab.IsControl().ToStr())
Print("'A'.IsControl() = " + c1.IsControl().ToStr())

// 测试 ToInt
Print("\n测试 ToInt:")
Print("'A'.ToInt() = " + c1.ToInt().ToStr())
Print("'a'.ToInt() = " + c2.ToInt().ToStr())
Print("'5'.ToInt() = " + c3.ToInt().ToStr())

// 测试 GetNumericValue
Print("\n测试 GetNumericValue:")
Print("'5'.GetNumericValue() = " + c3.GetNumericValue().ToStr())
Print("'A'.GetNumericValue() = " + c1.GetNumericValue().ToStr())

// 测试 CompareTo
Print("\n测试 CompareTo:")
Print("'A'.CompareTo('B') = " + c1.CompareTo('B').ToStr())
Print("'A'.CompareTo('A') = " + c1.CompareTo('A').ToStr())
Print("'B'.CompareTo('A') = " + 'B'.CompareTo('A').ToStr())

// 测试 ToUpper 和 ToLower
Print("\n测试 ToUpper 和 ToLower:")
Print("'a'.ToUpper() = " + c2.ToUpper().ToStr())
Print("'A'.ToLower() = " + c1.ToLower().ToStr())

Print("\n=== 所有 Char 方法测试完成！ ===")
