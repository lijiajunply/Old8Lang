// 简单测试 break 和 continue 语句

PrintLine("=== break 和 continue 语句测试 ===")

// 测试 break 在 for 循环中的功能
PrintLine("\n=== for 循环中的 break 测试 ===")
for i <- 0, i < 10, i++ {
    PrintLine("i = " + i)
    if i == 5 {
        PrintLine("触发 break")
        break
    }
}

// 测试 continue 在 for 循环中的功能
PrintLine("\n=== for 循环中的 continue 测试 ===")
for i <- 0, i < 5, i++ {
    if i == 2 {
        PrintLine("触发 continue")
        continue
    }
    PrintLine("i = " + i)
}

// 测试 break 在 while 循环中的功能
PrintLine("\n=== while 循环中的 break 测试 ===")
j <- 0
while j < 10 {
    PrintLine("j = " + j)
    if j == 3 {
        PrintLine("触发 break")
        break
    }
    j++
}

// 测试 continue 在 while 循环中的功能
PrintLine("\n=== while 循环中的 continue 测试 ===")
k <- 0
while k < 5 {
    k++
    if k == 3 {
        PrintLine("触发 continue")
        continue
    }
    PrintLine("k = " + k)
}

PrintLine("\n=== 测试完成 ===")