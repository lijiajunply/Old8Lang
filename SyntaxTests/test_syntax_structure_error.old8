while (b < 10) {
    PrintLine("缺少右大括号")

for (i <- 0, i < 10, i++) {
    PrintLine("缺少右大括号")

func test_func(a, b) {
    return a + b

class TestClass {
    var a <- 10

// 大括号不匹配 - 缺少左大括号
if (a > 5)
