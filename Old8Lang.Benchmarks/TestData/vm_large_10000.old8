// VM fixed large benchmark script (about 10k lines)

func transform(x:int, offset:int) -> int {
    return (x * 3 + offset) % 100000
}

func fold(arr) -> int {
    s <- 0
    for v in arr {
        s <- s + v
    }
    return s
}

