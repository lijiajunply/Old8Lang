// 虚拟机测试 - 函数调用

func add(a:int, b:int) -> int {
    return a + b
}

func multiply(x:int, y:int) -> int {
    return x * y
}

func factorial(n:int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

// 测试简单函数调用
result1 <- add(5, 3)
PrintLine("add(5, 3) = " + result1.ToStr())

result2 <- multiply(4, 7)
PrintLine("multiply(4, 7) = " + result2.ToStr())

// 测试递归函数
result3 <- factorial(5)
PrintLine("factorial(5) = " + result3.ToStr())

// 测试嵌套函数调用
result4 <- add(multiply(2, 3), multiply(4, 5))
PrintLine("add(multiply(2, 3), multiply(4, 5)) = " + result4.ToStr())

PrintLine("\n函数调用测试完成!")
