// 测试第一种函数声明方式：func add(a:int, b:int) { return a + b }
func add(a:int, b:int) {
    return a + b
}

// 测试第二种函数声明方式：sub(a:int, b:int) -> { return a - b }
sub(a:int, b:int) -> {
    return a - b
}

// 测试调用这两个函数
result1 <- add(10, 5)
result2 <- sub(10, 5)

PrintLine("10 + 5 = " + result1)
PrintLine("10 - 5 = " + result2)
