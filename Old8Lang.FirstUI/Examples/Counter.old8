// Old8Lang FirstUI - 计数器应用示例
// 展示状态管理和事件处理

import "FirstUI" as ui

// 创建应用程序
app <- ui.CreateApp()

// 计数器状态
counter <- 0

// 计数器视图
CounterView() -> {
            return ui.Layout.Column([
                ui.Basic.Text("计数器应用")
                    .SetFontSize(28.0)
                    .SetFontWeight("bold")
                    .SetColor("#000000"),
                ui.Basic.Text(counter.ToStr())
                    .SetFontSize(72.0)
                    .SetFontWeight("bold")
                    .SetColor("#007AFF")
                    .SetMargin(20.0, 0.0, 30.0, 0.0),
                ui.Layout.Row(
                    children:
                    {
                        // 减少按钮
                        ui.Basic.Button(
                            label: "➖ 减少",
                            onClick: () -> { counter <- counter - 1; }
                        ),
    
                        // 重置按钮
                        ui.Basic.Button(
                            label: "🔄 重置",
                            onClick: () ->
                            {
                                counter <- 0;
                                ui.ShowToast("已重置计数器")
                            }
                        ).SetMargin(20.0, 0.0, 0.0, 0.0),
    
                        // 增加按钮
                        ui.Basic.Button(
                            label: "➕ 增加",
                            onClick: () -> { counter <- counter + 1; }
                        ).SetMargin(20.0, 0.0, 0.0, 0.0)
                    }
                ).SetSpacing(20),
                ui.Basic.Text("点击按钮改变计数值")
                    .SetFontSize(14.0)
                    .SetColor("#8E8E93")
                    .SetMargin(40.0, 0.0, 0.0, 0.0)
            ]).SetPadding(40);
}

// 运行应用
app.Run(CounterView(), "asdf")
