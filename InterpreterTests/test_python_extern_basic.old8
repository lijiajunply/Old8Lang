// 测试 Python 函数导入 - 基本功能测试

// 测试 1: 使用 .py 文件扩展名导入 Python 脚本
native extern "TestFiles/test_math.py" {
    func add(a:int, b:int) -> int,
    func greet(name:string) -> string
}

// 测试基本的 Python 函数调用
result1 <- add(10, 20)
PrintLine("add(10, 20) = " + result1.ToStr())

greeting <- greet("Old8Lang")
PrintLine(greeting)

// 测试 2: 使用 py: 前缀导入
native extern "py:TestFiles/test_math.py" {
    func subtract(a:int, b:int) -> int as sub,
    func multiply(a:int, b:int) -> int as mul
}

result2 <- sub(50, 20)
PrintLine("subtract(50, 20) = " + result2.ToStr())

result3 <- mul(6, 7)
PrintLine("multiply(6, 7) = " + result3.ToStr())
