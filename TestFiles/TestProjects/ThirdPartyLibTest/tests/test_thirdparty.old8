// 第三方库集成测试（ThirdPartyLibTest 夹具）
// 覆盖：Logger（类 API）、HttpClient（依赖 Logger）、SimpleLogger、SimpleMath
//
// 说明：OldLib 包的 index.old8 目前为空，import "OldLib" 不会导出任何符号，
// 因此本文件不再测试 Math/String/Collection 等旧 API（见 Todo.md）。

PrintLine("=== 第三方库集成测试 ===")

// --- 1. Logger 包 ---------------------------------------------------------
// HttpClient 内部会 import "Logger"，因此 Logger 的导出符号（LoggerClass 等）已经可用。
// 两个包都导出顶层 Create，所以 HttpClient 用别名导入，避免符号冲突。
PrintLine("\n--- Logger 包 ---")
import "HttpClient" as Http

logger <- LoggerClass("TestLogger")
logger.Info("这是一条信息日志")
logger.Warn("这是一条警告日志")
logger.Error("这是一条错误日志")

logger.SetLevel("DEBUG")
logger.Debug("这是一条调试日志（SetLevel 后可见）")

// --- 2. HttpClient 包（依赖 Logger）--------------------------------------
PrintLine("\n--- HttpClient 包 ---")
client <- Http.Create("https://api.example.com")
client.SetLogLevel("ERROR") // 后续请求日志只保留 ERROR，避免刷屏

response <- client.Get("/users")
PrintLine("GET /users -> " + response["Status"].ToStr() + " " + response["StatusText"])
PrintLine("响应体: " + response["Body"])

created <- client.Post("/users", {"name": "Alice", "age": 30})
PrintLine("POST /users -> " + created["Status"].ToStr() + " " + created["StatusText"])

// --- 3. SimpleLogger 包（函数 API）--------------------------------------
PrintLine("\n--- SimpleLogger 包 ---")
import "SimpleLogger"

Info("SimpleLogger: info")
Warn("SimpleLogger: warn")
Error("SimpleLogger: error")
Debug("SimpleLogger: debug")

// --- 4. SimpleMath 包（函数 API）----------------------------------------
// 注意：夹具里的 sqrt 是简化实现（返回 x * x），这里只验证调用链与类型匹配。
PrintLine("\n--- SimpleMath 包 ---")
import "SimpleMath"

PrintLine("sqrt(9.0) = " + sqrt(9.0).ToStr())
PrintLine("abs(-5.0) = " + abs(-5.0).ToStr())
PrintLine("max(3.0, 7.0) = " + max(3.0, 7.0).ToStr())
PrintLine("min(3.0, 7.0) = " + min(3.0, 7.0).ToStr())

// --- 5. 重复导入不应报错 ----------------------------------------------
PrintLine("\n--- 重复导入 ---")
import "SimpleLogger"
Info("重复导入后仍可调用")

PrintLine("\n=== 所有测试完成 ===")
