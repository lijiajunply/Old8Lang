// 测试 List 查询、聚合和其他方法

// 测试 FirstWith (FirstWithPredicate)
numbers <- {1, 2, 3, 4, 5, 6}
firstEven <- numbers.FirstWith((x:int) -> x % 2 == 0)
PrintLine("FirstWith (even): " + firstEven.ToStr())

// 测试 FirstOrDefault
emptyList <- {}
firstOrDefault <- emptyList.FirstOrDefault()
PrintLine("FirstOrDefault (empty): " + firstOrDefault.ToStr())

nonEmptyList <- {10, 20, 30}
firstOrDefault2 <- nonEmptyList.FirstOrDefault()
PrintLine("FirstOrDefault (non-empty): " + firstOrDefault2.ToStr())

// 测试 LastWith (LastWithPredicate)
lastEven <- numbers.LastWith((x:int) -> x % 2 == 0)
PrintLine("LastWith (even): " + lastEven.ToStr())

// 测试 LastOrDefault
lastOrDefault <- emptyList.LastOrDefault()
PrintLine("LastOrDefault (empty): " + lastOrDefault.ToStr())

lastOrDefault2 <- nonEmptyList.LastOrDefault()
PrintLine("LastOrDefault (non-empty): " + lastOrDefault2.ToStr())

// 测试 ElementAt
values <- {100, 200, 300, 400, 500}
element <- values.ElementAt(2)
PrintLine("ElementAt(2): " + element.ToStr())

// 测试 Aggregate (无初始值)
nums <- {1, 2, 3, 4, 5}
product <- nums.Aggregate((acc:int, x:int) -> acc * x)
PrintLine("Aggregate (product): " + product.ToStr())

// 测试 AggregateWith (带初始值)
sumWithSeed <- nums.AggregateWith((acc:int, x:int) -> acc + x, 100)
PrintLine("AggregateWith (sum + 100): " + sumWithSeed.ToStr())

// 测试 ForEach
PrintLine("ForEach test:")
_ <- {1, 2, 3}.ForEach((x:int) -> PrintLine("  Item: " + x.ToStr()))

// 测试 Join
words <- {"Hello", "World", "Old8Lang"}
joined <- words.Join(" ")
PrintLine("Join (space): " + joined)

joined2 <- words.Join(", ")
PrintLine("Join (comma): " + joined2)

// 测试 Join 默认分隔符
joined3 <- words.Join()
PrintLine("Join (default): " + joined3)
