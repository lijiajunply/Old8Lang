// 复杂类测试

// 1. 类的关联关系

// 地址类
class Address {
    street:string <- ""
    city:string <- ""
    zip_code:string <- ""
    
    func get_full_address() -> {
        return this.street + ", " + this.city + " " + this.zip_code
    }
}

// 联系人类
class Contact {
    name:string <- ""
    email:string <- ""
    phone:string <- ""
    
    func get_contact_info() -> {
        return "Name: " + this.name + ", Email: " + this.email + ", Phone: " + this.phone
    }
}

// 人员类，包含地址和联系人信息
class Person {
    id:int <- 0
    name:string <- ""
    age:int <- 0
    address:Address <- Address()
    contact:Contact <- Contact()
    
    func get_person_details() -> {
        return "ID: " + this.id + ", Name: " + this.name + ", Age: " + this.age + ", Address: " + this.address.get_full_address() + ", Contact: " + this.contact.get_contact_info()
    }
    
    func update_age(new_age) -> {
        this.age <- new_age
    }
    
    func is_adult() -> {
        return this.age >= 18
    }
}

// 2. 类的组合和聚合

// 部门类
class Department {
    name:string <- ""
    manager:Person <- Person()
    employees:array <- []  // 假设Old8Lang支持泛型或动态类型数组
    
    func add_employee(employee) -> {
        // 假设Old8Lang支持数组append操作
        // this.employees.append(employee)
    }
    
    func get_department_size() -> {
        return this.employees.length  // 假设Old8Lang数组有length属性
    }
    
    func get_manager_name() -> {
        return this.manager.name
    }
}

// 公司类，包含多个部门
class Company {
    name:string <- ""
    departments:array <- []
    
    func add_department(dept) -> {
        // this.departments.append(dept)
    }
    
    func get_total_employees() -> {
        total <- 0
        // for dept in this.departments {
        //     total <- total + dept.get_department_size()
        // }
        return total
    }
    
    func get_company_info() -> {
        return "Company: " + this.name + ", Departments: " + this.departments.length
    }
}

// 3. 复杂的方法调用链

class OrderItem {
    product_id:int <- 0
    product_name:string <- ""
    quantity:int <- 0
    price:double <- 0.0
    
    func get_total_price() -> {
        return this.quantity * this.price
    }
    
    func get_item_info() -> {
        return "Product: " + this.product_name + ", Quantity: " + this.quantity + ", Price: " + this.price + ", Total: " + this.get_total_price()
    }
}

class Order {
    order_id:int <- 0
    customer:Person <- Person()
    items:array <- []
    order_date:string <- ""
    status:string <- "Pending"
    
    func add_item(item) -> {
        // this.items.append(item)
    }
    
    func get_order_total() -> {
        total:double <- 0.0
        // for item in this.items {
        //     total <- total + item.get_total_price()
        // }
        return total
    }
    
    func update_status(new_status) -> {
        this.status <- new_status
    }
    
    func get_order_summary() -> {
        return "Order ID: " + this.order_id + ", Customer: " + this.customer.name + ", Date: " + this.order_date + ", Status: " + this.status + ", Total: " + this.get_order_total()
    }
    
    func process_order() -> {
        this.update_status("Processing")
        // 执行订单处理逻辑
        // ...
        this.update_status("Shipped")
    }
}

