// 测试生成器修复
PrintLine("=== Test 1: Simple generator with print before yield ===")
func gen1() {
    for i in [1~3] {
        PrintLine("before: " + i.ToStr())
        yield i
    }
}

for x in gen1() {
    PrintLine("got: " + x.ToStr())
}

PrintLine()
PrintLine("=== Test 2: Generator with multiple statements ===")
func gen2() {
    for i in [1~5] {
        a <- i * 2
        PrintLine("computed: " + a.ToStr())
        yield a
    }
}

for x in gen2() {
    PrintLine("received: " + x.ToStr())
}

PrintLine()
PrintLine("=== Test 3: Generator with conditional ===")
func gen3() {
    for i in [1~10] {
        if i % 2 == 0 {
            PrintLine("even: " + i.ToStr())
            yield i
        }
    }
}

for x in gen3() {
    PrintLine("got even: " + x.ToStr())
}

PrintLine()
PrintLine("=== All tests passed! ===")
