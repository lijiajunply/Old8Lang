// Old8Lang 测试框架简单示例
// 测试断言库的基础功能

// 导入测试框架
native "Old8LangLib" AssertLib *

PrintLine("=== Old8Lang 测试框架示例 ===")

// ===== 测试 1: 基础断言 =====
PrintLine("\n测试 1: 基础相等断言")
AssertEqual(5, 5)
AssertEqual("hello", "hello")
AssertNotEqual(5, 10)
PrintLine("✓ 基础断言测试通过")

// ===== 测试 2: 布尔断言 =====
PrintLine("\n测试 2: 布尔断言")
AssertTrue(true)
AssertFalse(false)
PrintLine("✓ 布尔断言测试通过")

// ===== 测试 3: 数值比较 =====
PrintLine("\n测试 3: 数值比较")
AssertGreater(10, 5)
AssertLess(5, 10)
PrintLine("✓ 数值比较测试通过")

// ===== 测试 4: 字符串断言 =====
PrintLine("\n测试 4: 字符串断言")
text <- "Hello, World!"
AssertContains(text, "World")
AssertStartsWith(text, "Hello")
AssertEndsWith(text, "!")
PrintLine("✓ 字符串断言测试通过")

PrintLine("\n=== 所有测试完成! ===")
