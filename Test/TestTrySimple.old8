try {
    a <- 10
    b <- 0
    c <- a / b
    result <- 0
} catch {
    result <- 1
} finally {
    finally_executed <- 1
}

# 测试多个catch块
try {
    undefined_var
    result2 <- 0
} catch (NameError) {
    result2 <- 1
} catch {
    result2 <- 2
}

# 测试没有异常的情况
try {
    d <- 5
    e <- 2
    f <- d / e
    result3 <- f
} catch {
    result3 <- -1
} finally {
    finally_executed2 <- 1
}
