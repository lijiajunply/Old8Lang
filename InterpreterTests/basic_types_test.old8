// 基本数据类型测试

// 整数类型
PrintLine("=== 整数类型测试 ===")
a:int <- 123
PrintLine(a)
b:int <- -456
PrintLine(b)
c:int <- 0
PrintLine(c)

// 浮点数类型
PrintLine("\n=== 浮点数类型测试 ===")
d:double <- 3.14
PrintLine(d)
e:double <- -0.5
PrintLine(e)
f:double <- 1.0
PrintLine(f)

// 字符串类型
PrintLine("\n=== 字符串类型测试 ===")
g:string <- "hello world"
PrintLine(g)
h:string <- ""
PrintLine(h)

// 布尔类型
PrintLine("\n=== 布尔类型测试 ===")
i:bool <- true
PrintLine(i)
j:bool <- false
PrintLine(j)

// 字符类型
PrintLine("\n=== 字符类型测试 ===")
k:char <- 'a'
PrintLine(k)
l:char <- '1'
PrintLine(l)
m:char <- '\n'
PrintLine(m)
PrintLine("After newline")

// 数组类型
PrintLine("\n=== 数组类型测试 ===")
n:array <- [1, 2, 3, 4, 5]
PrintLine(n[0])
PrintLine(n[1])
PrintLine(n[2])

