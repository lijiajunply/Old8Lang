// 测试简单的this关键字使用
class Person {
    name <- ""
    age <- 0
    
    func init(name, age) {
        this.name <- name
        this.age <- age
    }
    
    func getName() {
        return this.name
    }
    
    func getAge() {
        return this.age
    }
    
    func updateAge(newAge) {
        this.age <- newAge
    }
}

// 创建对象并测试
alice <- Person("Alice", 30)
PrintLine(alice.getName())
PrintLine(alice.getAge())

// 更新年龄并再次测试
alice.updateAge(31)
PrintLine(alice.getName())
PrintLine(alice.getAge())