<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      性能/并发档：跑 Category=Performance 与 Category=PerformanceSmoke 的用例。
      用法见 Docs/TESTING_GUIDE.md 的“性能/并发用例分档”一节。

      注意：这些用例断言墙钟耗时、GC 占用或用 Sleep 同步线程，在同一进程内
      仍会互相干扰，彻底稳定需要隔离到独立进程运行。
    -->
    <TestCaseFilter>(Category=Performance)|(Category=PerformanceSmoke)</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
