// 生成器语法测试

// 定义一个生成器函数，用于生成1到n的整数
func range(n) {
    for i <- 1, i <= n, i <- i + 1 {
        yield i
    }
}

// 测试生成器函数
PrintLine("生成器测试：1到5的整数")
for num in range(5) {
    PrintLine(num)
}

// 定义一个生成器函数，用于生成斐波那契数列
func fibonacci(n) {
    a <- 0
    b <- 1
    for i <- 0, i < n, i <- i + 1 {
        yield a
        temp <- a
        a <- b
        b <- temp + b
    }
}

// 测试斐波那契生成器
PrintLine("\n斐波那契数列前8项：")
for num in fibonacci(8) {
    PrintLine(num)
}

// 定义一个生成器函数，用于生成字符串的每个字符
func chars(s) {
    for i <- 0, i < Len(s), i <- i + 1 {
        yield s[i]
    }
}

// 测试字符串字符生成器
PrintLine("\n字符串 'hello' 的每个字符：")
for c in chars("hello") {
    PrintLine(c)
}

// 测试生成器的重置和多次使用
PrintLine("\n生成器多次使用测试：")
gen <- range(3)
for num in gen {
    PrintLine("第一次遍历：" + num)
}

// 重新创建生成器并再次使用
gen2 <- range(3)
for num in gen2 {
    PrintLine("第二次遍历：" + num)
}
