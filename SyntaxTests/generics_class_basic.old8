// 基本泛型类语法测试

// 单个类型参数的泛型类
class Box<T> {
    private value:T

    func set(v:T) -> void {
        this.value <- v
    }

    func get() -> T {
        return this.value
    }
}

// 多个类型参数的泛型类
class Pair<K, V> {
    private key:K
    private value:V

    func getKey() -> K {
        return this.key
    }

    func getValue() -> V {
        return this.value
    }
}

// 泛型接口
interface IComparable<T> {
    func compareTo(other:T) -> int
}
