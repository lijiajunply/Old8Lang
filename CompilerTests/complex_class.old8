// 5. 复杂类的实例化和使用

// 创建并初始化复杂对象
// 1. 创建地址
addr1:Address <- Address()
addr1.street <- "123 Main St"
addr1.city <- "New York"
addr1.zip_code <- "10001"

// 2. 创建联系人
contact1:Contact <- Contact()
contact1.name <- "John Doe"
contact1.email <- "john@example.com"
contact1.phone <- "555-1234"

// 3. 创建人员
person1:Person <- Person()
person1.id <- 1
person1.name <- "John Doe"
person1.age <- 30
person1.address <- addr1
person1.contact <- contact1

// 4. 创建部门
eng_dept:Department <- Department()
eng_dept.name <- "Engineering"
eng_dept.manager <- person1

// 5. 创建公司
company:Company <- Company()
company.name <- "Tech Corp"
company.add_department(eng_dept)

// 6. 创建订单项目
order_item1:OrderItem <- OrderItem()
order_item1.product_id <- 101
order_item1.product_name <- "Laptop"
order_item1.quantity <- 1
order_item1.price <- 999.99

order_item2:OrderItem <- OrderItem()
order_item2.product_id <- 102
order_item2.product_name <- "Mouse"
order_item2.quantity <- 2
order_item2.price <- 29.99

// 7. 创建订单
order1:Order <- Order()
order1.order_id <- 1001
order1.customer <- person1
order1.order_date <- "2023-10-01"
order1.add_item(order_item1)
order1.add_item(order_item2)

// 8. 处理订单
order1.process_order()

// 9. 创建库存
inventory:Inventory <- Inventory()
inventory.add_product(order_item1)
inventory.add_product(order_item2)

// 6. 测试方法调用链

// 获取订单摘要
order_summary:string <- order1.get_order_summary()

// 获取订单总金额
order_total:double <- order1.get_order_total()

// 检查人员是否成年
is_adult:bool <- person1.is_adult()

// 获取部门经理姓名
dept_manager:string <- eng_dept.get_manager_name()

// 获取公司信息
company_info:string <- company.get_company_info()

// 7. 类的嵌套方法调用

// 从订单中获取客户的地址信息
customer_address:string <- order1.customer.address.get_full_address()

// 8. 复杂条件判断

class ReportGenerator {
    func generate_report(company) -> {
        report <- "Company Report: " + company.name + "\n"
        report <- report + "Total Employees: " + company.get_total_employees() + "\n"
        
        // 假设Old8Lang支持字符串拼接和循环
        // for dept in company.departments {
        //     report <- report + "Department: " + dept.name + ", Size: " + dept.get_department_size() + "\n"
        // }
        
        return report
    }
    
    func generate_detailed_report(company, include_employees) -> {
        report <- this.generate_report(company)
        
        if include_employees {
            report <- report + "\nEmployee Details:\n"
            // 假设Old8Lang支持嵌套循环
            // for dept in company.departments {
            //     for employee in dept.employees {
            //         report <- report + employee.get_person_details() + "\n"
            //     }
            // }
        }
        
        return report
    }
}

// 测试报告生成器
report_gen:ReportGenerator <- ReportGenerator()
simple_report:string <- report_gen.generate_report(company)
detailed_report:string <- report_gen.generate_detailed_report(company, true)

