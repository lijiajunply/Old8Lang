// 测试类型注解的使用限制
// 验证类型注解只能在赋值语句、函数参数和lambda参数中使用

PrintLine("=== 测试类型注解的使用限制 ===")

// 1. 正确的使用场景 - 应该通过
PrintLine("\n=== 1. 正确的使用场景 ===")

// 1.1 赋值语句中的类型注解
PrintLine("\n1.1 赋值语句中的类型注解：")
a:int <- 123
PrintLine("a:int <- 123 -> a = " + a)

// 1.2 函数参数中的类型注解
PrintLine("\n1.2 函数参数中的类型注解：")
func add(x:int, y:int) {
    return x + y
}
result <- add(456, 789)
PrintLine("add(456, 789) -> " + result)

// 1.3 Lambda参数中的类型注解
PrintLine("\n1.3 Lambda参数中的类型注解：")
lambdaFunc <- (x:int, y:double) -> x + y
result <- lambdaFunc(10, 20.5)
PrintLine("lambdaFunc(10, 20.5) -> " + result)

// 2. 错误的使用场景 - 应该失败
PrintLine("\n=== 2. 错误的使用场景 ===")

// 2.1 变量引用中的类型注解 - 应该失败
PrintLine("\n2.1 变量引用中的类型注解：")
// 以下代码应该失败：类型注解只能在声明时使用
// PrintLine(a:int)
PrintLine("✓ 已跳过变量引用中的类型注解测试")

// 2.2 函数调用中的类型注解 - 应该失败
PrintLine("\n2.2 函数调用中的类型注解：")
// 以下代码应该失败：类型注解只能在参数声明时使用
// add(1:int, 2:int)
PrintLine("✓ 已跳函数调用中的类型注解测试")

PrintLine("\n=== 测试完成 ===")
