// 测试6：任务状态查询测试
async func quickTask() {
    Sleep(50)
    return 42
}

PrintLine("\n=== 测试6：任务状态查询测试 ===")
task6 <- quickTask()

// 非阻塞查询状态
PrintLine("初始IsCompleted: " + task6.IsCompleted)

// 等待任务完成
result6 <- await task6

// 再次查询状态
PrintLine("完成后IsCompleted: " + task6.IsCompleted)
PrintLine("结果: " + result6)
Assert(result6, 42)

PrintLine("\n=== 所有异步任务状态管理测试完成！ ===")
