// 纯Old8Lang异步测试（不使用native函数）

// 最简单的异步函数，只有return
async func simpleReturn() {
    return 42
}

PrintLine("测试开始")
task <- simpleReturn()
PrintLine("任务已创建")

result <- await task
PrintLine("等待完成")

// 检查结果
if result == 42 {
    PrintLine("测试通过！")
} else {
    PrintLine("测试失败：result = " + result.ToStr())
}
