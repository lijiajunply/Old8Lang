# 测试所有类型注解

# 基本类型
a:int <- 123
b:double <- 3.14
c:string <- "hello"
d:bool <- true
e:char <- 'a'

# 容器类型
f:array <- [1, 2, 3]
g:list <- [4, 5, 6]
h:tuple <- (1, "two")
i:dictionary <- { "key": "value", "number": 123 }

# 其他类型
j:function <- func (x) -> { return x + 1 }
k:type <- int

# 测试非法赋值，应该失败
# l:int <- "string"  # 类型不匹配
# m:array <- 123  # 类型不匹配
# n:bool <- "true"  # 类型不匹配
