// if r3[0] != 1 { throw "r3[0] should be 1" }
// if r3[3] != 4 { throw "r3[3] should be 4" }
// PrintLine("Range [1~<5] passed")

// 3. Reverse Range
r4 <- [5~1]
if r4.Length != 5 {
    throw "r4 length should be 5, got " + r4.Length.ToStr()
}
if r4[0] != 5 { throw "r4[0] should be 5" }
if r4[4] != 1 { throw "r4[4] should be 1" }
PrintLine("Range [5~1] passed")

// 4. Reverse Exclude
// r5 <- [5>~<1] // Exclude start(5), Exclude end(1) -> 4, 3, 2
// if r5.Length != 3 {
//     throw "r5 length should be 3, got " + r5.Length.ToStr()
