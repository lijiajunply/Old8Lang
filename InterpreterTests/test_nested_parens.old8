// 测试嵌套括号表达式

PrintLine("=== 嵌套括号表达式测试 ===")

// 基本嵌套括号
result1 <- (1 + 2) * (3 + 4)
PrintLine("(1 + 2) * (3 + 4) = " + result1)

// 多层嵌套括号
result2 <- ((1 + 2) * 3 + 4) * 5
PrintLine("((1 + 2) * 3 + 4) * 5 = " + result2)

// 复杂表达式
result3 <- (1 + 2 * (3 + 4)) / (5 - 3)
PrintLine("(1 + 2 * (3 + 4)) / (5 - 3) = " + result3)

// 单元素元组测试
PrintLine("\n=== 单元素元组测试 ===")

// 单元素元组，带逗号
result4 <- (123,)
PrintLine("(123,) 是元组吗？" + result4)

// 双元素元组
result5 <- (1, 2)
PrintLine("(1, 2) 是元组吗？" + result5)

// 复杂嵌套表达式和元组的混合
PrintLine("\n=== 复杂混合测试 ===")

// 表达式中的元组
// result6 <- (1 + 2, 3 + 4) * 2  // 这行可能会报错，因为元组不支持乘法
// PrintLine("(1 + 2, 3 + 4) * 2 = " + result6)

// 括号表达式中的元组
result7 <- ((1, 2), 3)
PrintLine("((1, 2), 3) = " + result7)

PrintLine("\n✅ 所有测试完成")
