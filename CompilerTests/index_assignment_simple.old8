// 测试索引赋值操作的类型装箱支持（简化版，只使用一个参数的 PrintLine 调用）
PrintLine("=== 索引赋值操作的类型装箱支持测试 (编译模式) ===")

// 测试1：列表索引赋值的类型装箱
PrintLine("\n=== 测试1：列表索引赋值的类型装箱 ===")

// 创建整数列表
intList <- [1, 2, 3]
PrintLine(intList)

// 将字符串转换为整数赋值给列表
intList[0] <- "4" as int
PrintLine(intList)

// 将浮点数转换为整数赋值给列表
intList[1] <- 5.5 as int
PrintLine(intList)

// 测试2：数组索引赋值的类型装箱
PrintLine("\n=== 测试2：数组索引赋值的类型装箱 ===")

// 创建浮点数数组
doubleArray <- [1.1, 2.2, 3.3]
PrintLine(doubleArray)

// 将整数转换为浮点数赋值给数组
doubleArray[1] <- 4
PrintLine(doubleArray)

// 将字符串转换为浮点数赋值给数组
doubleArray[1] <- "5.5"
PrintLine(doubleArray)

PrintLine("\n✅ 所有测试完成！")
